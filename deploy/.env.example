# Copy to .env and fill in strong secrets.
DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-string
SESSION_SECRET=change-me-web-session-secret

# MinIO object storage credentials.
MINIO_ROOT_USER=miruum
MINIO_ROOT_PASSWORD=change-me-minio-strong-password
# Public base URL for stored objects (nginx → /storage → MinIO). Objects served at
# {PUBLIC_STORAGE_URL}/{bucket}/{key}, e.g. https://ota.gokar.id/storage/miruum/...
PUBLIC_STORAGE_URL=https://ota.gokar.id/storage

# Optional: direct download URL to the mobile APK (shown on landing).
APK_URL=

# ── OTA connector secrets (only needed once you have real B2B credentials) ──
# Referenced by each channel's gateway config via *Env fields. Leave blank until
# you switch a channel's connectorType to HTTP in Back Office → Channel Manager.
TIKETCOM_SECRET=
AGODA_AUTH=          # format: {siteId}:{apiKey}
TRAVELOKA_API_KEY=

# ── Payment gateway ── (MOCK works with no credentials; switch to FLIP when ready)
PAYMENT_PROVIDER=MOCK
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_BASE=https://bigflip.id/api
