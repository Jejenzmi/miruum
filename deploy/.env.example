# Copy to .env and fill in strong secrets.
DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-string
SESSION_SECRET=change-me-web-session-secret

# MinIO object storage credentials.
MINIO_ROOT_USER=miruum
MINIO_ROOT_PASSWORD=change-me-minio-strong-password
# Public base URL for stored objects (nginx → /storage → MinIO). Objects served at
# {PUBLIC_STORAGE_URL}/{bucket}/{key}, e.g. https://ota.gokar.id/storage/miruum/...
PUBLIC_STORAGE_URL=https://ota.gokar.id/storage

# Optional: direct download URL to the mobile APK (shown on landing).
APK_URL=
