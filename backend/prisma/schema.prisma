// Miruum OTA — hotel booking data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PARTNER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  phone        String?
  gender       String?
  birthDate    String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  bookings     Booking[]
  favorites    Favorite[]
  notifications Notification[]
  reviews      Review[]
  ownedHotels  Hotel[]  @relation("HotelOwner")
  chats        ChatConversation[]
}

enum ChatSender {
  USER
  BOT
  AGENT
}

enum ChatStatus {
  BOT
  WAITING_AGENT
  AGENT
  CLOSED
}

model ChatConversation {
  id            String     @id @default(cuid())
  userId        String
  status        ChatStatus @default(BOT)
  createdAt     DateTime   @default(now())
  lastMessageAt DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
}

model ChatMessage {
  id             String     @id @default(cuid())
  conversationId String
  sender         ChatSender
  body           String
  createdAt      DateTime   @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  address     String
  lat         Float?
  lng         Float?
  description String
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  priceFrom   Int      @default(0) // rupiah / night
  starRating  Int      @default(3)
  imageUrl    String
  checkInInfo  String  @default("Dari jam 14.00")
  checkOutInfo String  @default("Sebelum 12.00")
  isPromo     Boolean  @default(false)
  promoLabel  String?
  ownerId     String?
  channelId   String?  // supply source: own Channel Manager (DIRECT) or an OTA
  externalId  String?  // hotel id / deeplink at the source OTA
  createdAt   DateTime @default(now())

  owner       User?          @relation("HotelOwner", fields: [ownerId], references: [id])
  channel     SupplyChannel? @relation(fields: [channelId], references: [id])
  photos      HotelPhoto[]
  facilities  HotelFacility[]
  rooms       Room[]
  reviews     Review[]
  favorites   Favorite[]
  bookings    Booking[]
  packages    HotelPackage[]
  offers      HotelOffer[]
  settlements Settlement[]
}

// A payout to a DIRECT hotel (own Channel Manager) for its confirmed bookings,
// net of Miruum's platform commission. Recorded when the payout is disbursed.
model Settlement {
  id            String   @id @default(cuid())
  hotelId       String
  amount        Int      // rupiah paid out to the hotel
  bookingsCount Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// Supply source for hotel inventory. Miruum aggregates two kinds:
//  • DIRECT — connected hotels managed through Miruum's own Channel Manager (Extranet).
//  • OTA    — resold as a sub-agent of another OTA (Tiket.com, Agoda, Traveloka…).
enum ChannelType {
  DIRECT
  OTA
}

model SupplyChannel {
  id            String      @id @default(cuid())
  code          String      @unique // DIRECT, TIKETCOM, AGODA, TRAVELOKA…
  name          String
  type          ChannelType @default(OTA)
  commissionPct Float       @default(0) // sub-agent margin / markup
  logoUrl       String?
  color         String?     // badge color (hex)
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  connectorType String      @default("MOCK") // MOCK | HTTP | DIRECT — how offers are fetched
  config        Json?       // gateway config for HTTP connectors (baseUrl/auth/request/map)
  createdAt     DateTime    @default(now())

  hotels        Hotel[]
  offers        HotelOffer[]
  bookings      Booking[]
  roomMaps      RoomChannelMap[]
}

// A price/availability offer for a hotel from ONE supply source. The same
// canonical hotel can have many offers (Direct + several OTAs) — Miruum picks
// the cheapest available and shows the rest as a price comparison.
model HotelOffer {
  id          String   @id @default(cuid())
  hotelId     String
  channelId   String
  basePrice   Int      // supplier price / night (rupiah)
  markupPct   Float    @default(0) // Miruum margin on top of basePrice
  price       Int      // customer-facing price = basePrice * (1 + markupPct/100)
  available   Boolean  @default(true)
  roomsLeft   Int      @default(0)
  deeplink    String?  // listing URL at the source OTA
  supplierRef String?  // id at the source
  fetchedAt   DateTime @default(now())

  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel     SupplyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, channelId])
}

model HotelPhoto {
  id      String @id @default(cuid())
  hotelId String
  url     String
  sort    Int    @default(0)
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Facility {
  id    String @id @default(cuid())
  name  String @unique
  icon  String // icon key used by the app
  hotels HotelFacility[]
}

model HotelFacility {
  hotelId    String
  facilityId String
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([hotelId, facilityId])
}

model Room {
  id                String  @id @default(cuid())
  hotelId           String
  name              String
  bedInfo           String  @default("1 Double bed dan 2 Ranjang Twin")
  capacity          Int     @default(2)
  price             Int
  originalPrice     Int?
  discountLabel     String?
  refundable        Boolean @default(true)
  breakfast         Boolean @default(false)
  freeWifi          Boolean @default(true)
  freeCancellation  Boolean @default(true)
  stock             Int     @default(5)
  hotel             Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  packages          HotelPackage[]
  availability      RoomAvailability[]
  channelMaps       RoomChannelMap[]
}

// Maps a Miruum room to an OTA's room-type id — the basis for two-way sync and
// outbound rate/availability push to that OTA.
model RoomChannelMap {
  id             String   @id @default(cuid())
  roomId         String
  channelId      String
  externalRoomId String   // room-type id at the OTA
  enabled        Boolean  @default(true)
  lastPushedAt   DateTime?
  pushStatus     String?  // OK | error message
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel        SupplyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([roomId, channelId])
}

// Per-date rate & allotment for a room — the calendar behind availability and
// dynamic pricing. Managed by the hotel (Extranet) for DIRECT inventory.
model RoomAvailability {
  id        String   @id @default(cuid())
  roomId    String
  date      DateTime @db.Date
  price     Int      // rate for this night (rupiah)
  allotment Int      @default(0) // rooms available to sell this night
  closed    Boolean  @default(false)
  minStay   Int      @default(1)     // minimum nights
  cta       Boolean  @default(false) // closed to arrival
  ctd       Boolean  @default(false) // closed to departure
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
}

// Home promo/marketing banner (admin-managed carousel).
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  imageUrl  String
  badge     String?  // e.g. "30%"
  linkUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Global platform settings (key → value), read with defaults by the app/finance.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// A curated bundle: hotel stay + inclusions (breakfast, transfer, spa…) at one bundled price.
// The "Hotel Package" side of Miruum, alongside plain "Hotel" room booking.
model HotelPackage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  city          String
  description   String
  imageUrl      String
  hotelId       String
  roomId        String
  nights        Int      @default(2)
  days          Int      @default(3)
  guests        Int      @default(2)
  inclusions    String[] // e.g. ["Sarapan 2 orang", "Antar-jemput bandara", "Spa 60 menit"]
  originalPrice Int      // sum of à-la-carte value (rupiah, whole bundle)
  price         Int      // bundled price (rupiah, whole bundle)
  discountPct   Int      @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  starRating    Int      @default(4)
  badge         String?  // e.g. "Best Seller", "Staycation"
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())

  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room          Room     @relation(fields: [roomId], references: [id])
  bookings      Booking[]
}

model Review {
  id         String   @id @default(cuid())
  hotelId    String
  userId     String?
  authorName String
  rating     Float
  body       String
  createdAt  DateTime @default(now())
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Favorite {
  userId  String
  hotelId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  userId         String
  hotelId        String
  roomId         String
  packageId      String?       // set when the booking is a Hotel Package bundle
  packageTitle   String?
  channelId      String?       // supply source this booking was routed to
  supplierRef    String?       // reference at the OTA when routed to an external source
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  guests         Int           @default(2)
  rooms          Int           @default(1)
  bookerName     String
  bookerEmail    String
  bookerPhone    String
  forSelf        Boolean       @default(true)
  specialRequest String?
  roomPrice      Int
  taxFee         Int
  discount       Int           @default(0)
  promoCode      String?
  totalPrice     Int
  status         BookingStatus @default(PENDING)
  paymentMethod  String?
  bank           String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  room           Room          @relation(fields: [roomId], references: [id])
  package        HotelPackage? @relation(fields: [packageId], references: [id])
  channel        SupplyChannel? @relation(fields: [channelId], references: [id])
  payments       Payment[]
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

// A payment attempt for a booking. Provider-agnostic (MOCK/FLIP/…) — the actual
// integration lives in the payment gateway (backend/src/payments.ts).
model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  provider     String        @default("MOCK") // MOCK | FLIP | MIDTRANS | XENDIT
  method       String        // VA_BCA, EWALLET_GOPAY, QRIS, …
  methodLabel  String
  amount       Int
  status       PaymentStatus @default(PENDING)
  externalId   String?       // provider payment/bill id
  vaNumber     String?       // virtual account number
  qrString     String?       // QRIS payload
  payUrl       String?       // redirect / deeplink (e-wallet)
  expiresAt    DateTime?
  paidAt       DateTime?
  raw          Json?
  createdAt    DateTime      @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Promo {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  discountPct Int      @default(0)
  imageUrl    String
  validUntil  String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  type      String   @default("info") // info | success | pending | cancel
  hotelName String?
  orderCode String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
