// Miruum OTA — hotel booking data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PARTNER
  CORPORATE
}

enum CorporateType {
  CORPORATE
  GOVERNMENT
}

// A company / government agency with a booking account (corporate.miruum.id).
model Corporate {
  id          String        @id @default(cuid())
  type        CorporateType @default(CORPORATE)
  entityType  String?       // SWASTA | BUMN | BUMD | PEMERINTAH (detailed classification)
  name        String
  email       String?
  phone       String?
  address     String?
  taxId       String?       // NPWP
  picName     String?       // person in charge
  picPosition String?
  website     String?
  regionId    String?       // leaf region (Desa/Kelurahan) — full path derivable
  creditLimit BigInt        @default(0)
  // Negotiated B2B discount off the public (B2C) rate, in percent. 0 = fall
  // back to the global `corporate_discount_pct` setting.
  discountPct Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  users       User[]
  bookings    Booking[]
  invoices    CorporateInvoice[]
}

enum CorporateInvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

// A billing statement (tagihan) Miruum issues to a corporate/government account
// covering its credit bookings. UNPAID → instansi pays → admin marks PAID.
model CorporateInvoice {
  id            String                 @id @default(cuid())
  corporateId   String
  number        String                 @unique
  amount        BigInt
  bookingsCount Int                    @default(0)
  status        CorporateInvoiceStatus @default(UNPAID)
  dueDate       DateTime?
  note          String?
  createdAt     DateTime               @default(now())
  paidAt        DateTime?
  corporate     Corporate              @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  bookings      Booking[]
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegionLevel {
  PROVINCE
  CITY
  DISTRICT
  VILLAGE
}

// Master data of Indonesian administrative regions (4 levels, self-referencing).
// Supports pemekaran: admins can add new regions at any level.
model Region {
  id       String      @id @default(cuid())
  code     String?     // official BPS/Kemendagri code (optional)
  name     String
  level    RegionLevel
  parentId String?
  parent   Region?     @relation("RegionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Region[]    @relation("RegionTree")

  @@index([level, parentId])
}

// A company/agency's application to open a corporate booking account.
model CorporateApplication {
  id          String            @id @default(cuid())
  type        CorporateType     @default(CORPORATE)
  entityType  String?           // SWASTA | BUMN | BUMD | PEMERINTAH
  companyName String
  picName     String
  picPosition String?
  email       String
  phone       String
  address     String?
  taxId       String?
  regionId    String?
  employees   Int               @default(0)
  note        String?
  documents   Json?             // [{ key, label, url }] uploaded legality documents
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  phone        String?
  gender       String?
  birthDate    String?
  avatarUrl    String?
  title        String?  // salutation: Tuan | Nyonya | Nona
  nationality  String?  // e.g. Indonesia
  idType       String?  // KTP | PASSPORT | SIM
  idNumber     String?
  address      String?
  city         String?
  createdAt    DateTime @default(now())

  bookings     Booking[]
  favorites    Favorite[]
  notifications Notification[]
  reviews      Review[]
  ownedHotels  Hotel[]  @relation("HotelOwner")
  chats        ChatConversation[]
  savedGuests  SavedGuest[]
  corporateId  String?
  corporate    Corporate? @relation(fields: [corporateId], references: [id])
  refreshTokens RefreshToken[]
  verificationCodes VerificationCode[]
  loyaltyPoints Int      @default(0) // current redeemable balance (denormalized)
  lifetimePoints Int     @default(0) // total points ever earned → membership tier
  referralCode  String?  @unique     // this user's invite code
  referredById  String?             // who invited this user
  twoFactorEnabled Boolean @default(false) // email-OTP 2FA on login
  loyaltyTxns   LoyaltyTxn[]
  hotelThreads  HotelThread[]
  tourBookings  TourBooking[]
  shuttleRides  ShuttleRide[]
  priceAlerts   PriceAlert[]
  recentlyViewed RecentlyViewed[]
  vouchers      UserVoucher[]
  questions     HotelQuestion[]
  loginEvents   LoginEvent[]
  wishlists     Wishlist[]
}

// A hotel the user recently opened (for "Baru dilihat" + recommendations).
model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String
  hotelId  String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([userId])
}

// A promo the user has collected into their "Voucher Saya" wallet.
model UserVoucher {
  id       String   @id @default(cuid())
  userId   String
  promoId  String
  claimedAt DateTime @default(now())
  usedAt   DateTime?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promo    Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([userId, promoId])
  @@index([userId])
}

// Public Q&A on a hotel — anyone can read; the property/admin answers.
model HotelQuestion {
  id         String   @id @default(cuid())
  hotelId    String
  userId     String?
  authorName String
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([hotelId])
}

// Direct guest ↔ hotel messaging (one thread per user+hotel).
model HotelThread {
  id        String   @id @default(cuid())
  userId    String
  hotelId   String
  createdAt DateTime @default(now())
  lastAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  messages  HotelMessage[]

  @@unique([userId, hotelId])
  @@index([hotelId])
}

model HotelMessage {
  id          String   @id @default(cuid())
  threadId    String
  fromGuest   Boolean  // true = guest, false = hotel
  body        String
  flagged     Boolean  @default(false) // true = hidden policy violation (contact sharing / off-system deal)
  violation   String?  // human-readable reason when flagged
  readByHotel Boolean  @default(false)
  readByGuest Boolean  @default(false)
  createdAt   DateTime @default(now())
  thread      HotelThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// Loyalty points ledger — earned on paid bookings, redeemable as discount.
model LoyaltyTxn {
  id        String   @id @default(cuid())
  userId    String
  points    Int      // + earn, − redeem
  type      String   // EARN | REDEEM
  bookingId String?
  note      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time codes for OTP (phone/email verification) and password reset.
// Only the SHA-256 hash of the code is stored.
model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    // OTP | RESET
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Metasearch & GDS distribution targets (Google Hotel Ads, Trivago, Amadeus…).
// Unlike SupplyChannel (where inventory comes FROM), these are where Miruum
// pushes its rates TO. Connections are mock until real feeds/credentials added.
model MetaChannel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  kind        String   // METASEARCH | GDS
  connected   Boolean  @default(false)
  logoUrl     String?
  color       String?
  config      Json?    // feed/credential config for the real integration
  lastPushAt  DateTime?
  createdAt   DateTime @default(now())
}

// Admin-managed in-app announcement popup (single active row).
model AppPopup {
  id        String   @id @default(cuid())
  active    Boolean  @default(false)
  title     String
  body      String
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Immutable audit trail of sensitive admin/partner actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  actorEmail String?
  action     String   // e.g. "hotel.update", "claim.pay"
  entity     String?  // "Hotel", "PayoutClaim"…
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Server-side refresh tokens — enable short-lived access tokens plus
// revocable sessions (logout, rotation). Only the SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  device    String?   // device/user-agent label for session management
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Login attempts for the "riwayat login" security view.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  device    String?
  ip        String?
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A named wishlist / trip that can hold hotels AND tours (mixed itinerary).
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  kind       String   // HOTEL | TOUR
  refId      String
  title      String
  imageUrl   String?
  subtitle   String?  // city / category
  price      Int      @default(0)
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, kind, refId])
  @@index([wishlistId])
}

// A reusable guest saved by a user for faster "booking for someone else".
model SavedGuest {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ChatSender {
  USER
  BOT
  AGENT
}

enum ChatStatus {
  BOT
  WAITING_AGENT
  AGENT
  CLOSED
}

model ChatConversation {
  id            String     @id @default(cuid())
  userId        String
  status        ChatStatus @default(BOT)
  createdAt     DateTime   @default(now())
  lastMessageAt DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
}

model ChatMessage {
  id             String     @id @default(cuid())
  conversationId String
  sender         ChatSender
  body           String
  createdAt      DateTime   @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  address     String
  regionId    String?  // leaf region (Desa/Kelurahan)
  lat         Float?
  lng         Float?
  description String
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  priceFrom   Int      @default(0) // rupiah / night
  priceBefore Int?     // previous priceFrom when it dropped → "harga turun" badge
  rateShopFreq Int     @default(0) // Miruum Intelligent auto rate-check: 0=off, 1/2/3 per day
  rateShoppedAt DateTime?          // last AI rate-shop for this hotel
  starRating  Int      @default(3)
  imageUrl    String
  checkInInfo  String  @default("Dari jam 14.00")
  checkOutInfo String  @default("Sebelum 12.00")
  isPromo     Boolean  @default(false)
  promoLabel  String?
  propertyType String  @default("HOTEL") // HOTEL | VILLA | APARTMENT | HOMESTAY | GUESTHOUSE | HOSTEL | RESORT
  depositBalance BigInt @default(0) // Advance Deposit Program balance (rupiah)
  ownerId     String?
  // Contracted products (a hotel on Extranet doesn't automatically contract
  // Channel Manager or PMS — those are separate paid modules).
  productChannelManager Boolean @default(false)
  productPMS            Boolean @default(false)
  channelId   String?  // supply source: own Channel Manager (DIRECT) or an OTA
  externalId  String?  // hotel id / deeplink at the source OTA
  createdAt   DateTime @default(now())

  owner       User?          @relation("HotelOwner", fields: [ownerId], references: [id])
  channel     SupplyChannel? @relation(fields: [channelId], references: [id])
  photos      HotelPhoto[]
  facilities  HotelFacility[]
  rooms       Room[]
  reviews     Review[]
  favorites   Favorite[]
  bookings    Booking[]
  packages    HotelPackage[]
  offers      HotelOffer[]
  settlements Settlement[]
  payoutClaims PayoutClaim[]
  programParticipations PromoParticipation[]
  threads     HotelThread[]
  rateObservations RateObservation[]
  nearby      HotelNearby[]
  priceAlerts PriceAlert[]
  recentlyViewed RecentlyViewed[]
  questions   HotelQuestion[]
  campaigns   HotelCampaign[]
  depositTxns DepositTxn[]
  invoices    HotelInvoice[]
}

// ─── Promo & Campaign self-registration (partner registers its own promo) ───
// A hotel-registered marketing campaign (flash sale / early bird / last minute).
// When APPROVED and currently active, Miruum applies a hotel-wide discount to
// all the property's rooms for the campaign window (auto-reverted on expiry).
model HotelCampaign {
  id          String   @id @default(cuid())
  hotelId     String
  type        String   @default("FLASH_SALE") // FLASH_SALE | EARLY_BIRD | LAST_MINUTE | CUSTOM
  name        String
  discountPct Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  minNights   Int      @default(1)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  applied     Boolean  @default(false)     // hotel-wide discount currently applied?
  note        String?
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([status])
}

// ─── Advance Deposit Program — a hotel's prepaid deposit ledger ───
// Commission owed to Miruum (Pay-at-Hotel bookings) is auto-offset from the
// deposit first, so the hotel avoids monthly cash transfers.
model DepositTxn {
  id          String    @id @default(cuid())
  hotelId     String
  kind        String    @default("TOPUP") // TOPUP | COMMISSION | REFUND | ADJUSTMENT
  amount      BigInt     // signed: +credit (top-up/refund) / -debit (commission)
  status      String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  note        String?
  period      String?    // linked invoice period (YYYY-MM) for COMMISSION debits
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([status])
}

// ─── Monthly invoice (perhitungan invoice) per hotel ───
// commissionOwed = hutang (hotel owes Miruum for Pay-at-Hotel bookings).
// payoutOwed     = piutang (Miruum owes hotel for prepaid DIRECT bookings).
model HotelInvoice {
  id             String    @id @default(cuid())
  hotelId        String
  period         String    // YYYY-MM (by check-out month)
  commissionOwed BigInt    @default(0)
  payoutOwed     BigInt    @default(0)
  bookingsCount  Int       @default(0)
  offsetFromDeposit BigInt @default(0) // commission auto-offset from deposit
  status         String    @default("OPEN") // OPEN | OFFSET | PAID
  dueDate        DateTime
  paidAt         DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  hotel          Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, period])
  @@index([hotelId])
}

// A guest's price-drop watch on a hotel — notified when priceFrom falls.
model PriceAlert {
  id                String   @id @default(cuid())
  userId            String
  hotelId           String
  lastNotifiedPrice Int?     // price at last notification (avoid repeat pings)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
}

// "What's nearby" — distance from the hotel to landmarks (airport, mall,
// station, beach, attraction…). Shown on the property page like Booking/Agoda.
model HotelNearby {
  id        String  @id @default(cuid())
  hotelId   String
  name      String
  category  String  @default("ATTRACTION") // AIRPORT | STATION | MALL | BEACH | ATTRACTION | HOSPITAL | RESTAURANT | LANDMARK
  distanceKm Float
  sortOrder Int     @default(0)
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

// Manually-recorded price of the SAME hotel on external OTA platforms — for
// Rate Intelligence comparison only (informational, no integration). Admin
// types "hotel A costs X on Tiket.com, Y on Agoda" and Miruum shows where our
// own price stands versus the market. Not sellable, not fetched via any API.
model RateObservation {
  id         String   @id @default(cuid())
  hotelId    String
  channelId  String
  price      Int      // observed price / night on that OTA (rupiah)
  source     String   @default("MANUAL") // MANUAL | AI (auto-found by the AI rate shopper)
  note       String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  hotel      Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel    SupplyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, channelId])
  @@index([hotelId])
}

// A payout to a DIRECT hotel (own Channel Manager) for its confirmed bookings,
// net of Miruum's platform commission. Recorded when the payout is disbursed.
model Settlement {
  id            String   @id @default(cuid())
  hotelId       String
  amount        BigInt   // rupiah paid out to the hotel
  bookingsCount Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// A partner's payout claim (pencairan) for earnings owed on DIRECT bookings.
// PENDING → admin pays (creates a Settlement) or rejects.
model PayoutClaim {
  id            String    @id @default(cuid())
  hotelId       String
  amount        BigInt
  bookingsCount Int       @default(0)
  bankName      String?
  bankAccount   String?
  accountHolder String?
  note          String?
  status        String    @default("PENDING") // PENDING | PAID | REJECTED
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// Supply source for hotel inventory. Miruum aggregates two kinds:
//  • DIRECT — connected hotels managed through Miruum's own Channel Manager (Extranet).
//  • OTA    — resold as a sub-agent of another OTA (Tiket.com, Agoda, Traveloka…).
enum ChannelType {
  DIRECT
  OTA
}

model SupplyChannel {
  id            String      @id @default(cuid())
  code          String      @unique // DIRECT, TIKETCOM, AGODA, TRAVELOKA…
  name          String
  type          ChannelType @default(OTA)
  // Contracted = Miruum is a sub-agent and may resell this source (sellable).
  // Non-contracted = read-only competitor, tracked for rate intelligence only.
  contracted    Boolean     @default(true)
  commissionPct Float       @default(0) // markup % (when markupType = PCT)
  // Pricing intelligence: is the source price already final (fee included) or
  // does Miruum add a markup? Markup can be a percentage or a flat nominal (Rp).
  feeIncluded   Boolean     @default(false) // true = basePrice is final, no markup
  markupType    String      @default("PCT") // PCT | NOMINAL
  markupNominal Int         @default(0)      // flat markup in Rupiah (when NOMINAL)
  logoUrl       String?
  color         String?     // badge color (hex)
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  connectorType String      @default("MOCK") // MOCK | HTTP | DIRECT — how offers are fetched
  config        Json?       // gateway config for HTTP connectors (baseUrl/auth/request/map)
  createdAt     DateTime    @default(now())

  hotels        Hotel[]
  offers        HotelOffer[]
  bookings      Booking[]
  roomMaps      RoomChannelMap[]
  rateObservations RateObservation[]
}

// A price/availability offer for a hotel from ONE supply source. The same
// canonical hotel can have many offers (Direct + several OTAs) — Miruum picks
// the cheapest available and shows the rest as a price comparison.
model HotelOffer {
  id          String   @id @default(cuid())
  hotelId     String
  channelId   String
  basePrice   Int      // supplier price / night (rupiah)
  markupPct   Float    @default(0) // Miruum margin on top of basePrice
  price       Int      // customer-facing price = basePrice * (1 + markupPct/100)
  available   Boolean  @default(true)
  roomsLeft   Int      @default(0)
  deeplink    String?  // listing URL at the source OTA
  supplierRef String?  // id at the source
  fetchedAt   DateTime @default(now())

  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel     SupplyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, channelId])
}

model HotelPhoto {
  id      String @id @default(cuid())
  hotelId String
  url     String
  sort    Int    @default(0)
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Facility {
  id    String @id @default(cuid())
  name  String @unique
  icon  String // icon key used by the app
  hotels HotelFacility[]
}

model HotelFacility {
  hotelId    String
  facilityId String
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([hotelId, facilityId])
}

model Room {
  id                String  @id @default(cuid())
  hotelId           String
  name              String
  bedInfo           String  @default("1 Double bed dan 2 Ranjang Twin")
  capacity          Int     @default(2)
  price             Int
  originalPrice     Int?
  discountLabel     String?
  refundable        Boolean @default(true)
  breakfast         Boolean @default(false)
  freeWifi          Boolean @default(true)
  freeCancellation  Boolean @default(true)
  stock             Int     @default(5)
  housekeeping      String  @default("CLEAN") // PMS: CLEAN | DIRTY | INSPECT
  hotel             Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  packages          HotelPackage[]
  availability      RoomAvailability[]
  channelMaps       RoomChannelMap[]
  units             RoomUnit[]
  ratePlans         RatePlan[]
}

// Multiple sellable rate plans for the same room (Room Only / Breakfast /
// Free-cancel / Non-refundable…), each with its own price delta & policy —
// exactly like Traveloka/Booking/Agoda rate-plan matrices.
model RatePlan {
  id               String  @id @default(cuid())
  roomId           String
  name             String  // "Kamar Saja", "Termasuk Sarapan", "Bebas Batal"
  boardBasis       String  @default("ROOM_ONLY") // ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD
  refundable       Boolean @default(true)
  freeCancellation Boolean @default(false)
  priceDelta       Int     @default(0) // +/- Rupiah per night vs the room base price
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
  room             Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  @@index([roomId])
}

// Maps a Miruum room to an OTA's room-type id — the basis for two-way sync and
// outbound rate/availability push to that OTA.
model RoomChannelMap {
  id             String   @id @default(cuid())
  roomId         String
  channelId      String
  externalRoomId String   // room-type id at the OTA
  enabled        Boolean  @default(true)
  lastPushedAt   DateTime?
  pushStatus     String?  // OK | error message
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel        SupplyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([roomId, channelId])
}

// Per-date rate & allotment for a room — the calendar behind availability and
// dynamic pricing. Managed by the hotel (Extranet) for DIRECT inventory.
model RoomAvailability {
  id        String   @id @default(cuid())
  roomId    String
  date      DateTime @db.Date
  price     Int      // rate for this night (rupiah)
  allotment Int      @default(0) // rooms available to sell this night
  closed    Boolean  @default(false)
  minStay   Int      @default(1)     // minimum nights
  cta       Boolean  @default(false) // closed to arrival
  ctd       Boolean  @default(false) // closed to departure
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
}

// Home promo/marketing banner (admin-managed carousel).
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  imageUrl  String
  badge     String?  // e.g. "30%"
  linkUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Global platform settings (key → value), read with defaults by the app/finance.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// FCM device token for push notifications (registered by the mobile app).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String?
  token     String   @unique
  platform  String?  // android | ios
  createdAt DateTime @default(now())
}

// Static/legal content pages (T&C, Privacy, About) managed from Back Office
// and shown in the mobile app. slug ∈ {terms, privacy, about}.
model Content {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @default(now()) @updatedAt
}

// A curated bundle: hotel stay + inclusions (breakfast, transfer, spa…) at one bundled price.
// The "Hotel Package" side of Miruum, alongside plain "Hotel" room booking.
model HotelPackage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  city          String
  description   String
  imageUrl      String
  hotelId       String
  roomId        String
  nights        Int      @default(2)
  days          Int      @default(3)
  guests        Int      @default(2)
  boardBasis    String   @default("BREAKFAST") // ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD | ALL_INCLUSIVE (meal plan)
  inclusions    String[] // ekstra non-makan, e.g. ["Laundry 3 potong/hari", "Antar-jemput bandara", "Spa 60 menit"]
  originalPrice Int      // sum of à-la-carte value (rupiah, whole bundle)
  price         Int      // bundled price (rupiah, whole bundle)
  discountPct   Int      @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  starRating    Int      @default(4)
  badge         String?  // e.g. "Best Seller", "Staycation"
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())

  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room          Room     @relation(fields: [roomId], references: [id])
  bookings      Booking[]
}

model Review {
  id         String   @id @default(cuid())
  hotelId    String
  userId     String?
  authorName String
  rating     Float
  body       String
  // Category sub-scores (0–10), like Booking/Agoda. Null = not rated.
  scoreCleanliness Float?
  scoreLocation    Float?
  scoreStaff       Float?
  scoreFacilities  Float?
  scoreComfort     Float?
  scoreValue       Float?
  photos     String[] @default([]) // guest-uploaded review photo URLs
  verified   Boolean  @default(false) // from a real completed stay
  bookingId  String?  // links the review to the stay that earned it
  reply      String?  // partner's response to the guest review
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

// Individual numbered rooms within a room type (PMS room assignment).
model RoomUnit {
  id          String   @id @default(cuid())
  roomId      String   // room type
  number      String   // e.g. "301"
  status      String   @default("CLEAN") // CLEAN | DIRTY | INSPECT | OOO (out of order)
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([roomId])
}

// Guest folio charge lines (PMS billing).
model FolioCharge {
  id          String   @id @default(cuid())
  bookingId   String
  kind        String   // ROOM | MINIBAR | FNB | LAUNDRY | SPA | OTHER
  description String
  amount      BigInt   // unit price (rupiah)
  qty         Int      @default(1)
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// Night audit / manager's daily report (D-report) snapshot.
model NightAuditLog {
  id           String   @id @default(cuid())
  hotelId      String?
  businessDate DateTime
  rooms        Int      @default(0)
  occupiedRooms Int     @default(0)
  occupancyPct Float    @default(0)
  adr          BigInt   @default(0)   // average daily rate
  revpar       BigInt   @default(0)   // revenue per available room
  arrivals     Int      @default(0)
  departures   Int      @default(0)
  inhouse      Int      @default(0)
  noShows      Int      @default(0)
  roomRevenue  BigInt   @default(0)
  extraRevenue BigInt   @default(0)
  totalRevenue BigInt   @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Maintenance / housekeeping work orders.
model WorkOrder {
  id          String    @id @default(cuid())
  hotelId     String
  roomNumber  String?
  category    String    @default("MAINTENANCE") // MAINTENANCE | HOUSEKEEPING | IT | OTHER
  title       String
  description String    @default("")
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String    @default("OPEN")   // OPEN | IN_PROGRESS | DONE
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([hotelId])
}

// Guest CRM note/preferences per hotel+email (front-desk profile extra).
model GuestNote {
  id          String   @id @default(cuid())
  hotelId     String
  email       String
  note        String   @default("")
  preferences String   @default("")
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, email])
}

model Favorite {
  userId  String
  hotelId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  userId         String
  hotelId        String
  roomId         String
  packageId      String?       // set when the booking is a Hotel Package bundle
  packageTitle   String?
  channelId      String?       // supply source this booking was routed to
  corporateId    String?       // set when booked via a corporate/government account
  corporateInvoiceId String?   // billing statement this booking was billed on
  supplierRef    String?       // reference at the OTA when routed to an external source
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  guests         Int           @default(2)
  rooms          Int           @default(1)
  bookerName     String
  bookerEmail    String
  bookerPhone    String
  forSelf        Boolean       @default(true)
  specialRequest String?
  payAtHotel     Boolean       @default(false) // confirmed reservation, guest pays at property
  reviewRequestedAt DateTime?  // when we asked the guest to review after checkout
  roomGuests     Json?         // per-room guest details [{name, request}] for multi-room bookings
  roomPrice      BigInt
  taxFee         BigInt
  discount       BigInt        @default(0)
  promoCode      String?
  totalPrice     BigInt
  status         BookingStatus @default(PENDING)
  paymentMethod  String?
  bank           String?
  paidAt         DateTime?
  checkedInAt    DateTime?     // PMS front desk: guest checked in
  checkedOutAt   DateTime?     // PMS front desk: guest checked out
  roomUnitId     String?       // assigned physical room (number)
  noShow         Boolean       @default(false)
  onlineCheckedIn Boolean      @default(false) // guest completed digital check-in
  keyCode        String?       // digital room key / access code
  // Refund disbursement details (collected on cancellation of a paid booking).
  refundBankName      String?
  refundBankAccount   String?
  refundAccountHolder String?
  ratePlanId     String?       // chosen rate plan (multi rate-plan per room)
  ratePlanName   String?       // snapshot of the plan name
  planRefundable      Boolean? // policy snapshot (falls back to room when null)
  planFreeCancellation Boolean?
  createdAt      DateTime      @default(now())
  roomUnit       RoomUnit?     @relation(fields: [roomUnitId], references: [id])
  folioCharges   FolioCharge[]

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  room           Room          @relation(fields: [roomId], references: [id])
  ratePlan       RatePlan?     @relation(fields: [ratePlanId], references: [id])
  package        HotelPackage? @relation(fields: [packageId], references: [id])
  channel        SupplyChannel? @relation(fields: [channelId], references: [id])
  corporate      Corporate?     @relation(fields: [corporateId], references: [id])
  corporateInvoice CorporateInvoice? @relation(fields: [corporateInvoiceId], references: [id])
  payments       Payment[]
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

// A payment attempt for a booking. Provider-agnostic (MOCK/FLIP/…) — the actual
// integration lives in the payment gateway (backend/src/payments.ts).
model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  provider     String        @default("MOCK") // MOCK | FLIP | MIDTRANS | XENDIT
  method       String        // VA_BCA, EWALLET_GOPAY, QRIS, …
  methodLabel  String
  amount       BigInt
  status       PaymentStatus @default(PENDING)
  externalId   String?       // provider payment/bill id
  vaNumber     String?       // virtual account number
  qrString     String?       // QRIS payload
  payUrl       String?       // redirect / deeplink (e-wallet)
  expiresAt    DateTime?
  paidAt       DateTime?
  raw          Json?
  createdAt    DateTime      @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Promo {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  discountPct Int      @default(0)
  imageUrl    String
  validUntil  String?
  claimable   Boolean  @default(false) // shows in the "Voucher Saya" wallet to collect
  userVouchers UserVoucher[]
}

enum ProgramType {
  PROMO
  CAMPAIGN
}

enum ParticipationStatus {
  INVITED
  JOINED
  DECLINED
}

// A promo/campaign PROGRAM created by Miruum, broadcast to hotels who opt in.
// PROMO = discount program; CAMPAIGN = marketing/thematic campaign.
model PromoProgram {
  id          String      @id @default(cuid())
  type        ProgramType @default(PROMO)
  title       String
  description String
  discountPct Int         @default(0)
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?
  terms       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  participations PromoParticipation[]
}

// A hotel's participation in a program (invited → joined/declined + its offer).
model PromoParticipation {
  id        String              @id @default(cuid())
  programId String
  hotelId   String
  status    ParticipationStatus @default(INVITED)
  offerPct  Int                 @default(0) // discount the hotel offers for this program
  note      String?
  joinedAt  DateTime?
  createdAt DateTime            @default(now())
  program   PromoProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  hotel     Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([programId, hotelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  type      String   @default("info") // info | success | pending | cancel
  hotelName String?
  orderCode String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Tour module (activities / trips) ───────────────────────────
model Tour {
  id            String   @id @default(cuid())
  title         String
  city          String
  category      String   @default("Wisata") // Alam | Budaya | Petualangan | Kuliner | Bahari
  description   String
  imageUrl      String
  durationHours Int      @default(4)
  price         Int      // per pax (Rupiah)
  maxPax        Int      @default(20)
  rating        Float    @default(4.8)
  reviewCount   Int      @default(0)
  highlights    String[] @default([])
  included      String[] @default([])
  meetingPoint  String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  bookings      TourBooking[]

  @@index([active])
}

model TourBooking {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  tourId        String
  date          DateTime @db.Date
  pax           Int      @default(1)
  unitPrice     Int
  totalPrice    Int
  status        String   @default("PENDING") // PENDING | PAID | COMPLETED | CANCELLED
  bookerName    String
  bookerPhone   String
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour          Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tourId])
}

// ─────────────────────────── Shuttle module (ride-hailing, Grab-style) ───────────────────────────
model ShuttleVehicleType {
  id        String   @id @default(cuid())
  name      String   // Ekonomi | Premium | Van
  icon      String   @default("car") // car | premium | van | bike
  baseFare  Int      @default(8000)  // flag-fall
  perKm     Int      @default(4000)  // per-km rate
  minFare   Int      @default(12000)
  capacity  Int      @default(4)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  rides     ShuttleRide[]
}

model ShuttleRide {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  vehicleTypeId String
  originLabel   String
  originLat     Float
  originLng     Float
  destLabel     String
  destLat       Float
  destLng       Float
  distanceKm    Float
  fare          Int
  paymentMethod String   @default("CASH") // CASH | WALLET | QRIS
  status        String   @default("REQUESTED") // REQUESTED | DRIVER_ASSIGNED | ONGOING | COMPLETED | CANCELLED
  driverName    String?
  driverPhone   String?
  driverPlate   String?
  driverRating  Float?
  createdAt     DateTime @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   ShuttleVehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([userId])
}

// ─────────────────────────── Articles / Blog (customer web) ───────────────────────────
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  coverImage  String
  category    String   @default("Tips")   // Tips | Destinasi | Panduan | Promo | Inspirasi
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([published])
}

// ─── Partner (hotel) self-registration — "Daftarkan Properti Anda" ───
// Public application from the customer web / extranet; admin approves → creates
// a PARTNER user + Hotel so the owner can log into the Extranet.
model PartnerApplication {
  id           String   @id @default(cuid())
  propertyName String
  propertyType String   @default("HOTEL")
  city         String
  address      String
  picName      String
  email        String
  phone        String
  website      String?
  roomCount    Int?
  note         String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt    DateTime @default(now())

  @@index([status])
}
