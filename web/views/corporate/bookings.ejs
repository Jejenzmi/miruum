<%- include('../partials/top', { title:'Riwayat Pesanan', heading:'Riwayat Pemesanan', section:'corporate', active:'bookings', me }) %>

<div class="card">
  <h2>Semua Pemesanan Corporate</h2>
  <p class="muted" style="margin-top:-8px">Setiap pemesanan bisa diunduh invoice &amp; e-voucher-nya.</p>
  <div style="overflow-x:auto">
    <table>
      <thead><tr><th>Kode</th><th>Hotel · Kamar</th><th>Tamu</th><th>Menginap</th><th>Total</th><th>Status</th><th>Dokumen</th></tr></thead>
      <tbody>
        <% bookings.forEach(function(b){ %>
          <tr>
            <td><b><%= b.code %></b></td>
            <td><%= b.hotel.name %><br><span class="muted" style="font-size:11px"><%= b.room.name %></span></td>
            <td><%= b.bookerName %></td>
            <td style="font-size:12px"><%= new Date(b.checkIn).toLocaleDateString('id-ID',{day:'2-digit',month:'short'}) %> → <%= new Date(b.checkOut).toLocaleDateString('id-ID',{day:'2-digit',month:'short'}) %></td>
            <td><b><%= rupiah(b.totalPrice) %></b></td>
            <td><span class="pill <%= b.status %>"><%= b.status %></span></td>
            <td>
              <a class="btn ghost sm" href="/api/invoices/<%= b.code %>" target="_blank">Invoice</a>
              <a class="btn ghost sm" href="/api/vouchers/<%= b.code %>" target="_blank">Voucher</a>
            </td>
          </tr>
        <% }) %>
        <% if (!bookings.length) { %><tr><td colspan="7" class="empty">Belum ada pemesanan</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/bottom') %>
