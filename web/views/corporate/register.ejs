<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pengajuan Layanan Corporate — Miruum</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="auth">
  <div class="auth-form-wrap" style="align-items:start">
    <div class="auth-card" style="max-width:460px;padding-top:40px;padding-bottom:40px">
      <img src="/static/logo.png" alt="Miruum" class="auth-logo">
      <span class="eyebrow">Corporate &amp; Government</span>
      <h2>Ajukan Layanan Corporate</h2>
      <p class="lead">Lengkapi data corporate &amp; unggah dokumen legalitas. Tim Miruum akan meninjau &amp; mengaktifkan akun (kredensial dikirim ke email PIC).</p>

      <% if (done) { %>
        <div class="notice ok" style="margin-bottom:16px">Pengajuan terkirim! Tim Miruum akan menghubungi PIC via email. <a href="/corporate/login">Kembali ke login</a></div>
      <% } %>
      <% if (error) { %><div class="error"><%= error %></div><% } %>

      <form id="corpForm" method="post" action="/corporate/register" enctype="multipart/form-data">
        <label>Jenis Corporate</label>
        <select id="entityType" name="entityType">
          <% (cfg.entityTypes || []).forEach(function(t){ %>
            <option value="<%= t %>"><%= (cfg.labels && cfg.labels[t]) || t %></option>
          <% }) %>
        </select>

        <label>Nama Corporate / Perusahaan</label>
        <input name="companyName" placeholder="mis. PT Nusantara Jaya" required>
        <div class="row2">
          <div><label>Nama PIC</label><input name="picName" placeholder="Penanggung jawab" required></div>
          <div><label>Jabatan PIC</label><input name="picPosition" placeholder="mis. Manajer GA"></div>
        </div>
        <div class="row2">
          <div><label>Email PIC</label><input name="email" type="email" placeholder="email@perusahaan.co.id" required></div>
          <div><label>No. Telepon</label><input name="phone" placeholder="08xx / 021xxx" required></div>
        </div>
        <%- include('../partials/region_picker') %>
        <div class="row2">
          <div><label>NPWP (opsional)</label><input name="taxId" placeholder="00.000.000.0-000.000"></div>
          <div><label>Estimasi Karyawan</label><input name="employees" type="number" min="0" placeholder="mis. 250"></div>
        </div>
        <label>Kebutuhan / Catatan</label>
        <textarea name="note" rows="2" placeholder="mis. rata-rata 30 pemesanan/bulan untuk perjalanan dinas"></textarea>

        <!-- Legality documents — the required set adapts to the chosen entity type -->
        <div style="margin-top:18px;padding-top:6px;border-top:1px solid var(--line)">
          <% (cfg.entityTypes || []).forEach(function(t){ %>
            <div class="doc-block" data-type="<%= t %>" style="display:none">
              <label style="margin-top:12px">Dokumen Legalitas — <%= (cfg.labels && cfg.labels[t]) || t %></label>
              <% ((cfg.catalog && cfg.catalog[t]) || []).forEach(function(d){ %>
                <div class="doc-row" style="display:flex;align-items:center;gap:10px;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)">
                  <div style="min-width:0">
                    <div style="font-weight:600;font-size:13px"><%= d.label %><% if (d.required) { %> <span style="color:#e5484d">*</span><% } %></div>
                    <div class="muted" style="font-size:11px"><%= d.required ? 'Wajib' : 'Opsional' %> · PDF / JPG / PNG · maks 8MB</div>
                  </div>
                  <input type="file" class="doc-input" name="doc_<%= d.key %>" accept=".pdf,image/png,image/jpeg,image/webp" data-req="<%= d.required ? 1 : 0 %>" style="max-width:170px;font-size:12px" disabled>
                </div>
              <% }) %>
            </div>
          <% }) %>
        </div>

        <div style="margin-top:18px"><button class="btn" style="width:100%;justify-content:center">Kirim Pengajuan</button></div>
      </form>
      <p style="text-align:center;margin-top:16px;font-size:13px">Sudah punya akun? <a href="/corporate/login">Masuk di sini</a></p>
    </div>
  </div>
  <%- include('../partials/auth_brand', { variant: 'corp' }) %>
</div>

<script>
(function () {
  var sel = document.getElementById('entityType');
  var blocks = Array.prototype.slice.call(document.querySelectorAll('.doc-block'));
  if (!sel) return;
  function sync() {
    var v = sel.value;
    blocks.forEach(function (b) {
      var on = b.getAttribute('data-type') === v;
      b.style.display = on ? 'block' : 'none';
      Array.prototype.slice.call(b.querySelectorAll('.doc-input')).forEach(function (i) { i.disabled = !on; });
    });
  }
  sel.addEventListener('change', sync);
  sync();
  document.getElementById('corpForm').addEventListener('submit', function (e) {
    var block = document.querySelector('.doc-block[data-type="' + sel.value + '"]');
    if (!block) return;
    var missing = Array.prototype.slice.call(block.querySelectorAll('.doc-input[data-req="1"]'))
      .filter(function (i) { return !i.files.length; });
    if (missing.length) { e.preventDefault(); alert('Lengkapi semua dokumen wajib (bertanda *) terlebih dahulu.'); }
  });
})();
</script>
<%- include('../partials/req_marker') %>
</body>
</html>
