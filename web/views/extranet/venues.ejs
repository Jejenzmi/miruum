<%- include('../partials/top', { title:'Venue', heading:'Kelola Venue / MICE', section:'extranet', active:'venues', me }) %>

<% if (done) { %><div class="notice ok">Venue tersimpan.</div><% } %>
<% if (err) { %><div class="notice bad"><%= err %></div><% } %>
<%
  var TYPE={MEETING_ROOM:'Meeting Room',BALLROOM:'Ballroom',FUNCTION_HALL:'Function Hall',OUTDOOR:'Outdoor'};
  var BASIS={HOUR:'/jam',HALFDAY:'/half-day',FULLDAY:'/full-day',PERPAX:'/pax'};
%>
<p class="muted" style="margin:-4px 0 16px">Jual ruang meeting, ballroom & venue wedding. <b>Instant Book</b> = harga fix langsung dipesan (cocok meeting room). <b>Inquiry</b> = tamu kirim permintaan → Anda kirim penawaran (cocok ballroom/wedding). Bisa dimatikan admin lewat toggle modul.</p>

<% if (!hotels.length) { %><div class="card"><div class="empty">Belum ada hotel.</div></div><% } else { %>
<div class="card">
  <h3 style="margin-top:0">Tambah Venue</h3>
  <form method="post" action="/extranet/venues" enctype="multipart/form-data">
    <div class="row2">
      <% if (hotels.length>1) { %><div><label>Hotel</label><select name="hotelId"><% hotels.forEach(function(h){ %><option value="<%= h.id %>"><%= h.name %></option><% }) %></select></div><% } else { %><input type="hidden" name="hotelId" value="<%= hotels[0].id %>"><% } %>
      <div><label>Nama Venue <span style="color:#c0392b">*</span></label><input name="name" required placeholder="mis. Grand Ballroom"></div>
    </div>
    <div class="row2">
      <div><label>Tipe</label><select name="type"><% Object.keys(TYPE).forEach(function(k){ %><option value="<%= k %>"><%= TYPE[k] %></option><% }) %></select></div>
      <div><label>Mode Pemesanan</label><select name="bookingMode"><option value="INSTANT">Instant Book (harga fix)</option><option value="INQUIRY">Inquiry → Penawaran</option></select></div>
    </div>
    <div class="row2">
      <div><label>Basis Harga</label><select name="priceBasis"><% Object.keys(BASIS).forEach(function(k){ %><option value="<%= k %>"><%= BASIS[k].replace('/','per ') %></option><% }) %></select></div>
      <div><label>Harga Dasar (Rp)</label><input name="basePrice" type="number" min="0" placeholder="mis. 15000000"></div>
    </div>
    <div class="row2">
      <div><label>Luas (m²)</label><input name="area" type="number" min="0" placeholder="mis. 400"></div>
      <div><label>Kapasitas Theatre</label><input name="capTheatre" type="number" min="0" placeholder="mis. 500"></div>
    </div>
    <div class="row2">
      <div><label>Kapasitas Classroom</label><input name="capClassroom" type="number" min="0"></div>
      <div><label>Kapasitas Round Table</label><input name="capRound" type="number" min="0"></div>
    </div>
    <label>Deskripsi</label><textarea name="description" rows="2" placeholder="Fasilitas: AC, sound system, panggung, dsb."></textarea>
    <label>Foto Venue</label><input type="file" name="image" accept="image/*">
    <div style="margin-top:14px"><button class="btn">Simpan Venue</button></div>
  </form>
</div>

<% venues.forEach(function(v){ %>
  <div class="card">
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      <% if (v.imageUrl) { %><img src="<%= v.imageUrl %>" style="width:120px;height:90px;object-fit:cover;border-radius:10px"><% } %>
      <div style="flex:1;min-width:220px">
        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px">
          <div><b style="font-size:16px"><%= v.name %></b> <span class="pill PARTNER"><%= TYPE[v.type]||v.type %></span> <span class="pill <%= v.bookingMode==='INSTANT'?'PAID':'PENDING' %>"><%= v.bookingMode==='INSTANT'?'Instant':'Inquiry' %></span><% if(!v.active){ %> <span class="pill CANCELLED">Nonaktif</span><% } %></div>
          <div style="font-weight:800;color:#E07C17"><%= rupiah(v.basePrice) %> <span class="muted" style="font-weight:400;font-size:12px"><%= BASIS[v.priceBasis] %></span></div>
        </div>
        <div class="muted" style="font-size:12.5px;margin-top:4px"><%= v.area?(v.area+' m² · '):'' %>Theatre <%= v.capTheatre||'-' %> · Classroom <%= v.capClassroom||'-' %> · Round <%= v.capRound||'-' %> · <%= v._count.bookings %> booking</div>
        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
          <form method="post" action="/extranet/venues/<%= v.id %>" style="margin:0"><input type="hidden" name="active" value="<%= v.active?'false':'true' %>"><button class="btn ghost sm"><%= v.active?'Nonaktifkan':'Aktifkan' %></button></form>
          <form method="post" action="/extranet/venues/<%= v.id %>" style="display:flex;gap:6px;margin:0"><input name="basePrice" type="number" value="<%= v.basePrice %>" style="max-width:130px"><select name="bookingMode" style="width:auto"><option value="INSTANT" <%= v.bookingMode==='INSTANT'?'selected':'' %>>Instant</option><option value="INQUIRY" <%= v.bookingMode==='INQUIRY'?'selected':'' %>>Inquiry</option></select><button class="btn ghost sm">Simpan</button></form>
          <form method="post" action="/extranet/venues/<%= v.id %>/delete" data-confirm="Hapus venue ini?" style="margin:0"><button class="btn danger sm">Hapus</button></form>
        </div>
      </div>
    </div>
    <div style="margin-top:12px;border-top:1px dashed var(--line);padding-top:10px">
      <div style="font-weight:700;font-size:13px;margin-bottom:6px">Paket (<%= v.packages.length %>)</div>
      <% v.packages.forEach(function(p){ %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid #f4f4f6">
          <div><%= p.name %> <span class="muted" style="font-size:12px"><%= p.perPax?'(per pax)':'' %></span></div>
          <div style="display:flex;gap:8px;align-items:center"><b><%= rupiah(p.price) %><%= p.perPax?'/pax':'' %></b><form method="post" action="/extranet/venue-packages/<%= p.id %>/delete" style="margin:0" data-confirm="Hapus paket?"><button class="btn danger sm" style="padding:2px 8px">✕</button></form></div>
        </div>
      <% }) %>
      <form method="post" action="/extranet/venues/<%= v.id %>/packages" style="display:flex;gap:6px;align-items:end;flex-wrap:wrap;margin-top:8px">
        <div style="flex:1;min-width:140px"><input name="name" placeholder="Nama paket (mis. Wedding Gold)" required></div>
        <div><input name="price" type="number" min="0" placeholder="Harga" required style="max-width:120px"></div>
        <label style="display:flex;align-items:center;gap:5px;font-size:12px;margin:0"><input type="checkbox" name="perPax" value="true" style="width:auto"> per pax</label>
        <input name="inclusions" placeholder="Inklusi (satu per baris)" style="min-width:160px">
        <button class="btn sm">+ Paket</button>
      </form>
    </div>
  </div>
<% }) %>
<% if(!venues.length){ %><div class="card"><div class="empty">Belum ada venue. Tambahkan di atas.</div></div><% } %>
<% } %>

<%- include('../partials/bottom') %>
