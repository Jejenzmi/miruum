<%- include('../partials/top', { title: hotel.name, heading: hotel.name, section:'extranet', active:'dashboard', me }) %>

<div class="card">
  <div style="display:flex;gap:16px;align-items:center">
    <img class="thumb" style="width:80px;height:80px" src="<%= hotel.imageUrl %>" alt="">
    <div>
      <h2 style="margin-bottom:2px"><%= hotel.name %></h2>
      <p class="muted" style="margin:0"><%= hotel.city %> · <%= '★'.repeat(hotel.starRating) %> · <%= hotel.rating %>/10</p>
    </div>
  </div>
</div>

<% if (saved==='konten') { %><div class="notice ok">Konten properti tersimpan.</div><% } %>
<% if (saved==='fasilitas') { %><div class="notice ok">Fasilitas tersimpan.</div><% } %>

<div class="card">
  <h2>Konten Properti</h2>
  <p class="muted" style="margin-top:-8px">Deskripsi & kebijakan yang tampil di halaman hotel pada aplikasi.</p>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/content">
    <label>Deskripsi Hotel</label>
    <textarea name="description" rows="4" style="width:100%;box-sizing:border-box"><%= hotel.description || '' %></textarea>
    <div class="row2">
      <div><label>Info Check-in</label><input name="checkInInfo" value="<%= hotel.checkInInfo || '' %>" placeholder="Dari jam 14.00"></div>
      <div><label>Info Check-out</label><input name="checkOutInfo" value="<%= hotel.checkOutInfo || '' %>" placeholder="Sebelum 12.00"></div>
    </div>
    <div style="margin-top:14px"><button class="btn sm">Simpan Konten</button></div>
  </form>
</div>

<div class="card">
  <h2>Fasilitas Hotel</h2>
  <p class="muted" style="margin-top:-8px">Pilih fasilitas yang tersedia — memengaruhi filter pencarian tamu.</p>
  <% var have = (hotel.facilities||[]).map(function(f){ return f.facilityId; }); %>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/facilities">
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <% (facilities||[]).forEach(function(f){ %>
        <label style="display:flex;align-items:center;gap:6px;margin:0;padding:7px 12px;border:1px solid var(--line);border-radius:10px">
          <input type="checkbox" name="facilityIds" value="<%= f.id %>" style="width:auto" <%= have.indexOf(f.id)>=0?'checked':'' %>> <%= f.name %>
        </label>
      <% }) %>
    </div>
    <div style="margin-top:14px"><button class="btn sm">Simpan Fasilitas</button></div>
  </form>
</div>

<div class="card">
  <h2>Foto Hotel</h2>
  <p class="muted" style="margin-top:-8px">Kelola galeri foto yang tampil di aplikasi.</p>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px">
    <% (hotel.photos||[]).forEach(function(ph){ %>
      <div style="position:relative">
        <img src="<%= ph.url %>" style="width:110px;height:80px;object-fit:cover;border-radius:12px">
        <form method="post" action="/extranet/photos/<%= ph.id %>/delete" data-confirm="Hapus foto?" style="position:absolute;top:4px;right:4px">
          <button class="btn danger sm" style="padding:2px 8px"></button>
        </form>
      </div>
    <% }) %>
    <% if (!(hotel.photos||[]).length) { %><span class="muted">Belum ada foto</span><% } %>
  </div>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/photos" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;max-width:520px">
    <input type="file" name="photo" accept="image/*" required style="flex:1">
    <button class="btn sm">Unggah Foto</button>
  </form>
  <p class="muted" style="font-size:11px;margin-top:6px">Format JPG/PNG/WebP, maks 6MB.</p>
</div>

<div class="card">
  <h2>Promo Hotel</h2>
  <p class="muted" style="margin-top:-8px">Tandai hotel sedang promo & tampilkan label di kartu hotel.</p>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/promo" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" name="isPromo" style="width:auto" <%= hotel.isPromo?'checked':'' %>> Aktifkan promo</label>
    <input name="promoLabel" value="<%= hotel.promoLabel || '' %>" placeholder="mis. Save up to 30%" style="max-width:260px">
    <button class="btn sm">Simpan</button>
  </form>
</div>

<div class="card">
  <h2>Kamar, Atribut & Promo</h2>
  <p class="muted" style="margin-top:-8px">Atur harga, stok, kapasitas, kebijakan kamar, dan buat promo (diskon) sendiri.</p>
  <% hotel.rooms.forEach(function(r){ var dealPct = (r.originalPrice && r.originalPrice>r.price) ? Math.round((1 - r.price/r.originalPrice)*100) : 0; %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <b><%= r.name %></b>
        <% if (dealPct>0) { %><span class="pill PAID">Promo -<%= dealPct %>% · <s style="opacity:.6"><%= rupiah(r.originalPrice) %></s> → <%= rupiah(r.price) %></span><% } %>
      </div>
      <form method="post" action="/extranet/rooms/<%= r.id %>" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-top:10px">
        <div><label style="margin:0 0 4px">Harga/malam</label><input name="price" type="number" value="<%= r.originalPrice && r.originalPrice>r.price ? r.originalPrice : r.price %>" style="max-width:130px"></div>
        <div><label style="margin:0 0 4px">Stok</label><input name="stock" type="number" value="<%= r.stock %>" style="max-width:80px"></div>
        <div><label style="margin:0 0 4px">Kapasitas</label><input name="capacity" type="number" value="<%= r.capacity %>" style="max-width:90px"></div>
        <label class="pr-check" style="margin:0 0 8px"><input type="checkbox" name="refundable" <%= r.refundable?'checked':'' %>> Refundable</label>
        <label class="pr-check" style="margin:0 0 8px"><input type="checkbox" name="freeCancellation" <%= r.freeCancellation?'checked':'' %>> Gratis batal</label>
        <label class="pr-check" style="margin:0 0 8px"><input type="checkbox" name="breakfast" <%= r.breakfast?'checked':'' %>> Sarapan</label>
        <button class="btn sm" style="margin-bottom:2px">Simpan Kamar</button>
      </form>
      <form method="post" action="/extranet/rooms/<%= r.id %>/deal" style="display:flex;gap:8px;align-items:end;margin-top:8px;padding-top:10px;border-top:1px dashed var(--line)">
        <div><label style="margin:0 0 4px">Promo diskon (%)</label><input name="dealPct" type="number" min="0" max="90" value="<%= dealPct %>" style="max-width:110px" placeholder="0 = nonaktif"></div>
        <button class="btn ghost sm" style="margin-bottom:2px">Terapkan Promo</button>
      </form>
      <div style="margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)">
        <b style="font-size:12.5px">Rate plan</b>
        <p class="muted" style="font-size:11px;margin:2px 0 8px">Kamar sama dengan beberapa tarif (Kamar Saja / Sarapan / Bebas Batal / Non-refund). Delta = +/- Rp per malam dari harga kamar.</p>
        <% (r.ratePlans||[]).forEach(function(p){ %>
          <div style="display:flex;align-items:center;gap:8px;font-size:12px;padding:4px 0;border-bottom:1px solid var(--line)">
            <b style="flex:1"><%= p.name %></b>
            <span class="muted"><%= p.boardBasis==='ROOM_ONLY'?'Tanpa sarapan':(p.boardBasis==='BREAKFAST'?'Sarapan':p.boardBasis) %></span>
            <span class="pill <%= p.freeCancellation?'PAID':(p.refundable?'PARTNER':'CANCELLED') %>"><%= p.freeCancellation?'Bebas batal':(p.refundable?'Refundable':'Non-refund') %></span>
            <span style="min-width:80px;text-align:right;font-weight:700"><%= p.priceDelta>=0?'+':'' %><%= rupiah(p.priceDelta) %></span>
            <form method="post" action="/extranet/rate-plans/<%= p.id %>/delete" data-confirm="Hapus rate plan <%= p.name %>?"><button class="btn danger sm">×</button></form>
          </div>
        <% }) %>
        <form method="post" action="/extranet/rooms/<%= r.id %>/rate-plans" style="display:flex;gap:6px;align-items:end;flex-wrap:wrap;margin-top:8px">
          <div><label style="margin:0 0 3px;font-size:11px">Nama</label><input name="name" placeholder="Termasuk Sarapan" required style="max-width:150px"></div>
          <div><label style="margin:0 0 3px;font-size:11px">Board</label><select name="boardBasis" style="max-width:120px"><option value="ROOM_ONLY">Tanpa sarapan</option><option value="BREAKFAST">Sarapan</option><option value="HALF_BOARD">Half board</option><option value="FULL_BOARD">Full board</option></select></div>
          <div><label style="margin:0 0 3px;font-size:11px">Delta Rp/malam</label><input name="priceDelta" type="number" value="0" style="max-width:110px"></div>
          <label class="pr-check" style="margin:0 0 8px;font-size:11.5px"><input type="checkbox" name="refundable" checked> Refundable</label>
          <label class="pr-check" style="margin:0 0 8px;font-size:11.5px"><input type="checkbox" name="freeCancellation"> Bebas batal</label>
          <button class="btn sm" style="margin-bottom:2px">+ Rate Plan</button>
        </form>
      </div>
    </div>
  <% }) %>
  <% if (!hotel.rooms.length) { %><p class="empty">Belum ada kamar</p><% } %>
</div>

<% if (saved==='tipe') { %><div class="notice ok">Jenis properti tersimpan.</div><% } %>
<% if (saved==='sekitar') { %><div class="notice ok">Tempat sekitar tersimpan.</div><% } %>

<div class="card">
  <h2 style="margin:0 0 4px">Jenis Properti</h2>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/property-type" style="display:flex;gap:8px;align-items:end">
    <% var TYPES = {HOTEL:'Hotel',VILLA:'Villa',APARTMENT:'Apartemen',HOMESTAY:'Homestay',GUESTHOUSE:'Guesthouse',HOSTEL:'Hostel',RESORT:'Resort'}; %>
    <select name="propertyType" style="max-width:200px">
      <% Object.keys(TYPES).forEach(function(k){ %><option value="<%= k %>" <%= (hotel.propertyType||'HOTEL')===k?'selected':'' %>><%= TYPES[k] %></option><% }) %>
    </select>
    <button class="btn sm">Simpan</button>
  </form>
</div>

<div class="card">
  <h2 style="margin:0 0 4px">Yang Ada di Sekitar</h2>
  <p class="muted" style="margin-top:0;font-size:12px">Jarak ke bandara, stasiun, mall, wisata — tampil di halaman properti.</p>
  <% (hotel.nearby||[]).forEach(function(n){ %>
    <div style="display:flex;align-items:center;gap:10px;font-size:13px;padding:6px 0;border-bottom:1px solid var(--line)">
      <b style="flex:1"><%= n.name %></b>
      <span class="muted"><%= n.category %></span>
      <span style="min-width:70px;text-align:right;font-weight:700"><%= n.distanceKm %> km</span>
      <form method="post" action="/extranet/nearby/<%= n.id %>/delete" data-confirm="Hapus <%= n.name %>?"><button class="btn danger sm">×</button></form>
    </div>
  <% }) %>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/nearby" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-top:10px">
    <div><label style="margin:0 0 4px">Nama tempat</label><input name="name" placeholder="Bandara Soekarno-Hatta" required style="max-width:200px"></div>
    <div><label style="margin:0 0 4px">Kategori</label><select name="category" style="max-width:140px">
      <% ['AIRPORT','STATION','MALL','BEACH','ATTRACTION','HOSPITAL','RESTAURANT','LANDMARK'].forEach(function(c){ %><option><%= c %></option><% }) %>
    </select></div>
    <div><label style="margin:0 0 4px">Jarak (km)</label><input name="distanceKm" type="number" step="0.1" style="max-width:100px" required></div>
    <button class="btn sm" style="margin-bottom:2px">+ Tambah</button>
  </form>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <h2 style="margin:0">Kalender Rate & Ketersediaan</h2>
    <a class="btn sm" href="/extranet/hotels/<%= hotel.id %>/calendar">📅 Buka Kalender Allotment</a>
  </div>
  <p class="muted" style="margin-top:6px">Atur harga & jatah kamar (allotment) per rentang tanggal. Gunakan <b>Kalender Allotment</b> untuk tampilan tanggalan (klik &amp; seret memilih rentang), atau form cepat di bawah. Kosongkan harga/jatah jika tidak ingin mengubahnya.</p>
  <% hotel.rooms.forEach(function(r){ %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px">
      <b><%= r.name %></b>
      <form method="post" action="/extranet/rooms/<%= r.id %>/availability"
        style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-top:10px">
        <div><label style="margin:0 0 4px">Dari</label><input name="from" type="date" required style="max-width:160px"></div>
        <div><label style="margin:0 0 4px">Sampai</label><input name="to" type="date" required style="max-width:160px"></div>
        <div><label style="margin:0 0 4px">Harga/malam</label><input name="price" type="number" placeholder="<%= r.price %>" style="max-width:140px"></div>
        <div><label style="margin:0 0 4px">Jatah kamar</label><input name="allotment" type="number" placeholder="<%= r.stock %>" style="max-width:110px"></div>
        <div><label style="margin:0 0 4px">Status</label><select name="closed" style="max-width:130px"><option value="">— tetap —</option><option value="0">Buka</option><option value="1">Tutup</option></select></div>
        <button class="btn sm" style="margin-bottom:2px">Terapkan</button>
      </form>
    </div>
  <% }) %>
</div>

<a class="btn ghost" href="/extranet">← Kembali</a>

<%- include('../partials/bottom') %>
