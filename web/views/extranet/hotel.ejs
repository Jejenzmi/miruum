<%- include('../partials/top', { title: hotel.name, heading: hotel.name, section:'extranet', active:'dashboard', me }) %>

<%
  var PHOTO_CATS = [
    ['BUILDING','Gedung / Tampak Luar'], ['LOBBY','Lobby'], ['BEDROOM','Kamar Tidur'],
    ['BATHROOM','Kamar Mandi'], ['POOL','Kolam Renang'], ['RESTAURANT','Restoran'],
    ['AMENITIES','Amenities'], ['FACILITIES','Fasilitas'], ['VIEW','Pemandangan'], ['OTHER','Lainnya']
  ];
  var allPhotos = hotel.photos || [];
  var hotelPhotos = allPhotos.filter(function(p){ return !p.roomId; });
%>

<!-- ── Profil + ganti foto cover ── -->
<div class="card">
  <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
    <div style="position:relative">
      <img class="thumb" style="width:88px;height:88px" src="<%= hotel.imageUrl %>" alt="">
    </div>
    <div style="flex:1;min-width:180px">
      <h2 style="margin-bottom:2px"><%= hotel.name %></h2>
      <p class="muted" style="margin:0"><%= hotel.city %> · <%= '★'.repeat(hotel.starRating) %> · <%= hotel.rating %>/10</p>
    </div>
    <form method="post" action="/extranet/hotels/<%= hotel.id %>/cover" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center">
      <label class="btn ghost sm" style="cursor:pointer;margin:0">
        Ganti Foto Profil
        <input type="file" name="cover" accept="image/*" style="display:none" onchange="this.form.submit()">
      </label>
    </form>
  </div>
</div>

<% if (saved==='konten') { %><div class="notice ok">Konten properti tersimpan.</div><% } %>
<% if (saved==='fasilitas') { %><div class="notice ok">Fasilitas tersimpan.</div><% } %>
<% if (saved==='lokasi') { %><div class="notice ok">Lokasi &amp; wilayah tersimpan.</div><% } %>
<% if (saved==='cover') { %><div class="notice ok">Foto profil diperbarui.</div><% } %>
<% if (saved==='foto') { %><div class="notice ok">Foto berhasil diunggah.</div><% } %>
<% if (typeof err !== 'undefined' && err) { %><div class="notice bad"><%= err %></div><% } %>

<!-- ── Kalender Rate & Ketersediaan (paling atas — paling sering dipakai Front Office) ── -->
<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <h2 style="margin:0">📅 Kalender Rate &amp; Ketersediaan</h2>
    <a class="btn ghost sm" href="/extranet/hotels/<%= hotel.id %>/calendar">Buka layar penuh ↗</a>
  </div>
  <% if (cal && cal.rooms) { %>
    <%- include('../partials/rate_calendar', { cal: cal, hotelId: hotel.id }) %>
  <% } else { %>
    <p class="muted">Tambahkan kamar dulu agar kalender muncul.</p>
  <% } %>
</div>

<!-- ── Legalitas & Rekening (menu terpisah, akses terbatas) ── -->
<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <div>
      <h2 style="margin:0 0 2px">🔒 Legalitas &amp; Rekening</h2>
      <p class="muted" style="margin:0">Data legal &amp; rekening pencairan — <%= hotel.legalLockedAt ? 'sudah terkunci' : 'terkunci setelah diisi' %>. Hanya di menu terpisah.</p>
    </div>
    <a class="btn sm" href="/extranet/hotels/<%= hotel.id %>/legal"><%= hotel.legalLockedAt ? 'Lihat' : 'Isi Sekarang' %> →</a>
  </div>
</div>

<div class="card">
  <h2>Lokasi &amp; Wilayah</h2>
  <p class="muted" style="margin-top:-8px">Wilayah menentukan properti Anda muncul di pencarian area (provinsi, kota, kecamatan) pada aplikasi Miruum.</p>
  <% if (!hotel.regionId) { %>
    <div class="notice bad">Properti ini belum punya wilayah — tidak akan muncul di pencarian area. Mohon lengkapi.</div>
  <% } %>
  <form id="lokasiForm" method="post" action="/extranet/hotels/<%= hotel.id %>/location">
    <label>Kota</label>
    <input name="city" value="<%= hotel.city || '' %>" placeholder="mis. Bandung">
    <%- include('../partials/region_picker', { regionId: hotel.regionId || '', address: hotel.address || '' }) %>
    <div style="margin-top:14px"><button class="btn sm">Simpan Lokasi</button></div>
  </form>
</div>

<div class="card">
  <h2>Konten Properti</h2>
  <p class="muted" style="margin-top:-8px">Deskripsi & kebijakan yang tampil di halaman hotel pada aplikasi.</p>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/content">
    <label>Deskripsi Hotel</label>
    <textarea name="description" rows="4" style="width:100%;box-sizing:border-box"><%= hotel.description || '' %></textarea>
    <div class="row2">
      <div><label>Info Check-in</label><input name="checkInInfo" value="<%= hotel.checkInInfo || '' %>" placeholder="Dari jam 14.00"></div>
      <div><label>Info Check-out</label><input name="checkOutInfo" value="<%= hotel.checkOutInfo || '' %>" placeholder="Sebelum 12.00"></div>
    </div>
    <div style="margin-top:14px"><button class="btn sm">Simpan Konten</button></div>
  </form>
</div>

<div class="card">
  <h2>Fasilitas Hotel</h2>
  <p class="muted" style="margin-top:-8px">Pilih fasilitas yang tersedia — memengaruhi filter pencarian tamu.</p>
  <% var have = (hotel.facilities||[]).map(function(f){ return f.facilityId; }); %>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/facilities">
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <% (facilities||[]).forEach(function(f){ %>
        <label style="display:flex;align-items:center;gap:6px;margin:0;padding:7px 12px;border:1px solid var(--line);border-radius:10px">
          <input type="checkbox" name="facilityIds" value="<%= f.id %>" style="width:auto" <%= have.indexOf(f.id)>=0?'checked':'' %>> <%= f.name %>
        </label>
      <% }) %>
    </div>
    <div style="margin-top:14px"><button class="btn sm">Simpan Fasilitas</button></div>
  </form>
</div>

<!-- ── Foto Hotel (dipisah per kategori, upload banyak sekaligus) ── -->
<div class="card" id="foto">
  <h2>Foto Hotel</h2>
  <p class="muted" style="margin-top:-8px">Foto dipisah per kategori. Tiap kategori bisa unggah <b>banyak foto sekaligus</b>. Foto khusus kamar diatur di bagian <b>Kamar</b> (untuk mapping saat konek Channel Manager).</p>

  <% PHOTO_CATS.forEach(function(cat){ var catKey=cat[0], catLabel=cat[1]; var photos = hotelPhotos.filter(function(p){ return (p.category||'OTHER')===catKey; }); %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:12px">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px">
        <b><%= catLabel %> <span class="muted" style="font-weight:400">(<%= photos.length %>)</span></b>
        <form method="post" action="/extranet/hotels/<%= hotel.id %>/photos" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;margin:0">
          <input type="hidden" name="category" value="<%= catKey %>">
          <label class="btn sm" style="cursor:pointer;margin:0">
            + Unggah Foto
            <input type="file" name="photos" accept="image/*" multiple style="display:none" onchange="this.form.submit()">
          </label>
        </form>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <% photos.forEach(function(ph){ %>
          <div style="position:relative">
            <img src="<%= ph.url %>" style="width:104px;height:78px;object-fit:cover;border-radius:10px">
            <form method="post" action="/extranet/photos/<%= ph.id %>/delete" data-confirm="Hapus foto?" style="position:absolute;top:4px;right:4px;margin:0">
              <button class="btn danger sm" style="padding:2px 8px">×</button>
            </form>
          </div>
        <% }) %>
        <% if (!photos.length) { %><span class="muted" style="font-size:12px;align-self:center">Belum ada foto</span><% } %>
      </div>
    </div>
  <% }) %>
  <p class="muted" style="font-size:11px;margin-top:2px">Format JPG/PNG/WebP, maks 6MB/foto. Bisa pilih beberapa file sekaligus.</p>
</div>

<div class="card">
  <h2>Promo Hotel</h2>
  <p class="muted" style="margin-top:-8px">Tandai hotel sedang promo & tampilkan label di kartu hotel.</p>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/promo" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" name="isPromo" style="width:auto" <%= hotel.isPromo?'checked':'' %>> Aktifkan promo</label>
    <input name="promoLabel" value="<%= hotel.promoLabel || '' %>" placeholder="mis. Save up to 30%" style="max-width:260px">
    <button class="btn sm">Simpan</button>
  </form>
</div>

<!-- ── Kamar, Atribut, Rate Plan, Promo & Foto Kamar ── -->
<div class="card" id="kamar">
  <h2>Kamar, Atribut &amp; Promo</h2>
  <p class="muted" style="margin-top:-8px">Satu tempat untuk mengatur tiap tipe kamar: <b>harga &amp; stok</b>, <b>atribut</b> (kapasitas, refundable, sarapan), <b>rate plan</b> (beberapa tarif: Kamar Saja / Sarapan / Bebas Batal / Non-refund), <b>promo diskon %</b>, dan <b>foto kamar</b> (dipakai saat mapping kamar ke Channel Manager / API OTA).</p>
  <style>
    .rgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;align-items:end;margin-top:10px}
    .rgrid .fld{display:flex;flex-direction:column;min-width:0}
    .rgrid .fld label{margin:0 0 4px;font-size:12px;font-weight:600;color:var(--muted)}
    .rgrid .fld input,.rgrid .fld select{width:100%;box-sizing:border-box}
    .rgrid .fld.wide{grid-column:1/-1}
    .rchecks{display:flex;gap:18px;flex-wrap:wrap;margin:12px 0 0}
    .rchecks label{display:flex;align-items:center;gap:6px;margin:0;font-size:13px}
    .rchecks input{width:auto}
    .rform-actions{display:flex;justify-content:flex-end;margin-top:12px}
  </style>
  <% if (saved==='kamar') { %><div class="notice ok">Kamar tersimpan.</div><% } %>
  <% if (!hotel.rooms.length) { %>
    <div class="notice bad">⚠️ Properti ini <b>belum punya kamar</b> — sehingga <b>tidak muncul di aplikasi</b>. Tambahkan minimal 1 kamar dengan harga di form <b>"Tambah Kamar Baru"</b> di bawah.</div>
  <% } %>
  <% hotel.rooms.forEach(function(r){ var dealPct = (r.originalPrice && r.originalPrice>r.price) ? Math.round((1 - r.price/r.originalPrice)*100) : 0; var roomPhotos = (r.photos||[]); %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <b><%= r.name %></b>
        <div style="display:flex;align-items:center;gap:8px">
          <% if (dealPct>0) { %><span class="pill PAID">Promo -<%= dealPct %>% · <s style="opacity:.6"><%= rupiah(r.originalPrice) %></s> → <%= rupiah(r.price) %></span><% } %>
          <form method="post" action="/extranet/rooms/<%= r.id %>/delete" data-confirm="Hapus kamar <%= r.name %>? Tidak bisa jika sudah ada pesanan." style="margin:0">
            <input type="hidden" name="hotelId" value="<%= hotel.id %>">
            <button class="btn danger sm" title="Hapus kamar">Hapus</button>
          </form>
        </div>
      </div>
      <form method="post" action="/extranet/rooms/<%= r.id %>">
        <div class="rgrid">
          <div class="fld"><label>Konfigurasi tempat tidur</label><input name="bedInfo" value="<%= r.bedInfo || '' %>" placeholder="mis. 1 kasur King / 2 kasur Twin"></div>
          <div class="fld"><label>Harga/malam (Rp)</label><input name="price" type="number" min="1" value="<%= r.originalPrice && r.originalPrice>r.price ? r.originalPrice : r.price %>"></div>
          <div class="fld"><label>Stok kamar</label><input name="stock" type="number" min="0" value="<%= r.stock %>"></div>
          <div class="fld"><label>Kapasitas (tamu)</label><input name="capacity" type="number" min="1" value="<%= r.capacity %>"></div>
        </div>
        <div class="rchecks">
          <label><input type="checkbox" name="refundable" <%= r.refundable?'checked':'' %>> Refundable</label>
          <label><input type="checkbox" name="freeCancellation" <%= r.freeCancellation?'checked':'' %>> Gratis batal</label>
          <label><input type="checkbox" name="breakfast" <%= r.breakfast?'checked':'' %>> Termasuk sarapan</label>
        </div>
        <div class="rform-actions"><button class="btn sm">Simpan Kamar</button></div>
      </form>
      <form method="post" action="/extranet/rooms/<%= r.id %>/deal" style="display:flex;gap:8px;align-items:end;margin-top:8px;padding-top:10px;border-top:1px dashed var(--line)">
        <div><label style="margin:0 0 4px">Promo diskon (%)</label><input name="dealPct" type="number" min="0" max="90" value="<%= dealPct %>" style="max-width:110px" placeholder="0 = nonaktif"></div>
        <button class="btn ghost sm" style="margin-bottom:2px">Terapkan Promo</button>
      </form>

      <!-- Foto kamar (per-room, untuk mapping API) -->
      <div style="margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px">
          <b style="font-size:12.5px">Foto kamar ini <span class="muted" style="font-weight:400">(<%= roomPhotos.length %>)</span></b>
          <form method="post" action="/extranet/hotels/<%= hotel.id %>/photos" enctype="multipart/form-data" style="margin:0">
            <input type="hidden" name="category" value="BEDROOM">
            <input type="hidden" name="roomId" value="<%= r.id %>">
            <label class="btn ghost sm" style="cursor:pointer;margin:0">+ Foto Kamar
              <input type="file" name="photos" accept="image/*" multiple style="display:none" onchange="this.form.submit()">
            </label>
          </form>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <% roomPhotos.forEach(function(ph){ %>
            <div style="position:relative">
              <img src="<%= ph.url %>" style="width:92px;height:68px;object-fit:cover;border-radius:9px">
              <form method="post" action="/extranet/photos/<%= ph.id %>/delete" data-confirm="Hapus foto kamar?" style="position:absolute;top:3px;right:3px;margin:0">
                <button class="btn danger sm" style="padding:1px 7px">×</button>
              </form>
            </div>
          <% }) %>
          <% if (!roomPhotos.length) { %><span class="muted" style="font-size:11.5px;align-self:center">Belum ada foto kamar</span><% } %>
        </div>
      </div>

      <div style="margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)">
        <b style="font-size:12.5px">Rate plan</b>
        <p class="muted" style="font-size:11px;margin:2px 0 8px">Kamar sama dengan beberapa tarif (Kamar Saja / Sarapan / Bebas Batal / Non-refund). <b>Selisih harga</b> = <b>+/- Rp</b> dari harga kamar — <b>isi 0</b> untuk sama dengan harga kamar, <b>+50000</b> untuk lebih mahal, <b>-30000</b> untuk lebih murah. <b style="color:#c0392b">Jangan isi harga penuh di sini.</b></p>
        <% (r.ratePlans||[]).forEach(function(p){ %>
          <div style="display:flex;align-items:center;gap:8px;font-size:12px;padding:4px 0;border-bottom:1px solid var(--line)">
            <b style="flex:1"><%= p.name %></b>
            <span class="muted"><%= p.boardBasis==='ROOM_ONLY'?'Tanpa sarapan':(p.boardBasis==='BREAKFAST'?'Sarapan':p.boardBasis) %></span>
            <span class="pill <%= p.freeCancellation?'PAID':(p.refundable?'PARTNER':'CANCELLED') %>"><%= p.freeCancellation?'Bebas batal':(p.refundable?'Refundable':'Non-refund') %></span>
            <span style="min-width:80px;text-align:right;font-weight:700"><%= p.priceDelta>=0?'+':'' %><%= rupiah(p.priceDelta) %></span>
            <form method="post" action="/extranet/rate-plans/<%= p.id %>/delete" data-confirm="Hapus rate plan <%= p.name %>?"><button class="btn danger sm">×</button></form>
          </div>
        <% }) %>
        <form method="post" action="/extranet/rooms/<%= r.id %>/rate-plans" style="display:flex;gap:6px;align-items:end;flex-wrap:wrap;margin-top:8px" data-rp-form data-room-price="<%= r.originalPrice && r.originalPrice>r.price ? r.originalPrice : r.price %>">
          <div><label style="margin:0 0 3px;font-size:11px">Nama</label><input name="name" placeholder="Termasuk Sarapan" required style="max-width:150px"></div>
          <div><label style="margin:0 0 3px;font-size:11px">Board</label><select name="boardBasis" style="max-width:120px"><option value="ROOM_ONLY">Tanpa sarapan</option><option value="BREAKFAST">Sarapan</option><option value="HALF_BOARD">Half board</option><option value="FULL_BOARD">Full board</option></select></div>
          <div><label style="margin:0 0 3px;font-size:11px">Selisih harga (± Rp/malam)</label><input name="priceDelta" type="number" value="0" style="max-width:120px" data-rp-delta><div class="rp-preview muted" style="font-size:10.5px;margin-top:2px">= harga kamar</div></div>
          <label class="pr-check" style="margin:0 0 8px;font-size:11.5px"><input type="checkbox" name="refundable" checked> Refundable</label>
          <label class="pr-check" style="margin:0 0 8px;font-size:11.5px"><input type="checkbox" name="freeCancellation"> Bebas batal</label>
          <button class="btn sm" style="margin-bottom:2px">+ Rate Plan</button>
        </form>
      </div>
    </div>
  <% }) %>

  <!-- Tambah kamar baru — inilah yang membuat properti baru tampil di aplikasi -->
  <div style="border:2px dashed var(--brand,#f6883a);border-radius:14px;padding:14px;margin-top:6px">
    <b>+ Tambah Kamar Baru</b>
    <p class="muted" style="font-size:11.5px;margin:2px 0 0">Isi minimal <b>nama kamar</b> dan <b>harga/malam</b>. Setelah tersimpan, hotel langsung bisa dipesan &amp; muncul di aplikasi.</p>
    <form method="post" action="/extranet/hotels/<%= hotel.id %>/rooms">
      <div class="rgrid">
        <div class="fld"><label>Nama tipe kamar *</label><input name="name" placeholder="mis. Deluxe King" required></div>
        <div class="fld"><label>Konfigurasi tempat tidur</label><input name="bedInfo" placeholder="mis. 1 kasur King"></div>
        <div class="fld"><label>Harga/malam (Rp) *</label><input name="price" type="number" min="1" placeholder="500000" required></div>
        <div class="fld"><label>Stok kamar</label><input name="stock" type="number" min="0" value="5"></div>
        <div class="fld"><label>Kapasitas (tamu)</label><input name="capacity" type="number" min="1" value="2"></div>
      </div>
      <div class="rchecks">
        <label><input type="checkbox" name="refundable" checked> Refundable</label>
        <label><input type="checkbox" name="freeCancellation" checked> Gratis batal</label>
        <label><input type="checkbox" name="breakfast"> Termasuk sarapan</label>
      </div>
      <div class="rform-actions"><button class="btn">Tambah Kamar</button></div>
    </form>
  </div>
</div>

<% if (saved==='tipe') { %><div class="notice ok">Jenis properti tersimpan.</div><% } %>
<% if (saved==='sekitar') { %><div class="notice ok">Tempat sekitar tersimpan.</div><% } %>

<div class="card">
  <h2 style="margin:0 0 4px">Jenis Properti</h2>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/property-type" style="display:flex;gap:8px;align-items:end">
    <% var TYPES = {HOTEL:'Hotel',VILLA:'Villa',APARTMENT:'Apartemen',HOMESTAY:'Homestay',GUESTHOUSE:'Guesthouse',HOSTEL:'Hostel',RESORT:'Resort'}; %>
    <select name="propertyType" style="max-width:200px">
      <% Object.keys(TYPES).forEach(function(k){ %><option value="<%= k %>" <%= (hotel.propertyType||'HOTEL')===k?'selected':'' %>><%= TYPES[k] %></option><% }) %>
    </select>
    <button class="btn sm">Simpan</button>
  </form>
</div>

<div class="card">
  <h2 style="margin:0 0 4px">Yang Ada di Sekitar</h2>
  <p class="muted" style="margin-top:0;font-size:12px">Jarak ke bandara, stasiun, mall, wisata — tampil di halaman properti.</p>
  <% (hotel.nearby||[]).forEach(function(n){ %>
    <div style="display:flex;align-items:center;gap:10px;font-size:13px;padding:6px 0;border-bottom:1px solid var(--line)">
      <b style="flex:1"><%= n.name %></b>
      <span class="muted"><%= n.category %></span>
      <span style="min-width:70px;text-align:right;font-weight:700"><%= n.distanceKm %> km</span>
      <form method="post" action="/extranet/nearby/<%= n.id %>/delete" data-confirm="Hapus <%= n.name %>?"><button class="btn danger sm">×</button></form>
    </div>
  <% }) %>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/nearby" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-top:10px">
    <div><label style="margin:0 0 4px">Nama tempat</label><input name="name" placeholder="Bandara Soekarno-Hatta" required style="max-width:200px"></div>
    <div><label style="margin:0 0 4px">Kategori</label><select name="category" style="max-width:140px">
      <% ['AIRPORT','STATION','MALL','BEACH','ATTRACTION','HOSPITAL','RESTAURANT','LANDMARK'].forEach(function(c){ %><option><%= c %></option><% }) %>
    </select></div>
    <div><label style="margin:0 0 4px">Jarak (km)</label><input name="distanceKm" type="number" step="0.1" style="max-width:100px" required></div>
    <button class="btn sm" style="margin-bottom:2px">+ Tambah</button>
  </form>
</div>

<a class="btn ghost" href="/extranet">← Kembali</a>

<script>
(function(){
  var f=document.getElementById('lokasiForm');
  if(!f) return;
  f.addEventListener('submit', function(e){
    var rid=f.querySelector('.rp-id');
    if(rid && !rid.value){
      e.preventDefault();
      if(window.mToast) window.mToast('error','Wilayah wajib dipilih — properti tidak akan muncul di pencarian area.');
      var prov=f.querySelector('.rp-prov'); if(prov){ prov.focus(); prov.scrollIntoView({behavior:'smooth',block:'center'}); }
    }
  });
})();
// Rate-plan: live "harga akhir" preview + warn if the delta looks like a full price.
(function(){
  function rp(v){ return 'Rp ' + Number(v||0).toLocaleString('id-ID'); }
  document.querySelectorAll('[data-rp-form]').forEach(function(f){
    var base = Number(f.getAttribute('data-room-price'))||0;
    var input = f.querySelector('[data-rp-delta]');
    var prev = f.querySelector('.rp-preview');
    if(!input||!prev) return;
    function upd(){
      var d = Number(input.value)||0;
      var total = base + d;
      prev.textContent = 'Harga akhir: ' + rp(total);
      if (d >= base && base > 0) { prev.style.color = '#c0392b'; prev.textContent += ' — cek: ini terlihat seperti harga penuh, bukan selisih?'; }
      else { prev.style.color = ''; }
    }
    input.addEventListener('input', upd); upd();
  });
})();
</script>

