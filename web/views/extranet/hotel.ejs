<%- include('../partials/top', { title: hotel.name, heading: hotel.name, section:'extranet', active:'dashboard', me }) %>

<div class="card">
  <div style="display:flex;gap:16px;align-items:center">
    <img class="thumb" style="width:80px;height:80px" src="<%= hotel.imageUrl %>" alt="">
    <div>
      <h2 style="margin-bottom:2px"><%= hotel.name %></h2>
      <p class="muted" style="margin:0"><%= hotel.city %> · <%= '★'.repeat(hotel.starRating) %> · <%= hotel.rating %>/10</p>
    </div>
  </div>
</div>

<div class="card">
  <h2>🖼️ Foto Hotel</h2>
  <p class="muted" style="margin-top:-8px">Kelola galeri foto yang tampil di aplikasi.</p>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px">
    <% (hotel.photos||[]).forEach(function(ph){ %>
      <div style="position:relative">
        <img src="<%= ph.url %>" style="width:110px;height:80px;object-fit:cover;border-radius:12px">
        <form method="post" action="/extranet/photos/<%= ph.id %>/delete" onsubmit="return confirm('Hapus foto?')" style="position:absolute;top:4px;right:4px">
          <button class="btn danger sm" style="padding:2px 8px">✕</button>
        </form>
      </div>
    <% }) %>
    <% if (!(hotel.photos||[]).length) { %><span class="muted">Belum ada foto</span><% } %>
  </div>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/photos" style="display:flex;gap:8px;max-width:520px">
    <input name="url" placeholder="URL gambar (https://...)" required>
    <button class="btn sm">➕ Tambah Foto</button>
  </form>
</div>

<div class="card">
  <h2>🏷️ Promo Hotel</h2>
  <p class="muted" style="margin-top:-8px">Tandai hotel sedang promo & tampilkan label di kartu hotel.</p>
  <form method="post" action="/extranet/hotels/<%= hotel.id %>/promo" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <label style="display:flex;align-items:center;gap:6px;margin:0"><input type="checkbox" name="isPromo" style="width:auto" <%= hotel.isPromo?'checked':'' %>> Aktifkan promo</label>
    <input name="promoLabel" value="<%= hotel.promoLabel || '' %>" placeholder="mis. Save up to 30%" style="max-width:260px">
    <button class="btn sm">Simpan</button>
  </form>
</div>

<div class="card">
  <h2>Kamar & Ketersediaan</h2>
  <p class="muted" style="margin-top:-8px">Ubah harga & stok kamar Anda.</p>
  <table>
    <thead><tr><th>Kamar</th><th>Tipe</th><th>Atur Harga & Stok</th></tr></thead>
    <tbody>
      <% hotel.rooms.forEach(function(r){ %>
        <tr>
          <td><b><%= r.name %></b><br><span class="muted" style="font-size:11px"><%= r.bedInfo %></span></td>
          <td><%= r.refundable ? 'Refundable' : 'Non-refundable' %><%= r.breakfast ? ' · Sarapan' : '' %></td>
          <td>
            <form method="post" action="/extranet/rooms/<%= r.id %>" style="display:flex;gap:8px;align-items:center">
              <input name="price" type="number" value="<%= r.price %>" style="max-width:140px" title="Harga/malam">
              <input name="stock" type="number" value="<%= r.stock %>" style="max-width:80px" title="Stok">
              <button class="btn sm">Simpan</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!hotel.rooms.length) { %><tr><td colspan="5" class="empty">Belum ada kamar</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>🗓️ Kalender Rate & Ketersediaan</h2>
  <p class="muted" style="margin-top:-8px">Atur harga & jatah kamar (allotment) per rentang tanggal. Kosongkan harga/jatah jika tidak ingin mengubahnya.</p>
  <% hotel.rooms.forEach(function(r){ %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px">
      <b><%= r.name %></b>
      <form method="post" action="/extranet/rooms/<%= r.id %>/availability"
        style="display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-top:10px">
        <div><label style="margin:0 0 4px">Dari</label><input name="from" type="date" required style="max-width:160px"></div>
        <div><label style="margin:0 0 4px">Sampai</label><input name="to" type="date" required style="max-width:160px"></div>
        <div><label style="margin:0 0 4px">Harga/malam</label><input name="price" type="number" placeholder="<%= r.price %>" style="max-width:140px"></div>
        <div><label style="margin:0 0 4px">Jatah kamar</label><input name="allotment" type="number" placeholder="<%= r.stock %>" style="max-width:110px"></div>
        <label style="display:flex;align-items:center;gap:6px;margin:0 0 10px;font-size:12.5px">
          <input type="checkbox" name="closed" style="width:auto"> Tutup penjualan
        </label>
        <button class="btn sm" style="margin-bottom:2px">Terapkan</button>
      </form>
    </div>
  <% }) %>
</div>

<a class="btn ghost" href="/extranet">← Kembali</a>

<%- include('../partials/bottom') %>
