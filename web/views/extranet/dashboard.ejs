<%- include('../partials/top', { title:'Ringkasan', heading:'Ringkasan Mitra', section:'extranet', active:'dashboard', me }) %>

<div class="welcome-hero">
  <span class="wblob w1"></span><span class="wblob w2"></span>
  <div class="wh-txt">
    <div class="eyebrow" style="color:rgba(255,255,255,.85)">Extranet Mitra</div>
    <h2>Halo, <%= me.name %></h2>
    <p>Kelola kamar, harga & ketersediaan, foto, dan promo hotel Anda — perubahan langsung tayang di aplikasi Miruum.</p>
  </div>
  <div class="wh-actions">
    <a href="/extranet/bookings" class="wh-chip">Pesanan Masuk</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="icon" style="background:var(--green-s);color:var(--green-d)"><svg class="ci"><use href="#i-hotel"/></svg></div>
    <div class="label">Hotel Anda</div><div class="value"><%= overview.hotels.length %></div>
  </div>
  <div class="stat">
    <div class="icon" style="background:#E5EEFF;color:#2563EB"><svg class="ci"><use href="#i-bookings"/></svg></div>
    <div class="label">Total Pesanan</div><div class="value"><%= overview.totalBookings %></div>
  </div>
  <div class="stat">
    <div class="icon" style="background:var(--orange-s);color:#b8791a"><svg class="ci"><use href="#i-finance"/></svg></div>
    <div class="label">Pendapatan</div><div class="value" style="font-size:20px"><%= rupiah(overview.revenue) %></div>
  </div>
</div>

<div class="value-strip">
  <div class="vs-item"><div class="vs-ic"><svg class="ci"><use href="#i-channels"/></svg></div><div><b>Channel Manager</b><span>Satu titik kelola rate & stok ke banyak OTA — tanpa double-booking.</span></div></div>
  <div class="vs-item"><div class="vs-ic"><svg class="ci"><use href="#i-rates"/></svg></div><div><b>Kendali Harga & Stok</b><span>Atur tarif, allotment & restriksi per tanggal langsung dari Extranet.</span></div></div>
  <div class="vs-item"><div class="vs-ic"><svg class="ci"><use href="#i-trend"/></svg></div><div><b>Tingkatkan Okupansi</b><span>Foto, promo & harga terbaik tampil instan di aplikasi Miruum.</span></div></div>
</div>

<div class="card">
  <h2>Hotel yang Anda Kelola</h2>
  <table>
    <thead><tr><th></th><th>Nama</th><th>Kota</th><th>Kamar</th><th>Pesanan</th><th>Aksi</th></tr></thead>
    <tbody>
      <% overview.hotels.forEach(function(h){ %>
        <tr>
          <td><img class="thumb" src="<%= h.imageUrl %>" alt=""></td>
          <td><b><%= h.name %></b></td>
          <td><%= h.city %></td>
          <td><%= h._count.rooms %></td>
          <td><%= h._count.bookings %></td>
          <td><a class="btn ghost sm" href="/extranet/hotels/<%= h.id %>">Kelola Kamar</a></td>
        </tr>
      <% }) %>
      <% if (!overview.hotels.length) { %><tr><td colspan="6" class="empty">Belum ada hotel terhubung ke akun Anda</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
