<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Daftarkan Properti — Miruum</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="auth">
  <div class="auth-form-wrap">
    <div class="auth-card" style="max-width:520px">
      <img src="/static/logo.png" alt="Miruum" class="auth-logo">
      <span class="eyebrow">Extranet Mitra</span>
      <h2>Daftarkan Properti Anda</h2>
      <p class="lead">Jangkau jutaan tamu di aplikasi & web Miruum. Isi data properti — tim kami meninjau lalu mengirim akun Extranet Anda.</p>

      <% if (done) { %>
        <div class="notice ok" style="text-align:left">Pengajuan terkirim! Tim Miruum akan meninjau &amp; menghubungi Anda via email. Setelah disetujui, Anda menerima akun Extranet untuk mengelola properti.</div>
        <p style="text-align:center;margin-top:16px"><a href="/extranet/login" style="color:var(--primary-d);font-weight:700">← Kembali ke Login</a></p>
      <% } else { %>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form method="post" action="/extranet/register">
          <div class="row2">
            <div><label style="margin-top:0">Nama Properti *</label><input name="propertyName" placeholder="mis. Hotel Nusantara" required></div>
            <div><label style="margin-top:0">Tipe *</label>
              <select name="propertyType">
                <option value="HOTEL">Hotel</option><option value="VILLA">Villa</option><option value="APARTMENT">Apartemen</option>
                <option value="HOMESTAY">Homestay</option><option value="GUESTHOUSE">Guest House</option><option value="HOSTEL">Hostel</option><option value="RESORT">Resort</option>
              </select>
            </div>
          </div>
          <div class="row2">
            <div><label>Kota *</label><input name="city" placeholder="mis. Bandung" required></div>
            <div><label>Jumlah Kamar</label><input name="roomCount" type="number" min="1" placeholder="mis. 40"></div>
          </div>
          <div class="row2">
            <div><label>Kelas Bintang</label>
              <select name="starRating">
                <option value="">— pilih —</option>
                <option value="1">1 Bintang</option><option value="2">2 Bintang</option><option value="3">3 Bintang</option>
                <option value="4">4 Bintang</option><option value="5">5 Bintang</option>
              </select>
            </div>
            <div><label>Kebijakan Pembatalan</label>
              <select name="cancellationPolicy">
                <option value="">— pilih —</option>
                <option value="FLEXIBLE">Fleksibel (refund penuh sebelum batas)</option>
                <option value="MODERATE">Moderat (refund sebagian)</option>
                <option value="STRICT">Ketat</option>
                <option value="NON_REFUNDABLE">Non-refundable</option>
              </select>
            </div>
          </div>

          <div class="nav-label" style="margin-top:16px">Lokasi (wilayah terstruktur) *</div>
          <p class="muted" style="font-size:11px;margin:0 0 8px">Pilih sampai tingkat terdalam agar properti muncul akurat di pencarian area.</p>
          <%- include('../partials/region_picker') %>

          <div class="row2" style="margin-top:8px">
            <div><label>Nama PIC *</label><input name="picName" placeholder="Nama penanggung jawab" required></div>
            <div><label>No. HP / WA *</label><input name="phone" placeholder="08xxxx" required></div>
          </div>
          <div class="row2">
            <div><label>Email *</label><input name="email" type="email" placeholder="email@properti.com" required></div>
            <div><label>Website (opsional)</label><input name="website" placeholder="https://…"></div>
          </div>

          <div class="nav-label" style="margin-top:16px">Legalitas & Pajak</div>
          <div class="row2">
            <div><label>Nama Badan Hukum</label><input name="legalName" placeholder="mis. PT Nusantara Jaya"></div>
            <div><label>NIB / SIUP</label><input name="businessRegNo" placeholder="Nomor Induk Berusaha"></div>
          </div>
          <label>NPWP</label>
          <input name="taxId" placeholder="00.000.000.0-000.000">

          <div class="nav-label" style="margin-top:16px">Rekening Pencairan (Payout)</div>
          <div class="row2">
            <div><label>Bank</label><input name="bankName" placeholder="mis. BCA"></div>
            <div><label>No. Rekening</label><input name="bankAccount" placeholder="No. rekening" inputmode="numeric"></div>
          </div>
          <label>Nama Pemilik Rekening</label>
          <input name="bankHolder" placeholder="Sesuai buku tabungan">

          <label style="margin-top:16px">Catatan / Deskripsi Singkat (opsional)</label>
          <textarea name="note" rows="2" placeholder="Ceritakan singkat tentang properti Anda"></textarea>
          <button class="btn" style="width:100%;justify-content:center;margin-top:16px">Kirim Pengajuan</button>
        </form>
        <p style="text-align:center;margin:16px 0 0;font-size:14px;color:var(--muted)">Sudah punya akun? <a href="/extranet/login" style="color:var(--primary-d);font-weight:700">Masuk di sini</a></p>
      <% } %>
      <div class="auth-foot">© 2026 Miruum · Extranet Mitra. All rights reserved.</div>
    </div>
  </div>
  <%- include('../partials/auth_brand', { variant: 'mitra' }) %>
</div>
<%- include('../partials/req_marker') %>
</body>
</html>
