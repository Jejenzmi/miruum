<%- include('../partials/top', { title:'Ulasan Tamu', heading:'Ulasan Tamu', section:'extranet', active:'reviews', me }) %>

<% if (saved==='1') { %><div class="notice ok">Balasan tersimpan.</div><% } %>

<p class="muted" style="margin:-4px 0 16px">Balas ulasan tamu untuk membangun kepercayaan calon tamu. Balasan tampil di aplikasi.</p>

<% var pending = (reviews||[]).filter(function(r){ return !r.reply; }).length; %>
<% if (pending) { %><div class="card" style="background:#FFF6E9;border-color:#F3D9A9;margin-bottom:14px"><b><%= pending %></b> ulasan belum dibalas.</div><% } %>

<% (reviews||[]).forEach(function(r){ %>
  <div class="card" style="margin-bottom:14px">
    <div style="display:flex;justify-content:space-between;align-items:start;gap:10px;flex-wrap:wrap">
      <div>
        <b><%= r.authorName || 'Tamu' %></b>
        <span class="pill PAID" style="margin-left:6px">★ <%= r.rating %>/10</span>
        <span class="muted" style="font-size:12px;margin-left:6px"><%= r.hotel ? r.hotel.name : '' %></span>
      </div>
      <span class="muted" style="font-size:11.5px"><%= new Date(r.createdAt).toLocaleDateString('id-ID') %></span>
    </div>
    <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5"><%= r.body %></p>

    <% if (r.reply) { %>
      <div style="margin-top:12px;padding:12px 14px;background:#f6f7f9;border-radius:12px;border-left:3px solid var(--brand)">
        <div style="font-size:11px;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Balasan Anda</div>
        <div style="font-size:13px;line-height:1.5"><%= r.reply %></div>
      </div>
    <% } else { %>
      <form method="post" action="/extranet/reviews/<%= r.id %>/reply" style="margin-top:12px;display:flex;gap:8px;align-items:end;flex-wrap:wrap">
        <div style="flex:1;min-width:240px"><textarea name="reply" rows="2" placeholder="Tulis balasan yang sopan & membantu…" required style="width:100%;box-sizing:border-box"></textarea></div>
        <button class="btn">Kirim Balasan</button>
      </form>
    <% } %>
  </div>
<% }) %>
<% if (!(reviews||[]).length) { %><div class="card"><div class="empty">Belum ada ulasan untuk hotel Anda.</div></div><% } %>

<%- include('../partials/bottom') %>
