<%- include('../partials/top', { title:'Tanya Jawab', heading:'Tanya Jawab Tamu', section:'extranet', active:'questions', me }) %>

<% if (saved==='1') { %><div class="notice ok">Jawaban tersimpan.</div><% } %>

<div class="card">
  <p class="muted" style="margin-top:0">Pertanyaan publik dari tamu tentang properti Anda. Jawaban tampil untuk semua calon tamu di aplikasi.</p>
  <% (questions||[]).forEach(function(q){ %>
    <div style="border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <b><%= q.hotel ? q.hotel.name : '' %></b>
        <span class="muted" style="font-size:11.5px"><%= q.authorName %> · <%= new Date(q.createdAt).toLocaleDateString('id-ID') %></span>
      </div>
      <p style="margin:8px 0 6px;font-weight:600">T: <%= q.body %></p>
      <% if (q.answer) { %>
        <div style="background:var(--brand,#f6883a)14;padding:10px;border-radius:10px;font-size:13px"><b>Jawaban Anda:</b> <%= q.answer %></div>
      <% } %>
      <form method="post" action="/extranet/questions/<%= q.id %>/answer" style="display:flex;gap:8px;align-items:end;margin-top:10px">
        <div style="flex:1"><label style="margin:0 0 4px"><%= q.answer ? 'Perbarui jawaban' : 'Tulis jawaban' %></label>
          <textarea name="answer" rows="2" required style="width:100%;box-sizing:border-box"><%= q.answer || '' %></textarea></div>
        <button class="btn sm" style="margin-bottom:2px"><%= q.answer ? 'Perbarui' : 'Jawab' %></button>
      </form>
    </div>
  <% }) %>
  <% if (!(questions||[]).length) { %><p class="empty">Belum ada pertanyaan dari tamu.</p><% } %>
</div>

<%- include('../partials/bottom') %>
