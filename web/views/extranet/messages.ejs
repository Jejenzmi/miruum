<%- include('../partials/top', { title:'Pesan Tamu', heading:'Pesan Tamu', section:'extranet', active:'messages', me }) %>

<div class="grid-2" style="align-items:start">
  <!-- Inbox -->
  <div class="card">
    <h2 style="margin-top:0">Kotak Masuk</h2>
    <% if (!(threads||[]).length) { %><div class="empty">Belum ada percakapan tamu.</div><% } %>
    <% (threads||[]).forEach(function(t){ %>
      <a href="/extranet/messages?t=<%= t.id %>" style="display:block;text-decoration:none;color:inherit">
        <div style="padding:12px;border-radius:12px;margin-bottom:8px;border:1px solid <%= (thread && thread.id===t.id) ? 'var(--brand)' : 'var(--line)' %>;background:<%= (thread && thread.id===t.id) ? '#FFF7EE' : '#fff' %>">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <b><%= t.guest %></b>
            <% if (t.unread>0) { %><span class="pill CANCELLED"><%= t.unread %> baru</span><% } %>
          </div>
          <div class="muted" style="font-size:12px"><%= t.hotel %></div>
          <div class="muted" style="font-size:12.5px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= t.last %></div>
        </div>
      </a>
    <% }) %>
  </div>

  <!-- Conversation -->
  <div class="card">
    <% if (!thread) { %>
      <div class="empty">Pilih percakapan untuk membalas.</div>
    <% } else { %>
      <h2 style="margin-top:0"><%= thread.guest %> <span class="muted" style="font-size:12px">· <%= thread.hotel %></span></h2>
      <div style="max-height:420px;overflow-y:auto;padding:6px 2px;margin-bottom:12px">
        <% (messages||[]).forEach(function(m){ var guest=m.fromGuest; %>
          <% if (m.flagged) { %>
            <div style="margin:8px auto;max-width:92%;background:#fdeded;border:1px solid #e7a6a6;border-radius:12px;padding:9px 12px;font-size:12px;color:#8a4b45;line-height:1.4">
              <b style="color:#c0392b">⚠️ Pelanggaran kebijakan (<%= guest ? 'Tamu' : 'Hotel/Anda' %>)</b><br>
              <%= m.body %>
            </div>
          <% } else { %>
            <div style="display:flex;justify-content:<%= guest?'flex-start':'flex-end' %>;margin-bottom:8px">
              <div style="max-width:78%;padding:9px 13px;border-radius:14px;font-size:13px;line-height:1.4;<%= guest ? 'background:#f1f2f4;color:#222' : 'background:var(--brand);color:#fff' %>">
                <%= m.body %>
              </div>
            </div>
          <% } %>
        <% }) %>
        <% if (!(messages||[]).length) { %><div class="muted" style="font-size:13px">Belum ada pesan.</div><% } %>
      </div>
      <form method="post" action="/extranet/messages/<%= thread.id %>/reply" style="display:flex;gap:8px;align-items:end">
        <textarea name="reply" rows="2" placeholder="Tulis balasan…" required style="flex:1;box-sizing:border-box"></textarea>
        <button class="btn">Kirim</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/bottom') %>
