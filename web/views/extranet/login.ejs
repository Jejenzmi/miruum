<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Extranet Mitra — Miruum</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="auth">
  <div class="auth-form-wrap">
    <div class="auth-card">
      <% var pp = (typeof portal !== 'undefined' && portal) ? portal : 'extranet';
         var _eb = pp==='cm' ? 'Channel Manager' : pp==='pms' ? 'Property Management System' : 'Extranet Mitra';
         var _h2 = pp==='cm' ? 'Distribusi ke Semua OTA' : pp==='pms' ? 'Front Office Hotel Anda' : 'Halo, Mitra Miruum';
         var _ld = pp==='cm' ? 'Masuk untuk mendistribusikan inventaris & harga hotel Anda host-to-host ke seluruh OTA rekanan Miruum.'
                 : pp==='pms' ? 'Masuk untuk mengelola check-in, check-out, housekeeping & operasional harian hotel.'
                 : 'Masuk untuk mengelola kamar, harga, foto, promo, dan pesanan hotel Anda.'; %>
      <img src="/static/logo.png" alt="Miruum" class="auth-logo">
      <span class="eyebrow"><%= _eb %></span>
      <h2><%= _h2 %></h2>
      <p class="lead"><%= _ld %></p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="post" action="/extranet/login">
        <div class="ffield">
          <input id="email" name="email" type="email" placeholder="alamat@email.com" value="partner@panji.id" required>
          <label for="email">Email</label>
        </div>
        <div class="ffield">
          <input id="pass" name="password" type="password" placeholder="8+ karakter" value="partner123" required>
          <label for="pass">Kata Sandi</label>
          <button type="button" class="toggle-pw" aria-label="Tampilkan sandi" onclick="var p=document.getElementById('pass');p.type=p.type==='password'?'text':'password';">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <label class="remember"><input type="checkbox" name="remember" checked> Ingat saya</label>
        <button class="btn" style="width:100%;justify-content:center">Masuk ke Extranet</button>
      </form>
      <p style="text-align:center;margin:16px 0 0;font-size:14px;color:var(--muted)">Punya hotel/properti? <a href="/extranet/register" style="color:var(--primary-d);font-weight:700">Daftarkan Properti Anda →</a></p>
      <div class="auth-foot">© 2026 Miruum · Extranet Mitra. All rights reserved.</div>
    </div>
  </div>
  <%- include('../partials/auth_brand', { variant: 'mitra' }) %>
</div>
<%- include('../partials/req_marker') %>
</body>
</html>
