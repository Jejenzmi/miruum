<!-- Global form UX: red asterisk on every mandatory (required) field + scroll/
     highlight the first empty required field on a blocked submit. Included by
     bottom.ejs (all app pages) and by the standalone auth pages. -->
<style>
  .req-star{color:#E5484D;font-weight:700;margin-left:1px}
  .field-touched:invalid{border-color:#E5484D !important;box-shadow:0 0 0 2px rgba(229,72,77,.12) !important}
</style>
<script>
(function(){
  function labelFor(el){
    if(el.labels && el.labels.length) return el.labels[0];
    var p=el.previousElementSibling;
    while(p){ if(p.tagName==='LABEL') return p; p=p.previousElementSibling; }
    var box=el.closest('div,td,th,li,fieldset,label');
    if(box){ var l=box.querySelector('label'); if(l && l!==el) return l; }
    return null;
  }
  function mark(){
    document.querySelectorAll('input[required],select[required],textarea[required]').forEach(function(el){
      if(el.dataset.reqMarked) return; el.dataset.reqMarked='1';
      var lab=labelFor(el);
      if(lab && !lab.querySelector('.req-star')){
        var s=document.createElement('span'); s.className='req-star'; s.textContent=' *'; s.title='Wajib diisi'; lab.appendChild(s);
      }
    });
  }
  mark();
  try{ new MutationObserver(mark).observe(document.body,{childList:true,subtree:true}); }catch(e){}
  document.addEventListener('invalid', function(e){
    var el=e.target; if(!el) return;
    el.classList.add('field-touched');
    if(el.scrollIntoView) el.scrollIntoView({behavior:'smooth',block:'center'});
    try{ el.focus({preventScroll:true}); }catch(_){ }
  }, true);
})();
</script>
