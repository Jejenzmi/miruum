<%- include('../partials/top', { title:'Konten Web', heading:'Konten Web (miruum.id)', section:'admin', active:'site-content', me }) %>

<% if (saved==='1') { %><div class="notice ok">Konten web tersimpan. Perubahan langsung tampil di miruum.id.</div><% } %>
<% if (saved==='err') { %><div class="notice bad">Gagal menyimpan. Coba lagi.</div><% } %>

<p class="muted" style="margin:-4px 0 18px">Semua teks pemasaran di situs pelanggan <b>miruum.id</b> & halaman <b>/mitra</b> diatur di sini — tidak hardcode. Bagian berupa <b>daftar</b> (fitur, benefit, testimoni, FAQ, dll) memakai <b>form isian biasa</b> — klik <b>“+ Tambah”</b> untuk menambah baris, tombol <b>×</b> untuk menghapus.</p>

<p class="muted" style="margin:-8px 0 18px">Situs pelanggan kini <b>dwibahasa</b>. Setiap teks punya dua kotak: <b>Indonesia</b> & <b>English</b>. Bila kotak English dikosongkan, situs memakai teks Indonesia sebagai cadangan.</p>

<%
  function j(v){ return JSON.stringify(v, null, 2); }
  // Site-content values may be a legacy plain string (dipakai untuk kedua bahasa)
  // atau objek { id, en }. Baca dengan aman ke dalam kotak per-bahasa.
  function L(v, lang){ return v && typeof v === 'object' ? (v[lang] || '') : (lang === 'id' ? (v || '') : ''); }
%>

<form method="post" action="/admin/site-content">
  <div class="card">
    <h2>Beranda</h2>
    <label style="margin-top:0">Headline (fallback bila tak ada banner)</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><input name="homeHeadline[id]" value="<%= L(content.homeHeadline,'id') %>"></div>
      <div><label class="lang" style="margin-top:0">English</label><input name="homeHeadline[en]" value="<%= L(content.homeHeadline,'en') %>"></div>
    </div>
    <label>Sub-headline</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><input name="homeSub[id]" value="<%= L(content.homeSub,'id') %>"></div>
      <div><label class="lang" style="margin-top:0">English</label><input name="homeSub[en]" value="<%= L(content.homeSub,'en') %>"></div>
    </div>
    <label>Fitur / Keunggulan</label>
    <%- include('../partials/list_editor', { key:'features', items:content.features, fields:[{name:'t',label:'Judul'},{name:'d',label:'Deskripsi',wide:true}], addLabel:'Tambah fitur' }) %>
  </div>

  <div class="card">
    <h2>Teks Kepercayaan & Jaminan</h2>
    <p class="muted" style="margin-top:-8px">Dipakai di strip atas beranda, blok metode pembayaran, dan halaman pemesanan.</p>

    <label style="margin-top:0">Strip Kepercayaan (baris teks di bawah pencarian)</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="trustStrip[id]" rows="2"><%= L(content.trustStrip,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="trustStrip[en]" rows="2"><%= L(content.trustStrip,'en') %></textarea></div>
    </div>

    <div class="row2">
      <div>
        <label>Jaminan — Pembayaran Aman</label>
        <label class="lang">Indonesia</label><input name="trustSecure[id]" value="<%= L(content.trustSecure,'id') %>">
        <label class="lang">English</label><input name="trustSecure[en]" value="<%= L(content.trustSecure,'en') %>">
      </div>
      <div>
        <label>Jaminan — Konfirmasi Instan</label>
        <label class="lang">Indonesia</label><input name="trustInstant[id]" value="<%= L(content.trustInstant,'id') %>">
        <label class="lang">English</label><input name="trustInstant[en]" value="<%= L(content.trustInstant,'en') %>">
      </div>
    </div>

    <div class="row2">
      <div>
        <label>Jaminan — Dukungan</label>
        <label class="lang">Indonesia</label><input name="trustSupport[id]" value="<%= L(content.trustSupport,'id') %>">
        <label class="lang">English</label><input name="trustSupport[en]" value="<%= L(content.trustSupport,'en') %>">
      </div>
      <div>
        <label>Judul Blok Metode Pembayaran</label>
        <label class="lang">Indonesia</label><input name="paymentMethodsTitle[id]" value="<%= L(content.paymentMethodsTitle,'id') %>">
        <label class="lang">English</label><input name="paymentMethodsTitle[en]" value="<%= L(content.paymentMethodsTitle,'en') %>">
      </div>
    </div>

    <label>Catatan Keamanan Pembayaran</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="paySecureNote[id]" rows="2"><%= L(content.paySecureNote,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="paySecureNote[en]" rows="2"><%= L(content.paySecureNote,'en') %></textarea></div>
    </div>

    <label>Catatan Konfirmasi Instan</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="payInstantNote[id]" rows="2"><%= L(content.payInstantNote,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="payInstantNote[en]" rows="2"><%= L(content.payInstantNote,'en') %></textarea></div>
    </div>

    <div class="row2">
      <div>
        <label>Judul Destinasi Populer</label>
        <label>Aplikasi Mobile — URL tombol unduh (Google Play)</label>
        <input name="appStoreUrl" value="<%= typeof content.appStoreUrl === 'string' ? content.appStoreUrl : '' %>" placeholder="https://play.google.com/store/apps/details?id=id.gokar.miruum">
        <label>Aplikasi Mobile — teks tombol</label>
        <label class="lang">Indonesia</label><input name="appStoreLabel[id]" value="<%= L(content.appStoreLabel,'id') %>">
        <label class="lang">English</label><input name="appStoreLabel[en]" value="<%= L(content.appStoreLabel,'en') %>">

        <label class="lang">Indonesia</label><input name="destinationsTitle[id]" value="<%= L(content.destinationsTitle,'id') %>">
        <label class="lang">English</label><input name="destinationsTitle[en]" value="<%= L(content.destinationsTitle,'en') %>">
      </div>
      <div>
        <label>Judul Bukti Sosial / Ulasan</label>
        <label class="lang">Indonesia</label><input name="socialTitle[id]" value="<%= L(content.socialTitle,'id') %>">
        <label class="lang">English</label><input name="socialTitle[en]" value="<%= L(content.socialTitle,'en') %>">
      </div>
    </div>

    <label>Sub-teks Bukti Sosial / Ulasan</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="socialSub[id]" rows="2"><%= L(content.socialSub,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="socialSub[en]" rows="2"><%= L(content.socialSub,'en') %></textarea></div>
    </div>
  </div>

  <div class="card">
    <h2>Ajakan (CTA) Bisnis</h2>
    <div class="row2">
      <div>
        <label style="margin-top:0">Judul CTA Properti</label>
        <label class="lang">Indonesia</label><input name="ctaPropertyTitle[id]" value="<%= L(content.ctaPropertyTitle,'id') %>">
        <label class="lang">English</label><input name="ctaPropertyTitle[en]" value="<%= L(content.ctaPropertyTitle,'en') %>">
      </div>
      <div>
        <label style="margin-top:0">Judul CTA Corporate/Gov</label>
        <label class="lang">Indonesia</label><input name="ctaCorpTitle[id]" value="<%= L(content.ctaCorpTitle,'id') %>">
        <label class="lang">English</label><input name="ctaCorpTitle[en]" value="<%= L(content.ctaCorpTitle,'en') %>">
      </div>
    </div>
    <label>Teks CTA Properti</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="ctaPropertyText[id]" rows="2"><%= L(content.ctaPropertyText,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="ctaPropertyText[en]" rows="2"><%= L(content.ctaPropertyText,'en') %></textarea></div>
    </div>
    <label>Teks CTA Corporate/Gov</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="ctaCorpText[id]" rows="2"><%= L(content.ctaCorpText,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="ctaCorpText[en]" rows="2"><%= L(content.ctaCorpText,'en') %></textarea></div>
    </div>
  </div>

  <div class="card">
    <h2>Halaman Mitra (/mitra)</h2>
    <label style="margin-top:0">Headline</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><input name="mitraHeadline[id]" value="<%= L(content.mitraHeadline,'id') %>"></div>
      <div><label class="lang" style="margin-top:0">English</label><input name="mitraHeadline[en]" value="<%= L(content.mitraHeadline,'en') %>"></div>
    </div>
    <label>Sub-headline</label>
    <div class="row2">
      <div><label class="lang" style="margin-top:0">Indonesia</label><textarea name="mitraSub[id]" rows="2"><%= L(content.mitraSub,'id') %></textarea></div>
      <div><label class="lang" style="margin-top:0">English</label><textarea name="mitraSub[en]" rows="2"><%= L(content.mitraSub,'en') %></textarea></div>
    </div>
    <label>Statistik</label>
    <%- include('../partials/list_editor', { key:'stats', items:content.stats, fields:[{name:'value',label:'Angka',ph:'mis. 24/7'},{name:'label',label:'Keterangan',ph:'mis. Dukungan mitra'}], addLabel:'Tambah statistik' }) %>
    <label style="margin-top:14px">Cara Kerja / Langkah</label>
    <%- include('../partials/list_editor', { key:'steps', items:content.steps, fields:[{name:'t',label:'Judul'},{name:'d',label:'Deskripsi',wide:true}], addLabel:'Tambah langkah' }) %>
    <label style="margin-top:14px">Benefit</label>
    <%- include('../partials/list_editor', { key:'benefits', items:content.benefits, fields:[{name:'t',label:'Judul'},{name:'d',label:'Deskripsi',wide:true}], addLabel:'Tambah benefit' }) %>
    <label style="margin-top:14px">Poin Komisi</label>
    <%- include('../partials/list_editor', { key:'commission', items:content.commission, single:true, fields:[{label:'Poin',ph:'mis. Gratis mendaftar & tanpa biaya langganan'}], addLabel:'Tambah poin' }) %>
    <label style="margin-top:14px">Testimoni</label>
    <%- include('../partials/list_editor', { key:'testimonials', items:content.testimonials, fields:[{name:'name',label:'Nama'},{name:'role',label:'Jabatan / Properti'},{name:'quote',label:'Testimoni',wide:true}], addLabel:'Tambah testimoni' }) %>
    <label style="margin-top:14px">FAQ</label>
    <%- include('../partials/list_editor', { key:'faqs', items:content.faqs, fields:[{name:'q',label:'Pertanyaan',wide:true},{name:'a',label:'Jawaban',wide:true}], addLabel:'Tambah FAQ' }) %>
  </div>

  <div style="margin:16px 0 40px"><button class="btn">Simpan Konten Web</button></div>
</form>

<style>
  label.lang{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-top:8px}
  .leditor{margin:6px 0 4px}
  .leditor .lrow{display:flex;gap:8px;align-items:end;margin-bottom:8px;flex-wrap:wrap}
  .leditor .lfld{display:flex;flex-direction:column;flex:1;min-width:150px;gap:3px;margin:0}
  .leditor .lfld.wide{flex-basis:100%}
  .leditor .lfld span{font-size:11px;color:var(--muted);font-weight:600}
  .leditor .lrow input{width:100%;box-sizing:border-box}
  .leditor .lrm{align-self:center;padding:4px 10px}
</style>

<script>
(function(){
  document.addEventListener('click', function(e){
    var add = e.target.closest('.ladd');
    if (add){
      var ed = add.closest('.leditor');
      var n = parseInt(ed.dataset.count || '0', 10);
      var html = ed.querySelector('.ltmpl').innerHTML.replace(/__i__/g, n);
      ed.querySelector('.lrows').insertAdjacentHTML('beforeend', html);
      ed.dataset.count = n + 1;
      return;
    }
    var rm = e.target.closest('.lrm');
    if (rm){ rm.closest('.lrow').remove(); }
  });
})();
</script>

<%- include('../partials/bottom') %>
