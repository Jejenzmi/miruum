<%- include('../partials/top', { title:'Live Chat CS', heading:'Live Chat — Customer Service', section:'admin', active:'chats', me }) %>

<div style="display:grid;grid-template-columns:300px 1fr;gap:16px;align-items:start">
  <div class="card" style="max-height:70vh;overflow:auto">
    <h3>Percakapan</h3>
    <% chats.forEach(function(c){ var last = (c.messages&&c.messages[0]); %>
      <a href="/admin/chats?id=<%= c.id %>" style="display:block;padding:11px;border-radius:12px;margin-bottom:6px;background:<%= (conversation&&conversation.id===c.id)?'var(--primary-s)':'transparent' %>">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <b style="font-size:13.5px"><%= c.user.name %></b>
          <span class="pill <%= c.status==='WAITING_AGENT'?'PENDING':(c.status==='AGENT'?'PAID':'REFUNDED') %>" style="font-size:9.5px"><%= c.status==='WAITING_AGENT'?'Nunggu Agen':(c.status==='AGENT'?'Ditangani':'Bot') %></span>
        </div>
        <div class="muted" style="font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= last?last.body:'' %></div>
      </a>
    <% }) %>
    <% if (!chats.length) { %><p class="empty">Belum ada percakapan</p><% } %>
  </div>

  <div class="card" style="min-height:60vh;display:flex;flex-direction:column">
    <% if (!conversation) { %>
      <p class="empty" style="margin:auto">← Pilih percakapan untuk membalas</p>
    <% } else { %>
      <h3 style="margin-bottom:14px"><%= conversation.user.name %> <span class="muted" style="font-weight:400;font-size:12px">· <%= conversation.user.email %></span></h3>
      <div style="flex:1;overflow:auto;display:flex;flex-direction:column;gap:8px;padding:4px 2px">
        <% conversation.messages.forEach(function(m){
             var mine = m.sender==='AGENT'; var bot = m.sender==='BOT';
             var bg = mine ? 'var(--primary)' : (bot ? '#EAE2FF' : 'var(--field)');
             var col = mine ? '#fff' : 'var(--ink)'; %>
          <div style="align-self:<%= mine?'flex-end':'flex-start' %>;max-width:70%;background:<%= bg %>;color:<%= col %>;padding:9px 13px;border-radius:14px;font-size:13px">
            <% if (bot) { %><div style="font-size:9px;font-weight:700;color:#6D28D9;margin-bottom:2px">🤖 BOT</div><% } %>
            <%= m.body %>
          </div>
        <% }) %>
      </div>
      <form method="post" action="/admin/chats/<%= conversation.id %>/reply" style="display:flex;gap:8px;margin-top:12px">
        <input name="body" placeholder="Ketik balasan sebagai agen..." required autocomplete="off">
        <button class="btn">Kirim</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/bottom') %>
