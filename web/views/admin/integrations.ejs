<%- include('../partials/top', { title:'Integrasi', heading:'Integrasi & Kredensial', section:'admin', active:'integrations', me }) %>

<% var i = integrations || {}; %>
<% if (saved==='1') { %><div class="notice ok">Konfigurasi integrasi tersimpan.</div><% } %>
<% if (saved==='testmail') { %><div class="notice ok">Email uji terkirim — cek inbox tujuan.</div><% } %>
<% if (saved==='testmailerr') { %><div class="notice bad">Gagal kirim email uji: <%= msg %></div><% } %>
<% if (saved==='testfcm') { %><div class="notice ok">Service account FCM valid — koneksi berhasil.</div><% } %>
<% if (saved==='testfcmerr') { %><div class="notice bad">FCM gagal: <%= msg %></div><% } %>

<p class="muted" style="margin:-4px 0 18px">Masukkan semua kredensial di sini — tanpa perlu ubah server. Email (SMTP), Push (FCM), dan WhatsApp langsung aktif setelah diaktifkan &amp; disimpan.</p>

<form method="post" action="/admin/integrations">
  <div class="grid-2">
    <div class="card">
      <h2>Email (SMTP)</h2>
      <label class="pr-check" style="margin-bottom:10px"><input type="checkbox" name="mail_enabled" style="width:auto" <%= i.mail_enabled==='1'?'checked':'' %>> Aktifkan pengiriman email</label>
      <div class="row2">
        <div><label style="margin-top:0">Host SMTP</label><input name="smtp_host" value="<%= i.smtp_host %>" placeholder="smtp.gmail.com"></div>
        <div><label style="margin-top:0">Port</label><input name="smtp_port" value="<%= i.smtp_port %>" placeholder="587"></div>
      </div>
      <div class="row2">
        <div><label>Username</label><input name="smtp_user" value="<%= i.smtp_user %>" placeholder="user@domain.com"></div>
        <div><label>Password / App Password</label><input name="smtp_pass" type="password" value="<%= i.smtp_pass %>" placeholder="••••••••"></div>
      </div>
      <div class="row2">
        <div><label>Email Pengirim (From)</label><input name="smtp_from" value="<%= i.smtp_from %>" placeholder="Miruum <no-reply@miruum.id>"></div>
        <div><label>SSL/TLS (port 465)</label><br><label class="pr-check" style="margin-top:8px"><input type="checkbox" name="smtp_secure" style="width:auto" <%= i.smtp_secure==='1'?'checked':'' %>> Secure</label></div>
      </div>
      <p class="muted" style="font-size:11px;margin-top:6px">Gmail: pakai App Password (bukan sandi akun). Port 587 (TLS) atau 465 (Secure).</p>
    </div>

    <div class="card">
      <h2>Push Notification (FCM)</h2>
      <label class="pr-check" style="margin-bottom:10px"><input type="checkbox" name="fcm_enabled" style="width:auto" <%= i.fcm_enabled==='1'?'checked':'' %>> Aktifkan push FCM</label>
      <label style="margin-top:0">Service Account JSON (Firebase)</label>
      <textarea name="fcm_service_account" rows="8" spellcheck="false" style="font-family:monospace;font-size:11px" placeholder='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@...iam.gserviceaccount.com"}'><%= i.fcm_service_account %></textarea>
      <p class="muted" style="font-size:11px;margin-top:6px">Firebase Console → Project Settings → Service accounts → Generate new private key. Tempel isi JSON-nya di sini (memakai FCM HTTP v1).</p>
    </div>

    <div class="card">
      <h2>WhatsApp Gateway</h2>
      <label class="pr-check" style="margin-bottom:10px"><input type="checkbox" name="wa_enabled" style="width:auto" <%= i.wa_enabled==='1'?'checked':'' %>> Aktifkan notifikasi WhatsApp</label>
      <label style="margin-top:0">URL API Gateway</label>
      <input name="wa_api_url" value="<%= i.wa_api_url %>" placeholder="https://gateway.example.com/send">
      <label>Token / API Key</label>
      <input name="wa_api_token" type="password" value="<%= i.wa_api_token %>" placeholder="••••••••">
      <p class="muted" style="font-size:11px;margin-top:6px">Gateway HTTP generik (mengirim {to, message}). Kosongkan bila belum ada.</p>
    </div>

    <div class="card">
      <h2>Login Google (OAuth)</h2>
      <label style="margin-top:0">OAuth Web Client ID</label>
      <input name="google_client_id" value="<%= i.google_client_id %>" placeholder="xxxxx.apps.googleusercontent.com">
      <p class="muted" style="font-size:11px;margin-top:6px">Dari Firebase Console → Authentication → Sign-in method → Google (Enable) → "Web SDK configuration" → Web client ID. Backend verifikasi audience token dengan ini.</p>
    </div>

    <div class="card">
      <h2>🤖 Agen AI — Rate Intelligence</h2>
      <p class="muted" style="font-size:12px;margin-top:-4px">Agen AI otomatis mencari harga hotel Miruum di OTA lain (web-search) untuk mengisi Rate Intelligence. Butuh API key Anthropic (Claude).</p>
      <label class="pr-check" style="margin-bottom:10px"><input type="checkbox" name="ai_enabled" style="width:auto" <%= i.ai_enabled==='1'?'checked':'' %>> Aktifkan Agen AI</label>
      <label style="margin-top:0">Anthropic API Key</label>
      <input name="ai_api_key" type="password" value="<%= i.ai_api_key %>" placeholder="sk-ant-••••••••">
      <label>Model</label>
      <input name="ai_model" value="<%= i.ai_model %>" placeholder="claude-sonnet-5">
      <label class="pr-check" style="margin:10px 0 0"><input type="checkbox" name="ai_auto" style="width:auto" <%= i.ai_auto==='1'?'checked':'' %>> Jalankan otomatis (3× per hari / tiap 8 jam)</label>
      <p class="muted" style="font-size:11px;margin-top:8px">Harga OTA hasil AI = <b>estimasi</b> dari pencarian web (dilabeli “AI” &amp; bertanggal). Bisa dikoreksi manual di Rate Intelligence.</p>
    </div>

    <div class="card">
      <h2>Payment Gateway</h2>
      <label style="margin-top:0">Provider Pembayaran</label>
      <select name="payment_provider">
        <% var pp = i.payment_provider || 'MOCK'; %>
        <option value="MOCK" <%= pp==='MOCK'?'selected':'' %>>MOCK (simulasi — tanpa uang nyata)</option>
        <option value="LINKQU" <%= pp==='LINKQU'?'selected':'' %>>LinkQu (VA + QRIS nyata)</option>
        <option value="FLIP" <%= pp==='FLIP'?'selected':'' %>>Flip</option>
      </select>
      <p class="muted" style="font-size:11px;margin:6px 0 12px">Pilih <b>LinkQu</b> lalu isi kredensial di bawah. Jika kredensial kosong, otomatis kembali ke MOCK (aman).</p>
      <div class="row2">
        <div><label style="margin-top:0">Base URL</label><input name="linkqu_base" value="<%= i.linkqu_base %>" placeholder="https://api.linkqu.id (prod) / https://gateway-dev.linkqu.id (dev)"></div>
        <div><label style="margin-top:0">Client ID</label><input name="linkqu_client_id" value="<%= i.linkqu_client_id %>" placeholder="client-id"></div>
      </div>
      <div class="row2">
        <div><label>Client Secret</label><input name="linkqu_client_secret" type="password" value="<%= i.linkqu_client_secret %>" placeholder="••••••••"></div>
        <div><label>Username</label><input name="linkqu_username" value="<%= i.linkqu_username %>" placeholder="LIxxxxxxx"></div>
      </div>
      <div class="row2">
        <div><label>PIN</label><input name="linkqu_pin" type="password" value="<%= i.linkqu_pin %>" placeholder="••••••••"></div>
        <div><label>Server Key (secret signature)</label><input name="linkqu_server_key" type="password" value="<%= i.linkqu_server_key %>" placeholder="••••••••"></div>
      </div>
      <p class="muted" style="font-size:11px;margin-top:8px">⚠️ LinkQu memblokir per-IP: <b>whitelist IP server 76.13.197.249</b> di dashboard LinkQu, atau semua request ditolak (error 1010). Callback URL: <code>https://api.miruum.id/api/payments/webhook/linkqu</code></p>
    </div>

    <div class="card">
      <h2>Supply &amp; Channel Manager</h2>
      <p class="muted" style="font-size:11.5px;margin-top:-4px">Sumber inventory NYATA. Aktifkan &amp; isi kredensial sandbox; koneksi diverifikasi langsung ke server provider (bukan simulasi).</p>

      <h3 style="margin:14px 0 6px;font-size:14px">Channex (Channel Manager 2-arah)</h3>
      <label class="pr-check" style="margin-bottom:8px"><input type="checkbox" name="channex_enabled" style="width:auto" <%= i.channex_enabled==='1'?'checked':'' %>> Aktifkan Channex</label>
      <div class="row2">
        <div><label style="margin-top:0">Base URL</label><input name="channex_base" value="<%= i.channex_base %>" placeholder="https://staging.channex.io/api/v1 (sandbox) / https://app.channex.io/api/v1 (prod)"></div>
        <div><label style="margin-top:0">API Key (user-api-key)</label><input name="channex_api_key" type="password" value="<%= i.channex_api_key %>" placeholder="••••••••"></div>
      </div>
      <p class="muted" style="font-size:11px;margin:6px 0 0">Tarik inventory hotel (ARI) → katalog Miruum &amp; kirim booking balik ke PMS. Webhook: <code>https://api.miruum.id/api/webhooks/channex</code></p>

      <h3 style="margin:16px 0 6px;font-size:14px">Hotelbeds APItude (Bedbank)</h3>
      <label class="pr-check" style="margin-bottom:8px"><input type="checkbox" name="hotelbeds_enabled" style="width:auto" <%= i.hotelbeds_enabled==='1'?'checked':'' %>> Aktifkan Hotelbeds</label>
      <div class="row2">
        <div><label style="margin-top:0">Base URL</label><input name="hotelbeds_base" value="<%= i.hotelbeds_base %>" placeholder="https://api.test.hotelbeds.com (sandbox)"></div>
        <div><label style="margin-top:0">Api-key</label><input name="hotelbeds_api_key" type="password" value="<%= i.hotelbeds_api_key %>" placeholder="••••••••"></div>
      </div>
      <div><label>Secret</label><input name="hotelbeds_secret" type="password" value="<%= i.hotelbeds_secret %>" placeholder="••••••••"></div>
      <p class="muted" style="font-size:11px;margin:6px 0 0">Jual-ulang ribuan hotel eksternal (Miruum sebagai sub-agent). Daftar sandbox key di developer.hotelbeds.com.</p>
    </div>

    <div class="card">
      <h2>Status Kanal</h2>
      <div class="pms-row"><div><b>Payment</b></div><span class="pill <%= (i.payment_provider==='LINKQU'&&i.linkqu_client_id)||(i.payment_provider==='FLIP')?'PAID':'CANCELLED' %>"><%= i.payment_provider && i.payment_provider!=='MOCK' ? (i.payment_provider+' aktif') : 'MOCK (simulasi)' %></span></div>
      <div class="pms-row"><div><b>Email (SMTP)</b></div><span class="pill <%= i.mail_enabled==='1'&&i.smtp_host?'PAID':'CANCELLED' %>"><%= i.mail_enabled==='1'&&i.smtp_host?'Aktif':'Nonaktif' %></span></div>
      <div class="pms-row"><div><b>Push (FCM)</b></div><span class="pill <%= i.fcm_enabled==='1'&&i.fcm_service_account?'PAID':'CANCELLED' %>"><%= i.fcm_enabled==='1'&&i.fcm_service_account?'Aktif':'Nonaktif' %></span></div>
      <div class="pms-row"><div><b>WhatsApp</b></div><span class="pill <%= i.wa_enabled==='1'&&i.wa_api_url?'PAID':'CANCELLED' %>"><%= i.wa_enabled==='1'&&i.wa_api_url?'Aktif':'Nonaktif' %></span></div>
      <div class="pms-row" style="border-bottom:none"><div><b>Agen AI (Rate Intel)</b></div><span class="pill <%= i.ai_enabled==='1'&&i.ai_api_key?'PAID':'CANCELLED' %>"><%= i.ai_enabled==='1'&&i.ai_api_key?'Aktif':'Nonaktif' %></span></div>
      <p class="muted" style="font-size:11px;margin-top:12px">Semua kredensial tersimpan di server &amp; hanya bisa diakses admin.</p>
    </div>
  </div>
  <div style="margin-top:6px"><button class="btn">Simpan Semua Konfigurasi</button></div>
</form>

<div class="grid-2" style="margin-top:20px">
  <div class="card">
    <h3 style="margin:0 0 10px">Uji Email</h3>
    <form method="post" action="/admin/integrations/test-email" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
      <div style="flex:1;min-width:180px"><label style="margin-top:0">Kirim email uji ke</label><input name="to" type="email" placeholder="anda@email.com" required></div>
      <button class="btn ghost">Kirim Uji</button>
    </form>
  </div>
  <div class="card">
    <h3 style="margin:0 0 10px">Uji FCM</h3>
    <p class="muted" style="font-size:12px;margin-top:-4px">Validasi Service Account bisa memperoleh token (simpan dulu bila baru diubah).</p>
    <form method="post" action="/admin/integrations/test-fcm"><button class="btn ghost">Uji Koneksi FCM</button></form>
  </div>
</div>

<div class="grid-2" style="margin-top:20px">
  <div class="card">
    <h3 style="margin:0 0 10px">Status Supply (live)</h3>
    <p class="muted" style="font-size:12px;margin-top:-4px">Cek koneksi nyata ke server Channex &amp; Hotelbeds (simpan kredensial dulu).</p>
    <button type="button" class="btn ghost" onclick="checkSupply()">Cek Status Sekarang</button>
    <div id="supplyStatus" style="margin-top:12px;font-size:13px"></div>
  </div>
  <div class="card">
    <h3 style="margin:0 0 10px">Sync Channex → Katalog</h3>
    <p class="muted" style="font-size:12px;margin-top:-4px">Tarik properti + kamar dari Channex jadi hotel <code>source=CHANNEX</code>. Perlu Channex aktif.</p>
    <% if (saved==='cxsync') { %><div class="notice ok" style="margin-bottom:10px">Sync berhasil: <%= msg %></div><% } %>
    <% if (saved==='cxsyncerr') { %><div class="notice bad" style="margin-bottom:10px"><%= msg %></div><% } %>
    <form method="post" action="/admin/integrations/channex-sync" data-confirm="Tarik semua properti Channex ke katalog?" data-confirm-title="Sync Channex" data-confirm-ok="Ya, sync"><button class="btn">Sync Sekarang</button></form>
  </div>
</div>

<script>
async function checkSupply(){
  var el=document.getElementById('supplyStatus');
  el.innerHTML='Memeriksa…';
  try{
    var r=await fetch('/admin/integrations/supply-status');var d=await r.json();
    if(d.error){el.innerHTML='<span style="color:#dc2626">'+d.error+'</span>';return;}
    var html='';
    Object.keys(d.providers||{}).forEach(function(k){
      var p=d.providers[k];
      html+='<div style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)"><b style="min-width:90px">'+k+'</b>'+
            '<span class="pill '+(p.ok?'PAID':'CANCELLED')+'">'+(p.ok?'Terhubung':'Nonaktif')+'</span>'+
            '<span class="muted" style="font-size:12px">'+(p.detail||'')+'</span></div>';
    });
    el.innerHTML=html;
  }catch(e){el.innerHTML='<span style="color:#dc2626">Gagal memeriksa</span>';}
}
</script>

<%- include('../partials/bottom') %>
