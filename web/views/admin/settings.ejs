<%- include('../partials/top', { title:'Pengaturan', heading:'Pengaturan Platform', section:'admin', active:'settings', me }) %>


<div class="card" style="max-width:560px">
  <h3>Konfigurasi</h3>
  <form method="post" action="/admin/settings">
    <label>Pajak & Layanan (%)</label>
    <input name="taxPct" type="number" step="0.1" value="<%= settings.taxPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Ditambahkan ke harga akomodasi di setiap booking.</p>

    <label>Komisi Platform DIRECT (%)</label>
    <input name="directCommissionPct" type="number" step="0.1" value="<%= settings.directCommissionPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Komisi Miruum untuk booking hotel DIRECT (memengaruhi payout & Keuangan).</p>

    <label>Tarif B2B Korporat — Diskon Default (%)</label>
    <input name="corporate_discount_pct" type="number" min="0" max="90" step="1" value="<%= settings.corporate_discount_pct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Berlaku untuk akun korporat/pemerintah yang belum punya tarif negosiasi sendiri (<a href="/admin/corporates">Akun Korporat</a>) — tidak pernah memengaruhi harga publik (B2C).</p>

    <label style="margin-top:18px">Harga Tamu Asing (Nationality Pricing)</label>
    <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap">
      <label class="fac-item" style="margin:0"><input type="checkbox" name="foreign_market_enabled" value="1" <%= settings.foreign_market_enabled==='1' ? 'checked' : '' %>> Aktifkan</label>
      <div style="flex:1;min-width:180px">
        <input name="foreign_markup_pct" type="number" min="0" max="100" step="1" value="<%= settings.foreign_markup_pct %>" placeholder="mis. 15">
      </div>
    </div>
    <p class="muted" style="font-size:11.5px;margin-top:4px">Markup (%) harga <b>publik</b> untuk tamu <b>Asing (WNA)</b>; tamu <b>Domestik (WNI)</b> tetap harga normal. Default pasar ditebak dari negara IP, tamu bisa memilih sendiri di web/app. Bisa dioverride per hotel di form hotel. <b>Tidak</b> memengaruhi harga B2B/korporat.</p>

    <label style="margin-top:18px">Kurs Supply Eksternal (Bedbank → IDR)</label>
    <div class="row2">
      <div><input name="supply_fx_rates" value="<%= settings.supply_fx_rates %>" placeholder='{"EUR":17500,"USD":16200}'></div>
      <div><input name="supply_fx_markup_pct" type="number" min="0" max="20" step="0.5" value="<%= settings.supply_fx_markup_pct %>" placeholder="buffer % (mis. 3)"></div>
    </div>
    <p class="muted" style="font-size:11.5px;margin-top:4px">Konversi harga Hotelbeds (EUR/USD) → rupiah. Kosongkan tabel = pakai kurs bawaan. Buffer % menyerap fluktuasi kurs. Tidak memengaruhi harga DIRECT/B2C/B2B.</p>

    <label style="margin-top:18px">Kebijakan Multi-sumber (hotel direct + sub-agent)</label>
    <div class="row2">
      <div>
        <label style="margin-top:0;font-size:12px">Parity Guard</label>
        <% var pm = settings.supplyParityMode || 'PROTECT'; %>
        <select name="supplyParityMode" style="max-width:100%">
          <option value="PROTECT" <%= pm==='PROTECT'?'selected':'' %>>PROTECT — sembunyikan rate bedbank di bawah harga direct (lindungi mitra)</option>
          <option value="TRANSPARENT" <%= pm==='TRANSPARENT'?'selected':'' %>>TRANSPARENT — tampilkan semua harga (termurah menang)</option>
          <option value="DIRECT_FIRST" <%= pm==='DIRECT_FIRST'?'selected':'' %>>DIRECT_FIRST — bedbank hanya saat direct kosong</option>
        </select>
      </div>
      <div>
        <label style="margin-top:0;font-size:12px">Markup Jual Bedbank (%)</label>
        <input name="bedbankMarkupPct" type="number" min="0" max="60" step="1" value="<%= settings.bedbankMarkupPct %>" placeholder="mis. 10">
      </div>
    </div>
    <p class="muted" style="font-size:11.5px;margin-top:4px">Untuk hotel yang <b>direct</b> sekaligus ada di <b>sub-agent</b>. Parity Guard mengatur bagaimana rate sub-agent diperlakukan vs harga direct. Markup = margin Miruum di atas net bedbank untuk harga jual ke tamu.</p>

    <label>Mata Uang</label>
    <input name="currency" value="<%= settings.currency %>">

    <label>Nama Aplikasi</label>
    <input name="appName" value="<%= settings.appName %>">

    <h3 style="margin:22px 0 4px">Kebijakan Refund Pembatalan</h3>
    <p class="muted" style="font-size:11.5px;margin:0 0 10px">Berlaku saat tamu membatalkan pesanan yang sudah dibayar.</p>
    <div class="row2">
      <div><label style="margin-top:0">Batas Waktu (jam sebelum check-in)</label><input name="refundCutoffHours" type="number" value="<%= settings.refundCutoffHours %>"></div>
      <div><label style="margin-top:0">Refund Penuh (%) — kamar gratis batal</label><input name="refundFullPct" type="number" value="<%= settings.refundFullPct %>"></div>
    </div>
    <label>Refund Sebagian (%) — kamar refundable</label>
    <input name="refundPartialPct" type="number" value="<%= settings.refundPartialPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Non-refundable = 0%. Membatalkan setelah batas waktu = 0%.</p>

    <h3 style="margin:22px 0 4px">Modul Aplikasi Mobile</h3>
    <p class="muted" style="font-size:11.5px;margin:0 0 10px">Nonaktifkan modul untuk menyembunyikannya dari aplikasi mobile pengguna. Hotel selalu aktif (modul inti).</p>
    <% function modSel(name, val){ %>
      <select name="<%= name %>" style="max-width:160px">
        <option value="1" <%= (val!=='0')?'selected':'' %>>Aktif — tampil</option>
        <option value="0" <%= (val==='0')?'selected':'' %>>Nonaktif — hidden</option>
      </select>
    <% } %>
    <div class="row2">
      <div><label style="margin-top:0">Hotel Package</label><% modSel('moduleHotelPackage', settings.moduleHotelPackage) %></div>
      <div><label style="margin-top:0">Tour</label><% modSel('moduleTour', settings.moduleTour) %></div>
    </div>
    <label>Shuttle Bandara (Soekarno-Hatta)</label><% modSel('moduleShuttle', settings.moduleShuttle) %>

    <div style="margin-top:18px"><button class="btn">Simpan Pengaturan</button></div>
  </form>
</div>

<div class="card" style="max-width:560px;margin-top:18px">
  <h3>Metode Pembayaran</h3>
  <p class="muted" style="font-size:11.5px;margin:0 0 12px">Centang metode yang ingin ditawarkan ke tamu saat pembayaran. <b>Bila tidak ada yang dicentang, semua metode ditawarkan.</b></p>
  <% var pmOn = {}; payEnabled.forEach(function(c){ pmOn[c] = true; }); var pmAllOn = payEnabled.length === 0; %>
  <% if (!payAll.length) { %>
    <p class="muted empty" style="padding:22px">Katalog metode pembayaran tidak tersedia.</p>
  <% } else { %>
    <form method="post" action="/admin/payment-methods"
          data-confirm="Metode yang tidak dicentang tidak akan muncul di aplikasi & web pelanggan. Simpan perubahan?"
          data-confirm-title="Simpan Metode Pembayaran" data-confirm-ok="Ya, simpan">
      <% var groups = {}; payAll.forEach(function(m){ (groups[m.group] = groups[m.group] || []).push(m); }); %>
      <% Object.keys(groups).forEach(function(g){ %>
        <label style="margin-top:14px"><%= g %></label>
        <div class="fac-checks">
          <% groups[g].forEach(function(m){ %>
            <label class="fac-item"><input type="checkbox" name="codes" value="<%= m.code %>" <%= (pmAllOn || pmOn[m.code]) ? 'checked' : '' %>> <%= m.name %></label>
          <% }) %>
        </div>
      <% }) %>
      <p class="muted" style="font-size:11.5px;margin:14px 0 0">Saat ini: <b><%= pmAllOn ? 'semua metode ditawarkan' : payEnabled.length + ' metode aktif' %></b>.</p>
      <div style="margin-top:14px"><button class="btn">Simpan Metode Pembayaran</button></div>
    </form>
  <% } %>
</div>

<%- include('../partials/bottom') %>
