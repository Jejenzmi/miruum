<%- include('../partials/top', { title:'Pengaturan', heading:'Pengaturan Platform', section:'admin', active:'settings', me }) %>


<div class="card" style="max-width:560px">
  <h3>Konfigurasi</h3>
  <form method="post" action="/admin/settings">
    <label>Pajak & Layanan (%)</label>
    <input name="taxPct" type="number" step="0.1" value="<%= settings.taxPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Ditambahkan ke harga akomodasi di setiap booking.</p>

    <label>Komisi Platform DIRECT (%)</label>
    <input name="directCommissionPct" type="number" step="0.1" value="<%= settings.directCommissionPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Komisi Miruum untuk booking hotel DIRECT (memengaruhi payout & Keuangan).</p>

    <label>Mata Uang</label>
    <input name="currency" value="<%= settings.currency %>">

    <label>Nama Aplikasi</label>
    <input name="appName" value="<%= settings.appName %>">

    <h3 style="margin:22px 0 4px">Kebijakan Refund Pembatalan</h3>
    <p class="muted" style="font-size:11.5px;margin:0 0 10px">Berlaku saat tamu membatalkan pesanan yang sudah dibayar.</p>
    <div class="row2">
      <div><label style="margin-top:0">Batas Waktu (jam sebelum check-in)</label><input name="refundCutoffHours" type="number" value="<%= settings.refundCutoffHours %>"></div>
      <div><label style="margin-top:0">Refund Penuh (%) — kamar gratis batal</label><input name="refundFullPct" type="number" value="<%= settings.refundFullPct %>"></div>
    </div>
    <label>Refund Sebagian (%) — kamar refundable</label>
    <input name="refundPartialPct" type="number" value="<%= settings.refundPartialPct %>">
    <p class="muted" style="font-size:11.5px;margin-top:4px">Non-refundable = 0%. Membatalkan setelah batas waktu = 0%.</p>

    <h3 style="margin:22px 0 4px">Modul Aplikasi Mobile</h3>
    <p class="muted" style="font-size:11.5px;margin:0 0 10px">Nonaktifkan modul untuk menyembunyikannya dari aplikasi mobile pengguna. Hotel selalu aktif (modul inti).</p>
    <% function modSel(name, val){ %>
      <select name="<%= name %>" style="max-width:160px">
        <option value="1" <%= (val!=='0')?'selected':'' %>>Aktif — tampil</option>
        <option value="0" <%= (val==='0')?'selected':'' %>>Nonaktif — hidden</option>
      </select>
    <% } %>
    <div class="row2">
      <div><label style="margin-top:0">Hotel Package</label><% modSel('moduleHotelPackage', settings.moduleHotelPackage) %></div>
      <div><label style="margin-top:0">Tour</label><% modSel('moduleTour', settings.moduleTour) %></div>
    </div>
    <label>Shuttle Bandara (Soekarno-Hatta)</label><% modSel('moduleShuttle', settings.moduleShuttle) %>

    <div style="margin-top:18px"><button class="btn">Simpan Pengaturan</button></div>
  </form>
</div>

<%- include('../partials/bottom') %>
