<%- include('../partials/top', { title:'Program', heading:'Program Promo & Campaign', section:'admin', active:'programs', me }) %>

<p class="muted" style="margin:-4px 0 18px">Buat program lalu Miruum otomatis <b>mengundang semua hotel</b> (notifikasi in-app + email). Hotel ikut serta lewat Extranet / Channel Manager. <b>Promo</b> = program diskon; <b>Campaign</b> = kampanye pemasaran/tematik.</p>

<div class="grid-2">
  <div class="card">
    <h2>Buat Program Baru</h2>
    <form method="post" action="/admin/programs">
      <div class="row2">
        <div><label style="margin-top:0">Jenis</label>
          <select name="type"><option value="PROMO">Promo (diskon)</option><option value="CAMPAIGN">Campaign (kampanye)</option></select>
        </div>
        <div><label style="margin-top:0">Saran Diskon (%)</label><input name="discountPct" type="number" min="0" max="90" value="15"></div>
      </div>
      <label>Judul</label>
      <input name="title" placeholder="mis. Diskon Kemerdekaan 17%" required>
      <label>Deskripsi</label>
      <textarea name="description" rows="3" placeholder="Jelaskan program & manfaatnya untuk hotel & tamu" required></textarea>
      <div class="row2">
        <div><label>Mulai</label><input name="startDate" type="date"></div>
        <div><label>Selesai</label><input name="endDate" type="date"></div>
      </div>
      <label>URL Gambar (opsional)</label>
      <input name="imageUrl" placeholder="https://...">
      <label>Syarat & Ketentuan (opsional)</label>
      <textarea name="terms" rows="2" placeholder="mis. minimal 2 malam, non-refundable"></textarea>
      <div style="margin-top:16px"><button class="btn">Buat & Undang Semua Hotel</button></div>
    </form>
  </div>

  <div class="card">
    <h2>Program Berjalan</h2>
    <p class="muted" style="margin-top:-8px">Status partisipasi hotel per program.</p>
    <div style="display:flex;flex-direction:column;gap:12px">
      <% programs.forEach(function(p){ %>
        <div style="border:1px solid var(--line);border-radius:14px;padding:14px">
          <div style="display:flex;justify-content:space-between;align-items:start;gap:10px">
            <div>
              <span class="pill <%= p.type==='CAMPAIGN'?'ADMIN':'PARTNER' %>"><%= p.type==='CAMPAIGN'?'Campaign':'Promo' %></span>
              <b style="display:block;margin-top:6px;font-size:14px"><%= p.title %></b>
              <span class="muted" style="font-size:11.5px"><%= p.description.slice(0,90) %><%= p.description.length>90?'…':'' %></span>
            </div>
            <form method="post" action="/admin/programs/<%= p.id %>/delete" data-confirm="Hapus program '<%= p.title %>'?"><button class="btn danger sm">Hapus</button></form>
          </div>
          <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
            <% if (p.discountPct) { %><span class="pill" style="background:var(--accent-s);color:#b8791a">Diskon <%= p.discountPct %>%</span><% } %>
            <span class="pill" style="background:var(--bg);color:var(--muted)"><%= p.invited %> diundang</span>
            <span class="pill PAID"><%= p.joined %> ikut</span>
            <% if (p.declined) { %><span class="pill CANCELLED"><%= p.declined %> menolak</span><% } %>
          </div>
        </div>
      <% }) %>
      <% if (!programs.length) { %><p class="empty">Belum ada program</p><% } %>
    </div>
  </div>
</div>

<%- include('../partials/bottom') %>
