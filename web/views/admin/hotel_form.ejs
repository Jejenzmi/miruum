<%- include('../partials/top', { title: hotel ? 'Edit Hotel' : 'Hotel Baru', heading: hotel ? 'Edit Hotel' : 'Tambah Hotel', section:'admin', active:'hotels', me }) %>

<% if (typeof err !== 'undefined' && err) { %><div class="notice bad" style="max-width:720px"><%= err %></div><% } %>
<% if (typeof added !== 'undefined' && added) { %><div class="notice ok" style="max-width:720px">✓ Hotel dibuat. Lengkapi <b>Kamar</b> di bawah — hotel <b>tidak muncul di aplikasi</b> sampai punya minimal 1 kamar berharga.</div><% } %>
<% if (typeof saved !== 'undefined' && saved==='1') { %><div class="notice ok" style="max-width:720px">Perubahan tersimpan.</div><% } %>

<div class="card" style="max-width:720px">
  <form id="hotelForm" method="post" action="<%= hotel ? '/admin/hotels/'+hotel.id : '/admin/hotels' %>">
    <label>Nama Hotel</label>
    <input name="name" value="<%= hotel ? hotel.name : '' %>" required>
    <div class="row2">
      <div><label>Kota</label><input name="city" value="<%= hotel ? hotel.city : '' %>" required></div>
      <div><label>Harga / malam (Rp)</label><input name="priceFrom" type="number" value="<%= hotel ? hotel.priceFrom : 500000 %>"></div>
    </div>
    <div>
      <label>Markup Tamu Asing / WNA (%) — opsional</label>
      <input name="foreignMarkupPct" type="number" min="0" max="100" step="1" value="<%= (hotel && hotel.foreignMarkupPct != null) ? hotel.foreignMarkupPct : '' %>" placeholder="kosong = pakai default global">
      <p class="muted" style="font-size:11px;margin:4px 0 0">Override markup harga tamu asing khusus hotel ini. Kosongkan untuk mengikuti setelan global (<a href="/admin/settings">Pengaturan</a>). Hanya berlaku bila Nationality Pricing aktif.</p>
    </div>
    <div class="nav-label" style="margin-top:20px">Wilayah *</div>
    <p class="muted" style="font-size:11px;margin:0 0 8px">Wajib dipilih sampai tingkat terdalam yang tersedia. Tanpa wilayah, properti ini <b>tidak akan muncul di pencarian area</b> pada aplikasi.</p>
    <%- include('../partials/region_picker', { regionId: hotel ? hotel.regionId : '', address: hotel ? hotel.address : '' }) %>
    <label>Deskripsi</label>
    <textarea name="description" rows="3"><%= hotel ? hotel.description : '' %></textarea>
    <div class="row2">
      <div><label>Info Check-in</label><input name="checkInInfo" value="<%= hotel ? (hotel.checkInInfo || '') : '' %>" placeholder="Dari jam 14.00"></div>
      <div><label>Info Check-out</label><input name="checkOutInfo" value="<%= hotel ? (hotel.checkOutInfo || '') : '' %>" placeholder="Sebelum 12.00"></div>
    </div>
    <div class="row2">
      <div><label>Bintang (1-5)</label><input name="starRating" type="number" min="1" max="5" value="<%= hotel ? hotel.starRating : 3 %>"></div>
      <div><label>Rating (0-10)</label><input name="rating" type="number" step="0.1" value="<%= hotel ? hotel.rating : 8 %>"></div>
    </div>
    <div><label>Jenis Properti</label>
      <% var PT = {HOTEL:'Hotel',VILLA:'Villa',APARTMENT:'Apartemen',HOMESTAY:'Homestay',GUESTHOUSE:'Guesthouse',HOSTEL:'Hostel',RESORT:'Resort'}; %>
      <select name="propertyType">
        <% Object.keys(PT).forEach(function(k){ %><option value="<%= k %>" <%= (hotel && hotel.propertyType===k)?'selected':'' %>><%= PT[k] %></option><% }) %>
      </select>
    </div>
    <label>URL Gambar</label>
    <input name="imageUrl" value="<%= hotel ? hotel.imageUrl : '' %>" placeholder="https://...">
    <div class="row2">
      <div>
        <label>Mitra Pemilik</label>
        <select name="ownerId">
          <option value="">— Tanpa mitra —</option>
          <% users.forEach(function(u){ %>
            <option value="<%= u.id %>" <%= hotel && hotel.owner && hotel.owner.id===u.id ? 'selected':'' %>><%= u.name %> (<%= u.email %>)</option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Promo</label>
        <select name="isPromo">
          <option value="false" <%= hotel && !hotel.isPromo ? 'selected':'' %>>Tidak</option>
          <option value="true" <%= hotel && hotel.isPromo ? 'selected':'' %>>Ya</option>
        </select>
      </div>
    </div>
    <label>Label Promo (opsional)</label>
    <input name="promoLabel" value="<%= hotel && hotel.promoLabel ? hotel.promoLabel : '' %>">

    <div class="nav-label" style="margin-top:20px">Kontrak Modul (di luar Extranet)</div>
    <div class="row2">
      <div>
        <label>Channel Manager</label>
        <select name="productChannelManager">
          <option value="false" <%= hotel && !hotel.productChannelManager ? 'selected':'' %>>Tidak dikontrak</option>
          <option value="true" <%= hotel && hotel.productChannelManager ? 'selected':'' %>>Dikontrak (aktif)</option>
        </select>
      </div>
      <div>
        <label>PMS (Front Desk)</label>
        <select name="productPMS">
          <option value="false" <%= hotel && !hotel.productPMS ? 'selected':'' %>>Tidak dikontrak</option>
          <option value="true" <%= hotel && hotel.productPMS ? 'selected':'' %>>Dikontrak (aktif)</option>
        </select>
      </div>
    </div>
    <p class="muted" style="font-size:11px;margin-top:6px">Extranet aktif otomatis untuk semua mitra. Channel Manager &amp; PMS hanya aktif bila dikontrak — mengatur akses portal chanel.miruum.id &amp; pms.miruum.id.</p>

    <div style="margin-top:22px" class="actions">
      <button class="btn"><%= hotel ? 'Simpan Perubahan' : 'Tambah Hotel' %></button>
      <a class="btn ghost" href="/admin/hotels">Batal</a>
    </div>
    <% if (!hotel) { %>
      <p class="muted" style="font-size:12px;margin:12px 0 0">Setelah <b>Tambah Hotel</b>, Anda langsung diarahkan ke halaman lengkap untuk mengisi <b>Kamar</b>, harga, dan foto (via Extranet). Wilayah wajib dipilih.</p>
    <% } %>
  </form>
</div>

<% if (hotel) { var roomList = (typeof rooms !== 'undefined' && rooms) ? rooms : []; function rp(v){ return 'Rp ' + Number(v||0).toLocaleString('id-ID'); } %>
<div class="card" id="kamar" style="max-width:720px">
  <h2 style="margin:0 0 4px">Kamar (bantu mitra set inventori)</h2>
  <p class="muted" style="margin-top:0;font-size:12px">Sebagai admin Anda bisa menambah/ubah/hapus kamar untuk mitra yang kesulitan. Hotel baru <b>tidak muncul di aplikasi</b> sampai punya minimal 1 kamar berharga.</p>
  <style>
    .rgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;align-items:end;margin-top:10px}
    .rgrid .fld{display:flex;flex-direction:column;min-width:0}
    .rgrid .fld label{margin:0 0 4px;font-size:12px;font-weight:600;color:var(--muted)}
    .rgrid .fld input,.rgrid .fld select{width:100%;box-sizing:border-box}
    .rchecks{display:flex;gap:18px;flex-wrap:wrap;margin:12px 0 0}
    .rchecks label{display:flex;align-items:center;gap:6px;margin:0;font-size:13px}
    .rchecks input{width:auto}
    .rform-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px;align-items:center}
  </style>
  <% if (typeof saved !== 'undefined' && saved==='kamar') { %><div class="notice ok">Kamar tersimpan.</div><% } %>
  <% if (!roomList.length) { %><div class="notice bad">⚠️ Belum ada kamar — hotel ini tidak tampil di aplikasi.</div><% } %>

  <% roomList.forEach(function(r){ %>
    <div style="border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
        <b><%= r.name %></b>
        <span class="muted" style="font-size:12px"><%= rp(r.price) %>/malam · stok <%= r.stock %> · <%= r.capacity %> org</span>
      </div>
      <form method="post" action="/admin/rooms/<%= r.id %>">
        <input type="hidden" name="hotelId" value="<%= hotel.id %>">
        <div class="rgrid">
          <div class="fld"><label>Konfigurasi tempat tidur</label><input name="bedInfo" value="<%= r.bedInfo || '' %>" placeholder="mis. 1 kasur King"></div>
          <div class="fld"><label>Harga/malam (Rp)</label><input name="price" type="number" min="1" value="<%= r.originalPrice && r.originalPrice>r.price ? r.originalPrice : r.price %>"></div>
          <div class="fld"><label>Stok kamar</label><input name="stock" type="number" min="0" value="<%= r.stock %>"></div>
          <div class="fld"><label>Kapasitas (tamu)</label><input name="capacity" type="number" min="1" value="<%= r.capacity %>"></div>
        </div>
        <div class="rchecks">
          <label><input type="checkbox" name="refundable" <%= r.refundable?'checked':'' %>> Refundable</label>
          <label><input type="checkbox" name="breakfast" <%= r.breakfast?'checked':'' %>> Termasuk sarapan</label>
        </div>
        <div class="rform-actions">
          <button class="btn sm">Simpan</button>
        </div>
      </form>
      <!-- Foto kamar (per-room, untuk mapping API) -->
      <% var rphotos = (r.photos||[]); %>
      <div style="margin-top:8px;padding-top:8px;border-top:1px dashed var(--line)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px">
          <b style="font-size:12px">Foto kamar ini <span class="muted" style="font-weight:400">(<%= rphotos.length %>)</span></b>
          <form method="post" action="/admin/hotels/<%= hotel.id %>/photos" enctype="multipart/form-data" style="margin:0">
            <input type="hidden" name="category" value="BEDROOM">
            <input type="hidden" name="roomId" value="<%= r.id %>">
            <label class="btn ghost sm" style="cursor:pointer;margin:0">+ Foto Kamar
              <input type="file" name="photos" accept="image/*" multiple style="display:none" onchange="this.form.submit()">
            </label>
          </form>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <% rphotos.forEach(function(ph){ %>
            <div style="position:relative">
              <img src="<%= ph.url %>" style="width:88px;height:66px;object-fit:cover;border-radius:9px">
              <form method="post" action="/admin/photos/<%= ph.id %>/delete" data-confirm="Hapus foto kamar?" style="position:absolute;top:3px;right:3px;margin:0">
                <button class="btn danger sm" style="padding:1px 7px">×</button>
              </form>
            </div>
          <% }) %>
          <% if (!rphotos.length) { %><span class="muted" style="font-size:11px;align-self:center">Belum ada foto kamar</span><% } %>
        </div>
      </div>
      <form method="post" action="/admin/rooms/<%= r.id %>/delete" data-confirm="Hapus kamar <%= r.name %>?" style="margin-top:8px;display:flex;justify-content:flex-end">
        <input type="hidden" name="hotelId" value="<%= hotel.id %>">
        <button class="btn danger sm">Hapus kamar</button>
      </form>
    </div>
  <% }) %>

  <div style="border:2px dashed var(--brand,#f6883a);border-radius:12px;padding:12px;margin-top:6px">
    <b>+ Tambah Kamar Baru</b>
    <form method="post" action="/admin/hotels/<%= hotel.id %>/rooms">
      <div class="rgrid">
        <div class="fld"><label>Nama tipe kamar *</label><input name="name" placeholder="Deluxe King" required></div>
        <div class="fld"><label>Konfigurasi tempat tidur</label><input name="bedInfo" placeholder="mis. 1 kasur King"></div>
        <div class="fld"><label>Harga/malam (Rp) *</label><input name="price" type="number" min="1" placeholder="500000" required></div>
        <div class="fld"><label>Stok kamar</label><input name="stock" type="number" min="0" value="5"></div>
        <div class="fld"><label>Kapasitas (tamu)</label><input name="capacity" type="number" min="1" value="2"></div>
      </div>
      <div class="rchecks">
        <label><input type="checkbox" name="refundable" checked> Refundable</label>
        <label><input type="checkbox" name="freeCancellation" checked> Gratis batal</label>
        <label><input type="checkbox" name="breakfast"> Termasuk sarapan</label>
      </div>
      <div class="rform-actions"><button class="btn">Tambah Kamar</button></div>
    </form>
  </div>
</div>

<div class="card" id="bedbank" style="max-width:720px">
  <h2 style="margin:0 0 4px">Tautkan ke Sub-agent (Bedbank)</h2>
  <p class="muted" style="margin-top:0;font-size:12px">Jika hotel direct ini juga ada di Hotelbeds, tautkan <b>kode Hotelbeds</b>-nya. Sistem akan <b>menyatukan jadi 1 kartu</b> di pencarian (dedup) dan menggabungkan harga di detail (Increment berikutnya). Gunakan <b>Cari kandidat</b> untuk pencocokan otomatis via nama + GPS.</p>
  <form method="post" action="/admin/hotels/<%= hotel.id %>/bedbank-map" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
    <div><label style="margin:0 0 4px">Kode Hotelbeds</label><input id="bbCode" name="bedbankCode" value="<%= hotel.bedbankCode || '' %>" placeholder="mis. 108108" style="max-width:200px"></div>
    <button class="btn sm">Simpan Tautan</button>
    <button type="button" class="btn ghost sm" id="bbSuggest" data-id="<%= hotel.id %>">🔎 Cari kandidat</button>
  </form>
  <div id="bbResults" style="margin-top:10px"></div>
</div>

<div class="card" id="foto" style="max-width:720px">
  <h2 style="margin:0 0 4px">Foto Hotel (berkategori)</h2>
  <p class="muted" style="margin-top:0;font-size:12px">Bantu mitra melengkapi galeri. Foto dipisah per kategori (Gedung, Lobby, Kamar, dll) &amp; bisa unggah banyak sekaligus. Foto khusus kamar diatur di kartu <b>Kamar</b> di atas.</p>
  <% if (typeof saved !== 'undefined' && saved==='foto') { %><div class="notice ok">Foto tersimpan.</div><% } %>
  <%- include('../partials/photo_manager', { prefix: '/admin', hotel: hotel, showCover: true }) %>
  <a class="btn ghost" href="/admin/hotels" style="margin-top:12px">← Daftar Hotel</a>
</div>
<% } %>

<script>
(function(){
  var f=document.getElementById('hotelForm');
  if(!f) return;
  f.addEventListener('submit', function(e){
    var rid=f.querySelector('.rp-id');
    if(rid && !rid.value){
      e.preventDefault();
      if(window.mToast) window.mToast('error','Wilayah wajib dipilih — properti tidak akan muncul di pencarian area.');
      var prov=f.querySelector('.rp-prov'); if(prov){ prov.focus(); prov.scrollIntoView({behavior:'smooth',block:'center'}); }
    }
  });
})();
// Bedbank auto-match suggestions
(function(){
  var btn=document.getElementById('bbSuggest'); if(!btn) return;
  var box=document.getElementById('bbResults'), input=document.getElementById('bbCode');
  btn.addEventListener('click', function(){
    box.innerHTML='<span class="muted" style="font-size:12px">Mencari kandidat di Hotelbeds…</span>';
    fetch('/admin/hotels/'+btn.dataset.id+'/bedbank-suggest',{headers:{'accept':'application/json'}})
      .then(function(r){return r.json();})
      .then(function(d){
        if(d.note){ box.innerHTML='<div class="muted" style="font-size:12px">'+d.note+'</div>'; }
        var c=d.candidates||[];
        if(!c.length){ if(!d.note) box.innerHTML='<div class="muted" style="font-size:12px">Tidak ada kandidat ditemukan.</div>'; return; }
        var html='<div style="font-size:12px;color:var(--muted);margin-bottom:6px">Kandidat (nama + jarak GPS):</div>';
        c.forEach(function(x){
          var rp = x.minRateIdr!=null ? ' · dari Rp '+Number(x.minRateIdr).toLocaleString('id-ID') : '';
          html+='<div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);font-size:12.5px">'
            +'<div style="flex:1"><b>'+(x.name||'-')+'</b> <span class="muted">('+(x.category||'')+')</span><br>'
            +'<span class="muted">kode '+x.supplierHotelCode+(x.distanceKm!=null?(' · '+x.distanceKm+' km'):'')+' · kecocokan nama '+(x.nameScore||0)+'%'+rp+'</span></div>'
            +'<button type="button" class="btn sm" data-code="'+x.supplierHotelCode+'">Pakai</button></div>';
        });
        box.innerHTML=html;
        box.querySelectorAll('button[data-code]').forEach(function(b){ b.addEventListener('click', function(){ input.value=b.dataset.code; input.scrollIntoView({behavior:'smooth',block:'center'}); if(window.mToast) window.mToast('success','Kode terisi — klik Simpan Tautan.'); }); });
      })
      .catch(function(){ box.innerHTML='<div class="muted" style="font-size:12px">Gagal memuat kandidat.</div>'; });
  });
})();
</script>

<%- include('../partials/bottom') %>
