<%- include('../partials/top', { title:'Promo', heading:'Kelola Promo', section:'admin', active:'promos', me }) %>

<% if (saved==='1') { %><div class="card" style="background:#EAF7EE;color:#1c7a3f">✓ Promo disimpan.</div><% } %>
<% if (saved==='err') { %><div class="card" style="background:#FDE7E7;color:#b02a2a">✗ Gagal — kode mungkin sudah ada.</div><% } %>

<div class="card">
  <h3>Tambah Promo</h3>
  <form method="post" action="/admin/promos">
    <div class="row2">
      <div><label>Kode</label><input name="code" placeholder="MIRUUM30" required></div>
      <div><label>Diskon (%)</label><input name="discountPct" type="number" min="1" max="100" required></div>
    </div>
    <label>Judul</label><input name="title" placeholder="Save up to 30%" required>
    <label>Deskripsi</label><input name="description" placeholder="Diskon untuk hotel pilihan">
    <label>URL Gambar (opsional)</label><input name="imageUrl" placeholder="https://...">
    <div style="margin-top:16px"><button class="btn">➕ Simpan Promo</button></div>
  </form>
</div>

<div class="card">
  <h3>Daftar Promo</h3>
  <table>
    <thead><tr><th>Kode</th><th>Judul</th><th>Diskon</th><th>Aksi</th></tr></thead>
    <tbody>
      <% promos.forEach(function(p){ %>
        <tr>
          <td><b><%= p.code %></b></td>
          <td><%= p.title %></td>
          <td><span class="pill PARTNER"><%= p.discountPct %>%</span></td>
          <td><form method="post" action="/admin/promos/<%= p.id %>/delete" onsubmit="return confirm('Hapus promo <%= p.code %>?')"><button class="btn danger sm">Hapus</button></form></td>
        </tr>
      <% }) %>
      <% if (!promos.length) { %><tr><td colspan="4" class="empty">Belum ada promo</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
