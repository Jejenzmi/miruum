<%- include('../partials/top', { title:'Keuangan', heading:'Keuangan & Settlement', section:'admin', active:'finance', me }) %>

<div class="stat-grid">
  <div class="stat"><div class="icon" style="background:var(--blue-s);color:#2563EB"><svg class="ci"><use href="#i-bookings"/></svg></div><div class="label">Total Transaksi (paid)</div><div class="value"><%= finance.totalBookings %></div></div>
  <div class="stat"><div class="icon" style="background:var(--green-s);color:var(--green-d)"><svg class="ci"><use href="#i-finance"/></svg></div><div class="label">Gross Value</div><div class="value" style="font-size:19px"><%= rupiah(finance.totalGross) %></div></div>
  <div class="stat"><div class="icon" style="background:var(--primary-s);color:var(--primary-d)"><svg class="ci"><use href="#i-trend"/></svg></div><div class="label">Pendapatan Miruum</div><div class="value" style="font-size:19px;color:var(--primary-d)"><%= rupiah(finance.totalRevenue) %></div></div>
  <div class="stat"><div class="icon" style="background:var(--accent-s);color:#b8791a"><svg class="ci"><use href="#i-box"/></svg></div><div class="label">Payout ke Hotel (DIRECT)</div><div class="value" style="font-size:19px"><%= rupiah(finance.totalHotelPayout) %></div></div>
</div>

<% if (claimDone) { %><div class="notice ok">Klaim pencairan <%= claimDone==='paid'?'dibayar & dicatat sebagai settlement':'ditolak' %>.</div><% } %>

<div class="card">
  <h3 style="margin:0 0 6px">Klaim Pencairan Mitra</h3>
  <p class="muted" style="font-size:12px;margin:0 0 12px">Pengajuan pencairan dari hotel mitra. Bayar untuk mencatat settlement otomatis.</p>
  <table>
    <thead><tr><th>Tanggal</th><th>Hotel · Mitra</th><th>Jumlah</th><th>Rekening Tujuan</th><th>Status</th><th>Aksi</th></tr></thead>
    <tbody>
      <% (claims||[]).forEach(function(c){ %>
        <tr>
          <td style="font-size:12px"><%= new Date(c.createdAt).toLocaleDateString('id-ID',{day:'2-digit',month:'short'}) %></td>
          <td><b><%= c.hotel.name %></b><br><span class="muted" style="font-size:11px"><%= c.hotel.owner ? c.hotel.owner.name : '—' %></span></td>
          <td><b><%= rupiah(c.amount) %></b></td>
          <td style="font-size:12px"><%= c.bankName || '—' %> <%= c.bankAccount || '' %><% if (c.accountHolder) { %><br><span class="muted"><%= c.accountHolder %></span><% } %></td>
          <td><span class="pill <%= c.status==='PAID'?'PAID':c.status==='REJECTED'?'CANCELLED':'PENDING' %>"><%= c.status==='PAID'?'Dibayar':c.status==='REJECTED'?'Ditolak':'Menunggu' %></span></td>
          <td>
            <% if (c.status==='PENDING') { %>
              <div class="actions">
                <form method="post" action="/admin/claims/<%= c.id %>/pay" data-confirm="Bayar pencairan <%= rupiah(c.amount) %> ke <%= c.hotel.name %>?" data-confirm-ok="Ya, bayar"><button class="btn sm">Bayar</button></form>
                <form method="post" action="/admin/claims/<%= c.id %>/reject" data-confirm="Tolak klaim ini?"><button class="btn danger sm">Tolak</button></form>
              </div>
            <% } else { %><span class="muted">—</span><% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!(claims||[]).length) { %><tr><td colspan="6" class="empty">Belum ada klaim pencairan</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h3 style="margin:0 0 12px">Pendapatan per Sumber</h3>
  <table>
    <thead><tr><th>Sumber</th><th>Tipe</th><th>Transaksi</th><th>Gross</th><th>Pendapatan Miruum</th></tr></thead>
    <tbody>
      <% finance.byChannel.forEach(function(c){ %>
        <tr>
          <td><b><%= c.name %></b></td>
          <td><span class="pill" style="background:#eee;color:#555"><%= c.type %></span></td>
          <td><%= c.bookings %></td>
          <td><%= rupiah(c.gross) %></td>
          <td><b style="color:#E07C17"><%= rupiah(c.revenue) %></b></td>
        </tr>
      <% }) %>
      <% if (!finance.byChannel.length) { %><tr><td colspan="5" class="empty">Belum ada transaksi</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h3 style="margin:0 0 6px">Payout ke Hotel DIRECT</h3>
  <p class="muted" style="font-size:12px;margin:0 0 12px">Sisa yang harus dibayarkan ke hotel (harga kamar dikurangi komisi platform Miruum).</p>
  <table>
    <thead><tr><th>Hotel</th><th>Transaksi</th><th>Total Payout</th><th>Sudah Dibayar</th><th>Sisa (Due)</th><th>Aksi</th></tr></thead>
    <tbody>
      <% finance.payouts.forEach(function(p){ %>
        <tr>
          <td><b><%= p.name %></b></td>
          <td><%= p.bookings %></td>
          <td><%= rupiah(p.payout) %></td>
          <td><%= rupiah(p.settled) %></td>
          <td><b style="color:<%= p.due>0?'#b02a2a':'#1c7a3f' %>"><%= rupiah(p.due) %></b></td>
          <td>
            <% if (p.due>0){ %>
              <form method="post" action="/admin/settlements/pay" data-confirm="Catat payout <%= rupiah(p.due) %> ke <%= p.name %>?">
                <input type="hidden" name="hotelId" value="<%= p.hotelId %>">
                <input type="hidden" name="amount" value="<%= p.due %>">
                <input type="hidden" name="bookingsCount" value="<%= p.bookings %>">
                <button class="btn sm">Tandai Lunas</button>
              </form>
            <% } else { %><span class="muted">—</span><% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!finance.payouts.length) { %><tr><td colspan="6" class="empty">Belum ada payout</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h3 style="margin:0 0 12px">Riwayat Payout</h3>
  <table>
    <thead><tr><th>Tanggal</th><th>Hotel</th><th>Jumlah</th><th>Transaksi</th></tr></thead>
    <tbody>
      <% settlements.forEach(function(s){ %>
        <tr>
          <td><%= new Date(s.createdAt).toLocaleDateString('id-ID') %></td>
          <td><%= s.hotel.name %></td>
          <td><b><%= rupiah(s.amount) %></b></td>
          <td><%= s.bookingsCount %></td>
        </tr>
      <% }) %>
      <% if (!settlements.length) { %><tr><td colspan="4" class="empty">Belum ada payout tercatat</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
