<%- include('../partials/top', { title:'Neraca', heading:'Neraca (Balance Sheet)', section:'extranet', active:'gl_bs', me }) %>

<div class="card" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
  <form method="get" action="/pms/gl/balance-sheet" style="display:flex;gap:8px;align-items:center;margin:0">
    <label style="margin:0">Per tanggal</label><input type="date" name="asOf" value="<%= q.asOf || '' %>" style="width:auto">
    <button class="btn sm">Tampilkan</button>
  </form>
  <form method="post" action="/pms/gl/rebuild" style="margin:0"><input type="hidden" name="back" value="/pms/gl/balance-sheet"><button class="btn ghost sm">↻ Posting</button></form>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="bsgrid">
  <div class="card">
    <h3 style="margin-top:0">Aktiva (Aset)</h3>
    <table><tbody>
      <% (assets||[]).forEach(function(r){ %><tr><td><code><%= r.code %></code> <%= r.name %></td><td style="text-align:right"><%= rupiah(r.balance) %></td></tr><% }) %>
      <% if(!(assets||[]).length){ %><tr><td class="empty" colspan="2">—</td></tr><% } %>
    </tbody>
    <tfoot><tr style="font-weight:800;border-top:2px solid #20262e"><td>Total Aktiva</td><td style="text-align:right"><%= rupiah(totalAssets) %></td></tr></tfoot>
    </table>
  </div>
  <div class="card">
    <h3 style="margin-top:0">Pasiva (Kewajiban &amp; Ekuitas)</h3>
    <table><tbody>
      <tr><td colspan="2" class="muted" style="font-weight:700">Kewajiban</td></tr>
      <% (liabilities||[]).forEach(function(r){ %><tr><td style="padding-left:16px"><code><%= r.code %></code> <%= r.name %></td><td style="text-align:right"><%= rupiah(r.balance) %></td></tr><% }) %>
      <% if(!(liabilities||[]).length){ %><tr><td style="padding-left:16px" class="muted">—</td><td style="text-align:right">Rp 0</td></tr><% } %>
      <tr><td colspan="2" class="muted" style="font-weight:700;padding-top:8px">Ekuitas</td></tr>
      <% (equity||[]).forEach(function(r){ %><tr><td style="padding-left:16px"><code><%= r.code %></code> <%= r.name %></td><td style="text-align:right"><%= rupiah(r.balance) %></td></tr><% }) %>
      <tr><td style="padding-left:16px">Laba/Rugi Berjalan</td><td style="text-align:right"><%= rupiah(currentEarnings) %></td></tr>
    </tbody>
    <tfoot><tr style="font-weight:800;border-top:2px solid #20262e"><td>Total Pasiva</td><td style="text-align:right"><%= rupiah(totalLiabilities + totalEquity) %></td></tr></tfoot>
    </table>
  </div>
</div>

<div class="card" style="margin-top:16px">
  <% if (balanced) { %><span style="background:#E4F5EC;color:#1E7A4D;padding:4px 10px;border-radius:6px;font-weight:700">✓ Neraca seimbang — Aktiva = Kewajiban + Ekuitas (<%= rupiah(totalAssets) %>)</span>
  <% } else { %><span style="background:#FCE8EE;color:#B5335C;padding:4px 10px;border-radius:6px;font-weight:700">⚠ Tidak seimbang: Aktiva <%= rupiah(totalAssets) %> ≠ Pasiva <%= rupiah(totalLiabilities + totalEquity) %></span><% } %>
</div>

<%- include('../partials/bottom') %>
