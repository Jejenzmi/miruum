<%- include('../partials/top', { title:'POS', heading:'POS Terminal', section:'extranet', active:'pos', me }) %>

<% if (saved==='1') { %><div class="notice ok">Pesanan diposting ke folio kamar.</div><% } %>
<% if (saved==='err') { %><div class="notice bad">Gagal — pastikan tamu sedang menginap & keranjang tidak kosong.</div><% } %>

<% if (!(rooms||[]).length) { %>
  <div class="card"><div class="empty">Belum ada tamu in-house dengan kamar ditetapkan. Lakukan check-in + assign kamar dulu.</div></div>
<% } else { %>

<div class="pos-wrap">
  <!-- Left: outlet + menu -->
  <div>
    <div class="card" style="margin-bottom:12px">
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
          <label style="margin-top:0">Kamar / Tamu</label>
          <select id="pos-room" style="font-weight:700"><% rooms.forEach(function(r){ %><option value="<%= r.bookingId %>">Kamar <%= r.roomNumber %> — <%= r.guest %></option><% }) %></select>
        </div>
        <div class="pos-tabs" id="pos-tabs"><% outlets.forEach(function(o,i){ %><button type="button" class="pos-tab <%= i===0?'on':'' %>" data-outlet="<%= o %>"><%= o %></button><% }) %></div>
      </div>
    </div>
    <div class="card">
      <div id="pos-menu" class="pos-grid"></div>
      <div style="margin-top:14px;border-top:1px dashed var(--line);padding-top:12px">
        <div class="muted" style="font-size:12px;margin-bottom:6px">Item khusus (di luar menu)</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end">
          <div style="flex:2;min-width:130px"><input id="c-name" placeholder="Nama item"></div>
          <div><input id="c-price" type="number" placeholder="Harga"></div>
          <button type="button" class="btn ghost sm" onclick="addCustom()">+ Tambah</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: cart -->
  <div class="card pos-cart">
    <h3 style="margin-top:0">Keranjang <span id="cart-outlet" class="muted" style="font-weight:400;font-size:13px"></span></h3>
    <div id="cart-lines"></div>
    <div class="pos-total"><span>Total</span><b id="cart-total">Rp 0</b></div>
    <form method="post" action="/pms/pos/charge-cart" onsubmit="return submitCart()">
      <input type="hidden" name="bookingId" id="f-room"><input type="hidden" name="outlet" id="f-outlet"><input type="hidden" name="itemsJson" id="f-items">
      <button class="btn" id="charge-btn" style="width:100%;margin-top:12px" disabled>Charge ke Folio Kamar</button>
    </form>
    <p class="muted" style="font-size:11.5px;margin:10px 0 0;line-height:1.5">Charge otomatis masuk ke folio kamar & dibayar saat check-out. Terminal POS asli tinggal panggil <code>/api/partner/pos/charge-cart</code>.</p>
  </div>
</div>

<script>
  var MENU = <%- JSON.stringify(menu || {}) %>;
  var cart = {}, outlet = <%- JSON.stringify((outlets&&outlets[0])||'') %>;
  var fmt = function(n){ return 'Rp ' + (n||0).toLocaleString('id-ID'); };
  var menuBox=document.getElementById('pos-menu'), linesBox=document.getElementById('cart-lines');
  function renderMenu(){
    document.getElementById('cart-outlet').textContent = '· ' + outlet;
    var items = MENU[outlet] || [];
    menuBox.innerHTML = items.map(function(it,idx){
      return '<button type="button" class="pos-item" onclick="add(\''+outlet+'\','+idx+')"><div class="pi-name">'+it.name+'</div><div class="pi-price">'+fmt(it.price)+'</div></button>';
    }).join('') || '<p class="muted">Tidak ada menu.</p>';
  }
  function key(name){ return outlet+'|'+name; }
  function add(o,idx){ var it=MENU[o][idx]; bump(it.name, it.price, 1); }
  function addCustom(){ var n=document.getElementById('c-name').value.trim(), p=parseInt(document.getElementById('c-price').value||'0',10); if(!n||p<=0){alert('Isi nama & harga.');return;} bump(n,p,1); document.getElementById('c-name').value='';document.getElementById('c-price').value=''; }
  function bump(name,price,d){ var k=key(name); if(!cart[k]) cart[k]={name:name,price:price,qty:0,outlet:outlet}; cart[k].qty+=d; if(cart[k].qty<=0) delete cart[k]; renderCart(); }
  function renderCart(){
    var keys=Object.keys(cart), total=0;
    linesBox.innerHTML = keys.map(function(k){ var c=cart[k]; total+=c.price*c.qty;
      return '<div class="pos-line"><div style="flex:1"><div style="font-weight:600;font-size:13px">'+c.name+'</div><div class="muted" style="font-size:11px">'+fmt(c.price)+' · '+c.outlet+'</div></div>'+
        '<div class="pos-qty"><button type="button" onclick="bumpKey(\''+k.replace(/'/g,"\\'")+'\',-1)">−</button><span>'+c.qty+'</span><button type="button" onclick="bumpKey(\''+k.replace(/'/g,"\\'")+'\',1)">+</button></div>'+
        '<div style="width:90px;text-align:right;font-weight:700">'+fmt(c.price*c.qty)+'</div></div>';
    }).join('') || '<p class="muted" style="font-size:13px">Keranjang kosong — pilih item dari menu.</p>';
    document.getElementById('cart-total').textContent=fmt(total);
    document.getElementById('charge-btn').disabled = keys.length===0;
  }
  function bumpKey(k,d){ if(!cart[k])return; cart[k].qty+=d; if(cart[k].qty<=0) delete cart[k]; renderCart(); }
  function submitCart(){
    var keys=Object.keys(cart); if(!keys.length){alert('Keranjang kosong.');return false;}
    // Group by outlet — post the dominant outlet's items (cart may mix). Send all items with their own outlet is not supported; charge per outlet.
    var byOutlet={}; keys.forEach(function(k){ var c=cart[k]; (byOutlet[c.outlet]=byOutlet[c.outlet]||[]).push({name:c.name,price:c.price,qty:c.qty}); });
    var outs=Object.keys(byOutlet);
    document.getElementById('f-room').value=document.getElementById('pos-room').value;
    document.getElementById('f-outlet').value=outs[0];
    document.getElementById('f-items').value=JSON.stringify(byOutlet[outs[0]]);
    if(outs.length>1){ alert('Keranjang berisi beberapa outlet — hanya "'+outs[0]+'" yang diposting kali ini. Charge outlet lain terpisah.'); }
    return true;
  }
  document.querySelectorAll('.pos-tab').forEach(function(b){ b.addEventListener('click', function(){ document.querySelectorAll('.pos-tab').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); outlet=b.getAttribute('data-outlet'); renderMenu(); renderCart(); }); });
  renderMenu(); renderCart();
</script>

<style>
  .pos-wrap{display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start}
  @media(max-width:820px){.pos-wrap{grid-template-columns:1fr}}
  .pos-tabs{display:flex;gap:6px;flex-wrap:wrap}
  .pos-tab{padding:7px 12px;border:1px solid var(--line);background:#fff;border-radius:20px;font-weight:600;font-size:13px;cursor:pointer}
  .pos-tab.on{background:#E07C17;color:#fff;border-color:#E07C17}
  .pos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
  .pos-item{border:1px solid #ececf0;border-radius:12px;padding:12px;background:#fff;text-align:left;cursor:pointer;transition:.12s}
  .pos-item:hover{border-color:#E07C17;box-shadow:0 2px 8px rgba(224,124,23,.15);transform:translateY(-1px)}
  .pi-name{font-weight:700;font-size:13px;margin-bottom:6px;line-height:1.3}.pi-price{color:#E07C17;font-weight:700;font-size:13px}
  .pos-cart{position:sticky;top:16px}
  .pos-line{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #f2f2f4}
  .pos-qty{display:flex;align-items:center;gap:6px}
  .pos-qty button{width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;font-weight:800;cursor:pointer;font-size:15px;line-height:1}
  .pos-qty span{min-width:20px;text-align:center;font-weight:700}
  .pos-total{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:2px solid #20262e;font-size:17px}
</style>
<% } %>

<%- include('../partials/bottom') %>
