<%- include('../partials/top', { title:'POS', heading:'POS Terminal', section:'extranet', active:'pos', me }) %>

<% if (saved==='1') { %><div class="notice ok">Transaksi POS tersimpan.</div><% } %>
<% if (saved==='err') { %><div class="notice bad">Gagal — cek keranjang / tamu in-house / metode.</div><% } %>
<% if (usingDefault) { %><div class="notice" style="background:#fff8ef;border:1px solid #f0e0c8">Menu masih contoh bawaan. <a href="/pms/pos/menu"><b>Kelola Menu</b></a> untuk atur produk & harga sendiri.</div><% } %>

<div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:10px">
  <a class="btn ghost sm" href="/pms/pos/menu">Kelola Menu</a>
  <a class="btn ghost sm" href="/pms/pos/report">Laporan POS</a>
</div>

<div class="pos-wrap">
  <div>
    <div class="card" style="margin-bottom:12px">
      <div class="pos-tabs" id="pos-tabs"><% outlets.forEach(function(o,i){ %><button type="button" class="pos-tab <%= i===0?'on':'' %>" data-outlet="<%= o %>"><%= o %></button><% }) %></div>
    </div>
    <div class="card">
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;background:#fff8ef;border:1px solid #f0e0c8;border-radius:12px;padding:8px 10px">
        <svg viewBox="0 0 24 24" style="width:22px;height:22px;flex-shrink:0" fill="none" stroke="#E07C17" stroke-width="2"><path d="M3 7V4h3M21 7V4h-3M3 17v3h3M21 17v3h-3M7 8v8M11 8v8M15 8v8"/></svg>
        <input id="pos-scan" autocomplete="off" placeholder="Scan barcode produk (EZcode/HID) → otomatis masuk keranjang"
               style="flex:1;background:transparent;border:0;outline:none;font-weight:600"
               onkeydown="if(event.key==='Enter'){event.preventDefault();scanBarcode(this.value);this.value='';}">
      </div>
      <div id="pos-menu" class="pos-grid"></div>
      <div style="margin-top:14px;border-top:1px dashed var(--line);padding-top:12px">
        <div class="muted" style="font-size:12px;margin-bottom:6px">Item khusus (di luar menu)</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end">
          <div style="flex:2;min-width:130px"><input id="c-name" placeholder="Nama item"></div>
          <div><input id="c-price" type="number" placeholder="Harga"></div>
          <button type="button" class="btn ghost sm" onclick="addCustom()">+ Tambah</button>
        </div>
      </div>
    </div>
  </div>

  <div class="card pos-cart">
    <h3 style="margin-top:0">Keranjang <span id="cart-outlet" class="muted" style="font-weight:400;font-size:13px"></span></h3>
    <!-- Settle toggle -->
    <div class="seg" style="margin-bottom:10px">
      <button type="button" class="seg-b on" data-settle="ROOM" onclick="setSettle('ROOM')">Charge ke Kamar</button>
      <button type="button" class="seg-b" data-settle="DIRECT" onclick="setSettle('DIRECT')">Bayar Langsung</button>
    </div>
    <div id="settle-room">
      <% if ((rooms||[]).length) { %>
        <label style="margin-top:0">Kamar / Tamu</label>
        <select id="pos-room" style="font-weight:700"><% rooms.forEach(function(r){ %><option value="<%= r.bookingId %>">Kamar <%= r.roomNumber %> — <%= r.guest %></option><% }) %></select>
      <% } else { %><p class="muted" style="font-size:13px">Tidak ada tamu in-house. Gunakan <b>Bayar Langsung</b> untuk pelanggan umum.</p><% } %>
    </div>
    <div id="settle-direct" style="display:none">
      <div class="row2">
        <div><label style="margin-top:0">Metode</label><select id="pos-method"><% ['CASH','QRIS','CARD','EWALLET','TRANSFER'].forEach(function(m){ %><option value="<%= m %>"><%= m %></option><% }) %></select></div>
        <div><label style="margin-top:0">Nama (opsional)</label><input id="pos-cust" placeholder="Pelanggan"></div>
      </div>
      <% if ((hotels||[]).length>1) { %><label style="margin-top:8px">Hotel</label><select id="pos-hotel"><% hotels.forEach(function(h){ %><option value="<%= h.id %>"><%= h.name %></option><% }) %></select><% } %>
    </div>

    <div id="cart-lines" style="margin-top:10px"></div>
    <div class="pos-total"><span>Total</span><b id="cart-total">Rp 0</b></div>
    <form method="post" action="/pms/pos/sale" onsubmit="return submitCart()">
      <input type="hidden" name="settle" id="f-settle" value="ROOM">
      <input type="hidden" name="bookingId" id="f-room"><input type="hidden" name="outlet" id="f-outlet">
      <input type="hidden" name="hotelId" id="f-hotel" value="<%= hotelId || '' %>"><input type="hidden" name="method" id="f-method"><input type="hidden" name="customerName" id="f-cust">
      <input type="hidden" name="itemsJson" id="f-items">
      <button class="btn" id="charge-btn" style="width:100%;margin-top:12px" disabled>Proses</button>
    </form>
  </div>
</div>

<script>
  var MENU = <%- JSON.stringify(menu || {}) %>;
  var cart = {}, outlet = <%- JSON.stringify((outlets&&outlets[0])||'') %>, settle='ROOM';
  var fmt = function(n){ return 'Rp ' + (n||0).toLocaleString('id-ID'); };
  var menuBox=document.getElementById('pos-menu'), linesBox=document.getElementById('cart-lines');
  function renderMenu(){
    document.getElementById('cart-outlet').textContent = '· ' + outlet;
    var items = MENU[outlet] || [];
    menuBox.innerHTML = items.map(function(it,idx){ return '<button type="button" class="pos-item" onclick="add(\''+outlet+'\','+idx+')"><div class="pi-name">'+it.name+'</div><div class="pi-price">'+fmt(it.price)+'</div></button>'; }).join('') || '<p class="muted">Belum ada item di outlet ini.</p>';
  }
  function setSettle(s){ settle=s; document.querySelectorAll('.seg-b').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-settle')===s); }); document.getElementById('settle-room').style.display = s==='ROOM'?'':'none'; document.getElementById('settle-direct').style.display = s==='DIRECT'?'':'none'; updateBtn(); }
  function key(name){ return outlet+'|'+name; }
  function add(o,idx){ var it=MENU[o][idx]; bump(it.name,it.price); }
  function addCustom(){ var n=document.getElementById('c-name').value.trim(), p=parseInt(document.getElementById('c-price').value||'0',10); if(!n||p<=0){alert('Isi nama & harga.');return;} bump(n,p); document.getElementById('c-name').value='';document.getElementById('c-price').value=''; }
  function bump(name,price){ var k=key(name); if(!cart[k]) cart[k]={name:name,price:price,qty:0,outlet:outlet}; cart[k].qty++; renderCart(); }
  // Barcode scan (EZcode/HID types the code + Enter) → find product across outlets → add.
  function scanBarcode(code){
    code=(code||'').trim(); if(!code) return;
    var found=null, fo=null;
    Object.keys(MENU).forEach(function(o){ (MENU[o]||[]).forEach(function(it){ if(it.barcode && String(it.barcode).trim()===code){ found=it; fo=o; } }); });
    if(!found){ alert('Barcode tidak dikenal: '+code); return; }
    var k=fo+'|'+found.name; if(!cart[k]) cart[k]={name:found.name,price:found.price,qty:0,outlet:fo}; cart[k].qty++; renderCart();
  }
  function bumpKey(k,d){ if(!cart[k])return; cart[k].qty+=d; if(cart[k].qty<=0) delete cart[k]; renderCart(); }
  function renderCart(){
    var keys=Object.keys(cart), total=0;
    linesBox.innerHTML = keys.map(function(k){ var c=cart[k]; total+=c.price*c.qty;
      return '<div class="pos-line"><div style="flex:1"><div style="font-weight:600;font-size:13px">'+c.name+'</div><div class="muted" style="font-size:11px">'+fmt(c.price)+' · '+c.outlet+'</div></div><div class="pos-qty"><button type="button" onclick="bumpKey(\''+k.replace(/\'/g,"\\'")+'\',-1)">−</button><span>'+c.qty+'</span><button type="button" onclick="bumpKey(\''+k.replace(/\'/g,"\\'")+'\',1)">+</button></div><div style="width:90px;text-align:right;font-weight:700">'+fmt(c.price*c.qty)+'</div></div>';
    }).join('') || '<p class="muted" style="font-size:13px">Keranjang kosong.</p>';
    document.getElementById('cart-total').textContent=fmt(total); updateBtn();
  }
  function updateBtn(){ var has=Object.keys(cart).length>0; var okRoom = settle==='DIRECT' || document.getElementById('pos-room'); document.getElementById('charge-btn').disabled = !has || !okRoom; document.getElementById('charge-btn').textContent = settle==='ROOM'?'Charge ke Folio Kamar':'Terima Pembayaran'; }
  function submitCart(){
    var keys=Object.keys(cart); if(!keys.length){alert('Keranjang kosong.');return false;}
    var byOutlet={}; keys.forEach(function(k){ var c=cart[k]; (byOutlet[c.outlet]=byOutlet[c.outlet]||[]).push({name:c.name,price:c.price,qty:c.qty}); });
    var outs=Object.keys(byOutlet);
    document.getElementById('f-settle').value=settle; document.getElementById('f-outlet').value=outs[0]; document.getElementById('f-items').value=JSON.stringify(byOutlet[outs[0]]);
    if(settle==='ROOM'){ var rs=document.getElementById('pos-room'); if(!rs){alert('Tidak ada kamar in-house.');return false;} document.getElementById('f-room').value=rs.value; }
    else { document.getElementById('f-method').value=document.getElementById('pos-method').value; document.getElementById('f-cust').value=document.getElementById('pos-cust').value; var hs=document.getElementById('pos-hotel'); if(hs) document.getElementById('f-hotel').value=hs.value; }
    if(outs.length>1) alert('Keranjang campur outlet — hanya "'+outs[0]+'" diproses kali ini.');
    return true;
  }
  document.querySelectorAll('.pos-tab').forEach(function(b){ b.addEventListener('click', function(){ document.querySelectorAll('.pos-tab').forEach(function(x){x.classList.remove('on');}); b.classList.add('on'); outlet=b.getAttribute('data-outlet'); renderMenu(); }); });
  renderMenu(); renderCart();
</script>

<style>
  .pos-wrap{display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start}
  @media(max-width:820px){.pos-wrap{grid-template-columns:1fr}}
  .pos-tabs{display:flex;gap:6px;flex-wrap:wrap}
  .pos-tab{padding:7px 12px;border:1px solid var(--line);background:#fff;border-radius:20px;font-weight:600;font-size:13px;cursor:pointer}
  .pos-tab.on{background:#E07C17;color:#fff;border-color:#E07C17}
  .pos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
  .pos-item{border:1px solid #ececf0;border-radius:12px;padding:12px;background:#fff;text-align:left;cursor:pointer;transition:.12s}
  .pos-item:hover{border-color:#E07C17;box-shadow:0 2px 8px rgba(224,124,23,.15);transform:translateY(-1px)}
  .pi-name{font-weight:700;font-size:13px;margin-bottom:6px;line-height:1.3}.pi-price{color:#E07C17;font-weight:700;font-size:13px}
  .pos-cart{position:sticky;top:16px}
  .pos-line{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #f2f2f4}
  .pos-qty{display:flex;align-items:center;gap:6px}
  .pos-qty button{width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;font-weight:800;cursor:pointer;font-size:15px;line-height:1}
  .pos-qty span{min-width:20px;text-align:center;font-weight:700}
  .pos-total{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:2px solid #20262e;font-size:17px}
  .seg{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .seg-b{flex:1;padding:8px;background:#fff;border:0;cursor:pointer;font-weight:600;font-size:13px}
  .seg-b.on{background:#20262e;color:#fff}
</style>

<%- include('../partials/bottom') %>
