<%- include('../partials/top', { title:'Kasir', heading:'Kasir / Cash Drawer', section:'extranet', active:'cashier', me }) %>

<% if (done==='open') { %><div class="notice ok">Shift dibuka.</div><% } %>
<% if (done==='close') { %><div class="notice ok">Shift ditutup — variance dihitung.</div><% } %>
<% if (err) { %><div class="notice bad"><%= err %></div><% } %>
<% function dt(d){ return d? new Date(d).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; } %>

<% if (open) { %>
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <div><h2 style="margin:0">Shift Terbuka</h2><p class="muted" style="margin:2px 0 0">Dibuka <%= dt(open.openedAt) %> · Modal awal <b><%= rupiah(open.openingFloat) %></b></p></div>
      <span class="pill PAID">OPEN</span>
    </div>
    <div class="stat-row" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px">
      <div class="stat"><div class="label">Transaksi</div><div class="value"><%= tally.count %></div></div>
      <div class="stat"><div class="label">Total Diterima</div><div class="value" style="font-size:18px"><%= rupiah(tally.total) %></div></div>
      <div class="stat"><div class="label">Perkiraan Kas (drawer)</div><div class="value" style="font-size:18px"><%= rupiah(tally.expectedCash) %></div></div>
    </div>
    <% var keys=Object.keys(tally.byMethod||{}); if(keys.length){ %>
      <table style="margin-top:12px"><thead><tr><th>Metode</th><th style="text-align:right">Jumlah</th></tr></thead><tbody>
        <% keys.forEach(function(k){ %><tr><td><%= k %></td><td style="text-align:right"><%= rupiah(tally.byMethod[k]) %></td></tr><% }) %>
      </tbody></table>
    <% } else { %><p class="muted" style="margin-top:10px">Belum ada pembayaran pada shift ini.</p><% } %>

    <h3 style="margin:16px 0 8px">Tutup Shift (hitung kas)</h3>
    <form method="post" action="/pms/cashier/close" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap" data-confirm="Tutup shift & hitung selisih kas?" data-confirm-title="Tutup Shift">
      <div><label style="margin-top:0">Uang kas terhitung (Rp)</label><input name="closingCounted" type="number" min="0" required placeholder="hitung fisik laci"></div>
      <div style="flex:1;min-width:150px"><label style="margin-top:0">Catatan</label><input name="note" placeholder="opsional"></div>
      <button class="btn">Tutup Shift</button>
    </form>
    <p class="muted" style="font-size:12px;margin-top:6px">Perkiraan kas = modal awal + pembayaran tunai (<%= rupiah(tally.cash) %>). Selisih = terhitung − perkiraan.</p>
  </div>
<% } else { %>
  <div class="card">
    <h2 style="margin-top:0">Buka Shift</h2>
    <form method="post" action="/pms/cashier/open" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
      <div><label style="margin-top:0">Modal awal / float (Rp)</label><input name="openingFloat" type="number" min="0" value="0"></div>
      <button class="btn">Buka Shift</button>
    </form>
  </div>
<% } %>

<div class="card">
  <h3 style="margin-top:0">Riwayat Shift</h3>
  <table>
    <thead><tr><th>Buka</th><th>Tutup</th><th>Modal</th><th>Perkiraan Kas</th><th>Terhitung</th><th>Selisih</th><th>Status</th></tr></thead>
    <tbody>
      <% recent.forEach(function(s){ %>
        <tr>
          <td><%= dt(s.openedAt) %></td><td><%= dt(s.closedAt) %></td>
          <td><%= rupiah(s.openingFloat) %></td>
          <td><%= s.expectedCash!=null?rupiah(s.expectedCash):'—' %></td>
          <td><%= s.closingCounted!=null?rupiah(s.closingCounted):'—' %></td>
          <td style="color:<%= (s.variance||0)<0?'#c0392b':((s.variance||0)>0?'#a86616':'#2f9e6f') %>"><%= s.variance!=null?rupiah(s.variance):'—' %></td>
          <td><span class="pill <%= s.status==='OPEN'?'PAID':'' %>"><%= s.status %></span></td>
        </tr>
      <% }) %>
      <% if(!recent.length){ %><tr><td colspan="7" class="empty">Belum ada shift.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
