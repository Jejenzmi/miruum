<%- include('../partials/top', { title:'In-house Ledger', heading:'In-house Guest Ledger', section:'extranet', active:'inhouse', me }) %>

<div class="stat-row" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px">
  <div class="stat"><div class="label">Total Tagihan</div><div class="value" style="font-size:18px"><%= rupiah(totals.charges) %></div></div>
  <div class="stat"><div class="label">Sudah Dibayar</div><div class="value" style="font-size:18px;color:#2f9e6f"><%= rupiah(totals.paid) %></div></div>
  <div class="stat"><div class="label">Saldo Terutang</div><div class="value" style="font-size:18px;color:<%= totals.balance>0?'#c0392b':'#2f9e6f' %>"><%= rupiah(totals.balance) %></div></div>
</div>

<div class="card">
  <table>
    <thead><tr><th>Kode</th><th>Tamu</th><th>Kamar</th><th style="text-align:right">Tagihan</th><th style="text-align:right">Dibayar</th><th style="text-align:right">Saldo</th><th></th></tr></thead>
    <tbody>
      <% guests.forEach(function(g){ %>
        <tr>
          <td><span class="pill PAID"><%= g.code %></span></td>
          <td><b><%= g.guest %></b></td>
          <td><%= g.room %><%= g.roomNumber?(' · #'+g.roomNumber):'' %></td>
          <td style="text-align:right"><%= rupiah(g.charges) %></td>
          <td style="text-align:right;color:#2f9e6f"><%= rupiah(g.paid) %></td>
          <td style="text-align:right;font-weight:700;color:<%= g.balance>0?'#c0392b':'#2f9e6f' %>"><%= rupiah(g.balance) %></td>
          <td><a class="btn ghost sm" href="/pms/booking/<%= g.id %>">Folio</a></td>
        </tr>
      <% }) %>
      <% if(!guests.length){ %><tr><td colspan="7" class="empty">Tidak ada tamu in-house saat ini.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
