<%- include('../partials/top', { title:'Neraca Saldo', heading:'Neraca Saldo (Trial Balance)', section:'extranet', active:'gl_tb', me }) %>

<% if (posted) { %><div class="notice ok">Posting selesai â jurnal dibangun ulang dari data reservasi, folio &amp; pembayaran.</div><% } %>
<% if (err) { %><div class="notice bad"><%= err %></div><% } %>

<div class="card" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
  <form method="get" action="/pms/gl/trial-balance" style="display:flex;gap:8px;align-items:center;margin:0">
    <label style="margin:0">Per tanggal</label><input type="date" name="asOf" value="<%= q.asOf || '' %>" style="width:auto">
    <button class="btn sm">Tampilkan</button>
  </form>
  <div style="display:flex;gap:8px;align-items:center">
    <% var ex = (q.asOf ? '&asOf='+encodeURIComponent(q.asOf) : ''); %>
    <a class="btn ghost sm" href="/pms/gl/export/trial-balance?format=pdf<%= ex %>">â¬ PDF</a>
    <a class="btn ghost sm" href="/pms/gl/export/trial-balance?format=xlsx<%= ex %>">â¬ Excel</a>
    <a class="btn ghost sm" href="/pms/gl/workbook?<%= (typeof ex!=="undefined"? ex.replace(/^&/,"") : "") %>" title="Semua laporan dalam satu file Excel">⬇ Laporan Lengkap (Excel)</a>
    <form method="post" action="/pms/gl/rebuild" style="margin:0"><input type="hidden" name="back" value="/pms/gl/trial-balance"><button class="btn ghost sm">â» Posting</button></form>
  </div>
</div>

<div class="card">
  <table>
    <thead><tr><th>Kode</th><th>Nama Akun</th><th style="text-align:right">Debit</th><th style="text-align:right">Kredit</th></tr></thead>
    <tbody>
      <% (rows||[]).forEach(function(r){ %>
        <tr>
          <td><code><%= r.code %></code></td>
          <td><%= r.name %></td>
          <td style="text-align:right"><%= r.debit ? rupiah(r.debit) : 'â' %></td>
          <td style="text-align:right"><%= r.credit ? rupiah(r.credit) : 'â' %></td>
        </tr>
      <% }) %>
      <% if(!(rows||[]).length){ %><tr><td colspan="4" class="empty">Belum ada jurnal. Klik "Posting / Bangun Ulang Jurnal".</td></tr><% } %>
    </tbody>
    <% if((rows||[]).length){ %>
    <tfoot><tr style="font-weight:800;border-top:2px solid #20262e">
      <td colspan="2">Total</td>
      <td style="text-align:right"><%= rupiah(totalDebit) %></td>
      <td style="text-align:right"><%= rupiah(totalCredit) %></td>
    </tr></tfoot>
    <% } %>
  </table>
  <p style="margin-top:12px">
    <% if (balanced) { %><span class="sfbadge" style="background:#E4F5EC;color:#1E7A4D;padding:4px 10px;border-radius:6px;font-weight:700">â Seimbang (Debit = Kredit)</span>
    <% } else { %><span class="sfbadge" style="background:#FCE8EE;color:#B5335C;padding:4px 10px;border-radius:6px;font-weight:700">â  Tidak seimbang</span><% } %>
  </p>
</div>

<%- include('../partials/bottom') %>
